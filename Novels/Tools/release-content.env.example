# Copy this file to Tools/release-content.env and adjust local values.
# Tools/release-content.env is ignored by Git.

NOVELS_RELEASE_UNITY=/Applications/Unity/Hub/Editor/6000.3.11f1/Unity.app/Contents/MacOS/Unity
NOVELS_RELEASE_SERVER_URL=https://content.example.com/novels
NOVELS_RELEASE_UPLOAD_TARGET=user@example.com:/srv/www/novels

# Upload remains opt-in. Set to 1 only when running the script should publish content.
NOVELS_RELEASE_UPLOAD_ENABLED=0

# Player builds are also opt-in.
NOVELS_RELEASE_BUILD_ANDROID=0
NOVELS_RELEASE_BUILD_IOS=0
NOVELS_RELEASE_ANDROID_OUTPUT=Build/Players/Novels.apk
NOVELS_RELEASE_IOS_OUTPUT=Build/Players/iOS
