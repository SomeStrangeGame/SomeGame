#!/bin/zsh
set -euo pipefail

TOOL_DIR=${0:A:h}
REPOSITORY_ROOT=${TOOL_DIR:h:h}
GAME_PROJECT="$REPOSITORY_ROOT/Novels"
PROJECTS_ROOT="$REPOSITORY_ROOT/Projects"
UNITY_BIN=${NOVELS_UNITY_BIN:-/Applications/Unity/Hub/Editor/6000.3.11f1/Unity.app/Contents/MacOS/Unity}
BUILD_METHOD=Novels.ContentSdk.Editor.AtomicContentBuild.BuildLocal
VALIDATE_METHOD=Novels.ContentSdk.Editor.AtomicContentBuild.Validate

usage() {
  print 'Usage:'
  print '  novels-content doctor'
  print '  novels-content validate <catalog|story-id|all>'
  print '  novels-content build <catalog|story-id|all> <editor|android|ios>'
  print '  novels-content publish <destination-directory>'
}

project_path() {
  local project="$PROJECTS_ROOT/novels-$1"
  [[ -f "$project/ProjectSettings/ProjectVersion.txt" ]] || {
    print -u2 "Unknown content project: $1"
    return 2
  }
  print "$project"
}

story_ids() {
  local card
  for card in "$PROJECTS_ROOT"/novels-*/Config/card.json(N); do
    print "${${card:h:h:t}#novels-}"
  done
}

all_ids() {
  print catalog
  story_ids
}

config_path() {
  local project=$(project_path "$1")
  [[ "$1" == catalog ]] && print "$project/Config/catalog.json" || print "$project/Config/card.json"
}

doctor() {
  local failed=0 id
  [[ -x "$UNITY_BIN" ]] || { print -u2 "Unity executable is missing: $UNITY_BIN"; failed=1; }
  for id in ${(f)"$(all_ids)"}; do
    local config=$(config_path "$id")
    [[ -f "$config" ]] || { print -u2 "Content configuration is missing: $config"; failed=1; }
    grep -q '"minimumClientVersion"' "$config" || {
      print -u2 "minimumClientVersion is missing: $config"
      failed=1
    }
  done
  [[ $failed -eq 0 ]] || return 1
  print 'novels-content: configuration is valid.'
}

run_unity() {
  local id=$1 method=$2 platform=${3:-}
  local project=$(project_path "$id")
  local action=${method:t}
  local log="$project/Build/${action:l}-${platform:-content}.log"
  mkdir -p "$project/Build"
  print "${action} $id${platform:+ for $platform}..."
  local arguments=(-batchmode -quit -nographics -projectPath "$project" -executeMethod "$method" -logFile "$log")
  [[ -n "$platform" ]] && arguments+=(-contentPlatform "$platform")
  "$UNITY_BIN" $arguments
  print "Done. Log: $log"
}

for_each_project() {
  local selected=$1 method=$2 platform=${3:-} id
  if [[ "$selected" == all ]]; then
    for id in ${(f)"$(all_ids)"}; do run_unity "$id" "$method" "$platform"; done
  else
    run_unity "$selected" "$method" "$platform"
  fi
}

copy_tree() {
  local source=$1 destination=$2
  [[ -d "$source" ]] || { print -u2 "Built content is missing: $source"; return 1; }
  mkdir -p "$destination"
  rsync -a --delete "$source/" "$destination/"
}

compose() {
  local destination="$GAME_PROJECT/Build/LocalContent" id
  mkdir -p "$destination/catalog/registry"
  local catalog="$(project_path catalog)/Build/LocalContent"
  [[ -d "$catalog" ]] && copy_tree "$catalog" "$destination/catalog/ui"
  for id in ${(f)"$(story_ids)"}; do
    local project=$(project_path "$id")
    local build="$project/Build/LocalContent"
    [[ -d "$build" ]] || continue
    copy_tree "$build" "$destination/stories/$id"
    cp "$project/Config/card.json" "$destination/stories/$id/card.json"
    local covers=("$project"/Config/cover.*(N))
    [[ ${#covers} -eq 1 ]] || { print -u2 "Story '$id' must contain one cover."; return 1; }
    cp "$covers[1]" "$destination/stories/$id/${covers[1]:t}"
  done
  cp "$(project_path catalog)/Config/catalog.json" "$destination/catalog/registry/catalog.json"
  print "Composed: $destination"
}

validate() {
  local selected=${1:-}
  [[ -n "$selected" ]] || { usage; return 2; }
  doctor
  for_each_project "$selected" "$VALIDATE_METHOD"
}

build() {
  local selected=${1:-} platform=${2:-}
  [[ -n "$selected" && -n "$platform" ]] || { usage; return 2; }
  [[ "$platform" == editor || "$platform" == android || "$platform" == ios ]] || {
    print -u2 "Unknown platform: $platform"
    return 2
  }
  doctor
  for_each_project "$selected" "$BUILD_METHOD" "$platform"
  compose
}

publish() {
  local destination=${1:-}
  [[ -n "$destination" ]] || { usage; return 2; }
  copy_tree "$GAME_PROJECT/Build/LocalContent" "$destination"
  print "Published: $destination"
}

case ${1:-} in
  doctor) doctor ;;
  validate) validate "${2:-}" ;;
  build) build "${2:-}" "${3:-}" ;;
  publish) publish "${2:-}" ;;
  *) usage; exit 2 ;;
esac
