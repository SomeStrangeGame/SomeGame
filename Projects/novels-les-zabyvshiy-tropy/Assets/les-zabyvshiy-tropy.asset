  _mainCharacter: "Ника"
  _contentVersion: 1
  _endMarker: "...: КОНЕЦ СЕРИИ"
  _silentAudioIds: []
  _episodes:
  - _id: s01e01
    _title: "Нулевая просека"
    _description: "Ника входит в Ночелесье и выбирает память, которая станет якорем пути."
  - _id: s01e02
    _title: "Мост, которого не было"
    _description: "Группа решает, довериться ли невозможному проводнику или приборам."
  - _id: s01e03
    _title: "Дом без двери"
    _description: "Карты Яра раскрывают ошибку, заставившую лес стирать дороги."
  - _id: s01e04
    _title: "Круг голосов"
    _description: "Лес предлагает каждому удобное воспоминание без будущего."
  - _id: s01e05
    _title: "Поляна несказанных имён"
    _description: "Ника находит Яра и выбирает судьбу закреплённого маршрута."
  - _id: s01e06
    _title: "Первый след"
    _description: "Рассвет приводит героев к одной из трёх достижимых развязок."
