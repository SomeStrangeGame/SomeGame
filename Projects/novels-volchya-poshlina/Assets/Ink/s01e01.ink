    -> ending_nameless
- luka_saved && cub_mercy && truth >= 3 && medicine >= 1:
    -> ending_witnesses
- rejected_ledger && pack_trust >= 2 && truth >= 2:
    -> ending_pathless
- truth >= 2 && savva_debt == "returned" && medicine >= 1:
    -> ending_names
