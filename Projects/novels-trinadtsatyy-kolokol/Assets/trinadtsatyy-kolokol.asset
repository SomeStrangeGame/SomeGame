  _id: trinadtsatyy-kolokol
  _mainCharacter: "Лада"
  _contentVersion: 1
  _endMarker: "...: КОНЕЦ СЕРИИ"
  _silentAudioIds: []
  _episodes:
  - _id: s01e01
    _title: "Лента номер ноль"
    _description: "Лада слышит невозможный тринадцатый удар и получает первый адрес исчезновения."
  - _id: s01e02
    _title: "Кольцо последнего вагона"
    _description: "Трамвайное кольцо связывает звон с забытой городской сетью «Глас»."
  - _id: s01e03
    _title: "Город в прямом эфире"
    _description: "Ася предлагает предупредить всех, но публичность меняет ход расследования."
  - _id: s01e04
    _title: "Смена, которой не было"
    _description: "Зоя открывает Дом связи и путь к тринадцатому кабелю."
  - _id: s01e05
    _title: "Адрес под дождём"
    _description: "В коллекторе находится человеческий механизм исчезновений, а на крыше звучит имя Тима."
  - _id: s01e06
    _title: "Нулевая комната"
    _description: "Лада проверяет последнюю версию и решает, кому должна принадлежать опасная правда."
