  m_Script: {fileID: 11500000, guid: 9ef49ee7dc364b55bd46cdf47f47db65, type: 3}
  m_Name: zdm
  m_EditorClassIdentifier: 
  _id: zdm
  _mainCharacter: "\u041D\u0443\u0440"
  _contentVersion: 1
  _endMarker: "\u041A\u041E\u041D\u0415\u0426 \u0421\u0415\u0420\u0418\u0418"
  _silentAudioIds: ["\u0442\u0438\u0448\u0438\u043D\u0430"]
  _episodes:
  - _id: s01e01
    _title: "Кровь на священных песках"
    _description: "Обвинённая в убийстве жрица покидает родной дом и отправляется к Фараону искать справедливости. Но путь спасения оборачивается сплошной полосой из предательства и обмана."
  - _id: s01e02
    _title: "Друг или враг?"
    _description: "Все надежды и мечты разрушены. Получится ли приспособиться к новому витку жизни?"
  - _id: s01e03
    _title: "Вопросы"
    _description: "Вокруг одни вопросы и ни одного ответа."
  - _id: s01e04
    _title: "Обещание"
    _description: "Назад нельзя, только вперёд."
  - _id: s01e05
    _title: "Последствия решений"
    _description: "Гелиополь открывает свои двери."
  - _id: s01e06
    _title: "Тень за спиной"
    _description: "Маски сброшены."
  - _id: s01e07
    _title: "Новые знакомства"
    _description: "Один секрет раскрыт, но новые уже ждут за порогом."
  - _id: s01e08
    _title: "Первая часть правды"
    _description: "Вы скованы обещанием в золотой клетке. Что предпримете теперь?"
  - _id: s01e09
    _title: "Сделка"
    _description: "Когда боги молчат, остаётся надежда только на хаос."
  - _id: s01e10
    _title: "Лицом к лицу"
    _description: "Пора платить по счетам."
  - _id: s02e01
    _title: "Путь Ба"
    _description: "Добро пожаловать в Дуат."
