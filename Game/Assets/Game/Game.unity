      _battleScenePrefab: {fileID: 495528780594990917, guid: 4d68417a6adac48089e8c7b684c87c7d, type: 3}
      _battleSceneScreenPrefab: {fileID: 5389417796270955557, guid: c0b5d0845e4af409991a4831b288f5d2, type: 3}
    - _chapterName: Chapter 2
      _menuStart:
        _descriptionText: "<b>\u0413\u043B\u0430\u0432\u0430 II: \u041C\u0435\u0447
          \u0431\u0435\u0437 \u0437\u043D\u0430\u043C\u0435\u043D\u0438</b>\n6-\u0435
          \u0447\u0438\u0441\u043B\u043E, \u043C\u0435\u0441\u044F\u0446 \u0425\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
          \u0416\u0430\u043B\u0430, \u0433\u043E\u0434 \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u043E\u0433\u043E
          \u0417\u0430\u0442\u043C\u0435\u043D\u0438\u044F\n\n<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F:
          \u041F\u0435\u0440\u0435\u0432\u0430\u043B \u0421\u0435\u0440\u043E\u0439
          \u0422\u0435\u043D\u0438</b>\n\u0418\u0437 \u043E\u0442\u0447\u0451\u0442\u0430
          \u0433\u043E\u043D\u0446\u0430 \u041B\u0438\u0440\u0435\u043D\u0430, 9-\u0439
          \u0434\u043E\u0437\u043E\u0440\u043D\u044B\u0439 \u043E\u0442\u0440\u044F\u0434\n\u0423\u0437\u043A\u0438\u0439
          \u043F\u0440\u043E\u0445\u043E\u0434 \u043C\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043C\u044F
          \u0437\u0443\u0431\u0446\u0430\u043C\u0438 \u0427\u0451\u0440\u043D\u044B\u0445
          \u0421\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u0411\u0430\u0448\u0435\u043D,
          \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 \u043E\u043A\u043E\u043B\u043E
          1400 \u043B\u043E\u043A\u0442\u0435\u0439 \u043D\u0430\u0434 \u0443\u0440\u043E\u0432\u043D\u0435\u043C
          \u043C\u043E\u0440\u044F. \u0414\u043E\u0440\u043E\u0433\u0430 \u2014 \u043D\u0435
          \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u043C \u0442\u0440\u043E\u043F\u0430,
          \u0432\u044B\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F \u043E\u0431\u043B\u043E\u043C\u043A\u0430\u043C\u0438
          \u0441\u043B\u0430\u043D\u0446\u0430 \u0438 \u043E\u0431\u043B\u043E\u043C\u0438\u0432\u0448\u0438\u043C\u0438\u0441\u044F
          \u043F\u043B\u0438\u0442\u0430\u043C\u0438 \u0434\u0440\u0435\u0432\u043D\u0435\u0439
          \u0431\u0440\u0443\u0441\u0447\u0430\u0442\u043A\u0438. \u0421 \u0432\u043E\u0441\u0442\u043E\u043A\u0430
          \u0434\u0443\u0435\u0442 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439
          \u0432\u0435\u0442\u0435\u0440, \u043D\u0435\u0441\u0443\u0449\u0438\u0439
          \u043F\u0435\u043F\u0435\u043B \u0438\u0437 \u0432\u044B\u0436\u0436\u0435\u043D\u043D\u044B\u0445
          \u0437\u0435\u043C\u0435\u043B\u044C \u0438 \u0440\u0435\u0437\u043A\u0438\u0439
          \u0437\u0430\u043F\u0430\u0445 \u0441\u0435\u0440\u044B. \u041B\u0435\u0442\u043E\u043C
          \u0437\u0434\u0435\u0441\u044C \u0441\u0443\u0445\u043E \u0438 \u0436\u0430\u0440\u043A\u043E,
          \u0437\u0438\u043C\u043E\u0439 \u2014 \u043B\u0435\u0434\u044F\u043D\u043E\u0439
          \u0442\u0443\u043C\u0430\u043D \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u0435\u0442
          \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u0438.
          \u0423\u043A\u0440\u044B\u0442\u0438\u0439 \u043F\u043E\u0447\u0442\u0438
          \u043D\u0435\u0442: \u043B\u0438\u0448\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
          \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043D\u044B\u0445 \u0441\u0442\u043E\u0440\u043E\u0436\u0435\u0432\u044B\u0445
          \u0431\u0443\u0434\u043E\u043A \u0438 \u043E\u0441\u0442\u0430\u0442\u043A\u0438
          \u0440\u0436\u0430\u0432\u043E\u0439 \u0446\u0435\u043F\u0438, \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
          \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0432\u0448\u0435\u0439
          \u043F\u0440\u043E\u0445\u043E\u0434. \u041C\u0435\u0441\u0442\u043E \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
          \u0434\u043B\u044F \u0437\u0430\u0441\u0430\u0434\u044B. \u0418\u0437\u0431\u0435\u0433\u0430\u0442\u044C
          \u2014 \u043F\u0440\u0438\u043A\u0430\u0437 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u043D\u0438\u044F.\n\n\u042F
          \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0435\u0433\u043E.\n\n\u041D\u0435
          \u043F\u043E \u0441\u043B\u0435\u0434\u0430\u043C \u2014 \u0438\u0445 \u043E\u043D
          \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442. \u041D\u0435
          \u043F\u043E \u0448\u0443\u043C\u0443 \u2014 \u043E\u043D \u0441\u043B\u0438\u0448\u043A\u043E\u043C
          \u0442\u0438\u0445. \u041D\u043E \u043F\u043E \u0442\u0438\u0448\u0438\u043D\u0435.
          \u0422\u043E\u0439, \u0447\u0442\u043E \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0435\u0442,
          \u043A\u043E\u0433\u0434\u0430 \u0437\u0432\u0435\u0440\u044C \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442
          \u043F\u0435\u0440\u0435\u0434 \u043F\u0440\u044B\u0436\u043A\u043E\u043C.\n\n\u041E\u043D
          \u043D\u0435 \u0431\u0430\u043D\u0434\u0438\u0442. \u041D\u0435 \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0438\u043D
          \u0441 \u0442\u043E\u043F\u043E\u0440\u043E\u043C. \u042D\u0442\u043E \u0432\u043E\u0438\u043D
          \u2014 \u0438, \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E,
          \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440. \u0422\u0430\u043A\u0438\u0435
          \u043E\u043F\u0430\u0441\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E:
          \u0437\u043D\u0430\u044E\u0442 \u0442\u0430\u043A\u0442\u0438\u043A\u0443,
          \u043D\u043E \u0443\u0436\u0435 \u043D\u0435 \u0431\u043E\u044F\u0442\u0441\u044F
          \u0441\u043C\u0435\u0440\u0442\u0438. \u0418 \u043D\u0435 \u0432\u0435\u0440\u044F\u0442
          \u0432 \u0447\u0435\u0441\u0442\u044C.\n\n\u0412\u0435\u0442\u0435\u0440
          \u043F\u0440\u0438\u043D\u0451\u0441 \u0437\u0430\u043F\u0430\u0445 \u043C\u0430\u0441\u043B\u0430
          \u0434\u043B\u044F \u043A\u043B\u0438\u043D\u043A\u0430 \u2014 \u0442\u043E\u043D\u043A\u0438\u0439,
          \u0447\u0443\u0442\u044C \u0433\u043E\u0440\u044C\u043A\u0438\u0439. \u041D\u0435
          \u0434\u0435\u0448\u0451\u0432\u044B\u0439 \u0436\u0438\u0440 \u0438\u0437
          \u0442\u0430\u0432\u0435\u0440\u043D\u044B, \u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
          \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u043E\u0435 \u043C\u0430\u0441\u043B\u043E.
          \u0417\u043D\u0430\u0447\u0438\u0442, \u0443 \u043D\u0435\u0433\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
          \u043C\u0435\u0447. \u041E\u0444\u0438\u0446\u0435\u0440\u0441\u043A\u0438\u0439.
          \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0434\u0430\u0436\u0435
          \u0438\u0437 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0445
          \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438\u0445.\n\n\u041C\u043E\u0439
          \u2014 \u0438\u0437 \u043A\u0443\u0437\u043D\u0438 \u0443 \u0421\u0435\u0432\u0435\u0440\u043D\u044B\u0445
          \u0412\u043E\u0440\u043E\u0442. \u041F\u0440\u043E\u0447\u043D\u044B\u0439,
          \u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E\u0439. \u041F\u0440\u043E\u0442\u0438\u0432
          \u0442\u0430\u043A\u043E\u0433\u043E \u043A\u043B\u0438\u043D\u043A\u0430
          \u2014 \u043A\u0430\u043A \u043F\u0430\u043B\u043A\u0430 \u043F\u0440\u043E\u0442\u0438\u0432
          \u0442\u043E\u043F\u043E\u0440\u0430.\n\n\u041D\u043E \u044F \u043D\u0435
          \u043C\u043E\u0433\u0443 \u043E\u0431\u043E\u0439\u0442\u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043B.\n\u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
          \u0436\u0434\u0451\u0442.\n\u0418 \u044F \u0438\u0434\u0443."
        _buttonText: "<b>\u0412 \u0431\u043E\u0439...</b>"
        _backgroundSpriteName: Chapter_2
      _menuSuccess:
        _descriptionText: "<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F: \u0412\u0435\u0440\u0448\u0438\u043D\u0430
          \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430 \u2014 \xAB\u041A\u0430\u043C\u0435\u043D\u044C
          \u041F\u0440\u0438\u0441\u044F\u0433\u0438\xBB</b>\n\u0418\u0437 \u0430\u0440\u0445\u0438\u0432\u043E\u0432
          \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u043E\u0439 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u0439
          \u0441\u043B\u0443\u0436\u0431\u044B\n\u041F\u043B\u043E\u0441\u043A\u0430\u044F
          \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430 \u0434\u0438\u0430\u043C\u0435\u0442\u0440\u043E\u043C
          \u043E\u043A\u043E\u043B\u043E 20 \u0448\u0430\u0433\u043E\u0432, \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u0430\u044F
          \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
          \u0443\u0441\u0442\u0443\u043F\u043E\u043C \u0431\u0430\u0437\u0430\u043B\u044C\u0442\u0430.
          \u0412 \u0446\u0435\u043D\u0442\u0440\u0435 \u2014 \u043E\u0431\u043B\u043E\u043C\u043E\u043A
          \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E \u043C\u043E\u043D\u043E\u043B\u0438\u0442\u0430,
          \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u043A\u0430\u043A
          \xAB\u041A\u0430\u043C\u0435\u043D\u044C \u041F\u0440\u0438\u0441\u044F\u0433\u0438\xBB.
          \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u043F\u0440\u0435\u0434\u0430\u043D\u0438\u044E,
          \u0437\u0434\u0435\u0441\u044C \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
          \u043A\u043B\u044F\u043B\u0438\u0441\u044C \u0432\u0435\u0440\u043D\u043E\u0441\u0442\u044C\u044E
          \u043F\u0435\u0440\u0432\u044B\u0435 \u0441\u0442\u0440\u0430\u0436\u0438
          \u0433\u0440\u0430\u043D\u0438\u0446\u044B. \u041D\u0430\u0434\u043F\u0438\u0441\u0438
          \u043D\u0430 \u043A\u0430\u043C\u043D\u0435 \u0434\u0430\u0432\u043D\u043E
          \u0441\u0442\u0451\u0440\u043B\u0438\u0441\u044C, \u043D\u043E \u0441\u0430\u043C
          \u043E\u043D \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0441\u044F
          \u2014 \u0447\u0451\u0440\u043D\u044B\u0439, \u0433\u043B\u0430\u0434\u043A\u0438\u0439,
          \u0441 \u0442\u0440\u0435\u0449\u0438\u043D\u043E\u0439 \u043F\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435.
          \u0421 \u0441\u0435\u0432\u0435\u0440\u0430 \u0438 \u044E\u0433\u0430 \u2014
          \u043E\u0431\u0440\u044B\u0432\u044B; \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
          \u043F\u0443\u0442\u044C \u2014 \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u043E\u043F\u0443.
          \u041C\u0435\u0441\u0442\u043E \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E
          \u043E\u043F\u0430\u0441\u043D\u043E: \u043B\u044E\u0431\u043E\u0439, \u043A\u0442\u043E
          \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443,
          \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043C\u0438\u0448\u0435\u043D\u044C\u044E.\n\n\u041E\u043D
          \u043C\u0451\u0440\u0442\u0432.\n\n\u041B\u0435\u0436\u0438\u0442 \u0443
          \u041A\u0430\u043C\u043D\u044F \u041F\u0440\u0438\u0441\u044F\u0433\u0438,
          \u043B\u0438\u0446\u043E\u043C \u0432\u043D\u0438\u0437, \u0440\u0443\u043A\u0430
          \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u0436\u0438\u043C\u0430\u0435\u0442
          \u0440\u0443\u043A\u043E\u044F\u0442\u044C \u043C\u0435\u0447\u0430 \u2014
          \u0434\u043B\u0438\u043D\u043D\u043E\u0433\u043E, \u0441 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0439
          \u0433\u0430\u0440\u0434\u043E\u0439 \u0438 \u044D\u0444\u0435\u0441\u043E\u043C
          \u0432 \u0444\u043E\u0440\u043C\u0435 \u043E\u0440\u043B\u0438\u043D\u043E\u0433\u043E
          \u043A\u0440\u044B\u043B\u0430. \u0422\u0430\u043A\u0438\u0435 \u0432\u044B\u0434\u0430\u044E\u0442
          \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0444\u0438\u0446\u0435\u0440\u0430\u043C
          \u043B\u0438\u0447\u043D\u043E\u0439 \u0433\u0432\u0430\u0440\u0434\u0438\u0438.
          \u041D\u0430 \u043B\u0435\u0437\u0432\u0438\u0438 \u2014 \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0430:
          \xAB\u0412\u0435\u0440\u043D\u043E\u0441\u0442\u044C \u2014 \u043D\u0435
          \u043A\u043B\u044F\u0442\u0432\u0430, \u0430 \u0434\u043E\u043B\u0433\xBB.\n\n\u0418\u0440\u043E\u043D\u0438\u044F.\n\n\u041D\u0430
          \u0435\u0433\u043E \u043A\u0443\u0440\u0442\u043A\u0435 \u2014 \u0441\u043B\u0435\u0434\u044B
          \u043E\u0442 \u0432\u044B\u0440\u0432\u0430\u043D\u043D\u044B\u0445 \u0437\u043D\u0430\u043A\u043E\u0432.
          \u041E\u043D \u0441\u043D\u044F\u043B \u0432\u0441\u0451, \u0447\u0442\u043E
          \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u043B\u043E \u0435\u0433\u043E
          \u0441 \u0430\u0440\u043C\u0438\u0435\u0439. \u041D\u043E \u043C\u0435\u0447
          \u043E\u0441\u0442\u0430\u0432\u0438\u043B. \u041F\u043E\u0442\u043E\u043C\u0443
          \u0447\u0442\u043E \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u043E\u043D
          \u0441\u0442\u0430\u043B \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
          \u043F\u0440\u0430\u0432\u0434\u043E\u0439.\n\n\u0412 \u0435\u0433\u043E
          \u0432\u0435\u0449\u0430\u0445 \u2014 \u043A\u0438\u0441\u0435\u0442 \u0441
          \u0442\u0430\u0431\u0430\u043A\u043E\u043C, \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u0430\u044F
          \u043A\u043D\u0438\u0433\u0430 \u043C\u043E\u043B\u0438\u0442\u0432 \u0438
          \u043C\u0435\u0434\u0430\u043B\u044C\u043E\u043D \u0441 \u043E\u0431\u0443\u0433\u043B\u0435\u043D\u043D\u043E\u0439
          \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0435\u0439 \u0436\u0435\u043D\u0449\u0438\u043D\u044B
          \u0438 \u0440\u0435\u0431\u0451\u043D\u043A\u0430. \u041D\u0438\u043A\u0430\u043A\u0438\u0445
          \u043F\u0440\u0438\u043A\u0430\u0437\u043E\u0432. \u041D\u0438\u043A\u0430\u043A\u0438\u0445
          \u0441\u043F\u0438\u0441\u043A\u043E\u0432. \u0422\u043E\u043B\u044C\u043A\u043E
          \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u043E.\n\n\u042F
          \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u043B \u043C\u0435\u0434\u0430\u043B\u044C\u043E\u043D.\n\u041D\u043E
          \u043C\u0435\u0447 \u0432\u0437\u044F\u043B.\n\n\u041C\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439
          \u043A\u043B\u0438\u043D\u043E\u043A \u2014 \u0441\u043B\u043E\u043C\u0430\u043D
          \u0443 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F. \u0411\u043E\u043B\u044C\u0448\u0435
          \u043D\u0435 \u043E\u0440\u0443\u0436\u0438\u0435. \u041F\u0440\u043E\u0441\u0442\u043E
          \u043F\u0430\u043C\u044F\u0442\u044C.\n\n\u0422\u0435\u043F\u0435\u0440\u044C
          \u044F \u0438\u0434\u0443 \u0441 \u043C\u0435\u0447\u043E\u043C \u0432\u0440\u0430\u0433\u0430.\n\u041E\u043D
          \u0442\u044F\u0436\u0435\u043B\u0435\u0435. \u041E\u0441\u0442\u0440\u0435\u0435.
          \u0418 \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u0435\u0442 \u043E\u0448\u0438\u0431\u043E\u043A.\n\n\u041D\u043E
          \u044F \u2014 \u043D\u0435 \u0442\u043E\u0442, \u043A\u0442\u043E \u043E\u0448\u0438\u0431\u0430\u0435\u0442\u0441\u044F
          \u0434\u0432\u0430\u0436\u0434\u044B."
        _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
        _backgroundSpriteName: Chapter_2
      _menuFailed:
        _descriptionText: "<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F: \u041E\u0431\u0440\u044B\u0432
          \u0437\u0430 \u041A\u0430\u043C\u043D\u0435\u043C \u041F\u0440\u0438\u0441\u044F\u0433\u0438</b>\n\u0418\u0437
          \u0437\u0430\u043F\u0438\u0441\u0435\u0439 \u0433\u043E\u0440\u043D\u044B\u0445
          \u043F\u0430\u0441\u0442\u0443\u0445\u043E\u0432\n\u041C\u0435\u0441\u0442\u043E,
          \u043A\u0443\u0434\u0430 \u043D\u0435 \u0441\u0442\u0443\u043F\u0430\u0435\u0442
          \u043D\u043E\u0433\u0430 \u0436\u0438\u0432\u043E\u0433\u043E \u2014 \u0443\u0437\u043A\u0438\u0439
          \u043A\u0430\u0440\u043D\u0438\u0437 \u043D\u0430\u0434 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C\u044E
          \u0433\u043B\u0443\u0431\u0438\u043D\u043E\u0439 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435
          \u0441\u0442\u0430 \u043B\u043E\u043A\u0442\u0435\u0439. \u0421\u043A\u0430\u043B\u044B
          \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u043A\u0440\u044B\u0442\u044B
          \u0447\u0451\u0440\u043D\u044B\u043C \u043C\u0445\u043E\u043C, \u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0449\u0438\u043C
          \u0442\u0440\u0435\u0449\u0438\u043D\u044B. \u0412 \u0434\u043E\u0436\u0434\u044C
          \u043A\u0430\u0440\u043D\u0438\u0437 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
          \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u043B\u043E\u0432\u0443\u0448\u043A\u043E\u0439.
          \u041F\u043E \u043F\u0440\u0435\u0434\u0430\u043D\u0438\u044E, \u0441\u043E\u043B\u0434\u0430\u0442\u044B,
          \u043D\u0430\u0440\u0443\u0448\u0438\u0432\u0448\u0438\u0435 \u043F\u0440\u0438\u0441\u044F\u0433\u0443,
          \u0431\u0440\u043E\u0441\u0430\u043B\u0438\u0441\u044C \u0441 \u044D\u0442\u043E\u0433\u043E
          \u043E\u0431\u0440\u044B\u0432\u0430, \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C
          \u043F\u043E\u0437\u043E\u0440\u0430.\n\n\u041C\u043E\u0439 \u043C\u0435\u0447
          \u2014 \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u0438.\n\n\u0410
          \u044F \u2014 \u043D\u0430 \u043A\u0440\u0430\u044E \u043E\u0431\u0440\u044B\u0432\u0430,
          \u043B\u0438\u0446\u043E\u043C \u0432\u043D\u0438\u0437, \u0441 \u0440\u0430\u043D\u043E\u0439
          \u0432 \u0431\u043E\u043A\u0443 \u0438 \u043F\u0435\u043F\u043B\u043E\u043C
          \u0432\u043E \u0440\u0442\u0443.\n\n\u041E\u043D \u0441\u0442\u043E\u044F\u043B
          \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439, \u0434\u0435\u0440\u0436\u0430
          \u0441\u0432\u043E\u0439 \u043E\u0444\u0438\u0446\u0435\u0440\u0441\u043A\u0438\u0439
          \u043A\u043B\u0438\u043D\u043E\u043A \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
          \u2014 \u043D\u0435 \u043A\u0430\u043A \u0442\u0440\u043E\u0444\u0435\u0439,
          \u0430 \u043A\u0430\u043A \u0431\u0440\u0435\u043C\u044F.\n\u2014 \u042F
          \u043D\u0435 \u0445\u043E\u0442\u0435\u043B \u0443\u0431\u0438\u0432\u0430\u0442\u044C
          \u0441\u043E\u043B\u0434\u0430\u0442\u0430, \u2014 \u0441\u043A\u0430\u0437\u0430\u043B
          \u043E\u043D. \u2014 \u041D\u043E \u0442\u044B \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
          \u043C\u043D\u0435 \u0432\u044B\u0431\u043E\u0440\u0430.\n\n\u041E\u043D
          \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u043B \u0441\u0432\u0438\u0442\u043E\u043A.
          \u041D\u0435 \u0432\u0437\u044F\u043B \u043C\u043E\u0438 \u0432\u0435\u0449\u0438.
          \u041F\u0440\u043E\u0441\u0442\u043E \u0443\u0448\u0451\u043B, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
          \u043C\u0435\u043D\u044F \u0443\u043C\u0438\u0440\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0438
          \u0432\u0435\u0442\u0440\u0430 \u0438 \u043F\u0435\u043F\u043B\u0430.\n\n\u041A\u0442\u043E-\u0442\u043E
          \u043F\u043E\u0437\u0436\u0435 \u043D\u0430\u0439\u0434\u0451\u0442 \u043C\u043E\u0451
          \u0442\u0435\u043B\u043E.\n\u041D\u043E \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0442
          \u043F\u0440\u0430\u0432\u0434\u044B.\n\n\u041F\u043E\u0442\u043E\u043C\u0443
          \u0447\u0442\u043E \u0432 \u044D\u0442\u043E\u0439 \u0432\u043E\u0439\u043D\u0435
          \u043D\u0435\u0442 \u043D\u0438 \u0433\u0435\u0440\u043E\u0435\u0432, \u043D\u0438
          \u0442\u0440\u0443\u0441\u043E\u0432.\n\u0415\u0441\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
          \u0442\u0435, \u043A\u0442\u043E \u0434\u043E\u0448\u0451\u043B \u2014
          \u0438 \u0442\u0435, \u043A\u0442\u043E \u043D\u0435\u0442.\n\n\u041D\u043E
          \u044D\u0442\u043E \u2014 \u043D\u0435 \u043C\u043E\u0439 \u043F\u0443\u0442\u044C.\n\u042F
          \u043D\u0435 \u043F\u0430\u043B \u0443 \u043E\u0431\u0440\u044B\u0432\u0430.\n\u042F
          \u043F\u043E\u0431\u0435\u0434\u0438\u043B \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0430
          \u2014 \u043D\u0435 \u0441\u0438\u043B\u043E\u0439, \u0430 \u0442\u0435\u043C,
          \u0447\u0442\u043E \u0432\u0441\u0451 \u0435\u0449\u0451 \u0432\u0435\u0440\u044E
          \u0432 \u0446\u0435\u043B\u044C, \u0440\u0430\u0434\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
          \u0438\u0434\u0443.\n\u0418 \u044F \u0432\u0441\u0451 \u0435\u0449\u0451
          \u0438\u0434\u0443."
        _buttonText: "<b>\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430...</b>"
        _backgroundSpriteName: Chapter_2
      _menuBundleName: chapter_onlyscreen
      _menuPrefabName: Menu.prefab
      _cameraSO: {fileID: 11400000, guid: e20ca945d8c1140aa97944d71614f63e, type: 2}
      _battleScenePrefab: {fileID: 495528780594990917, guid: 4d68417a6adac48089e8c7b684c87c7d, type: 3}
      _battleSceneScreenPrefab: {fileID: 5389417796270955557, guid: c0b5d0845e4af409991a4831b288f5d2, type: 3}
    - _chapterName: Chapter 3
      _menuStart:
        _descriptionText: "<b>\u0413\u043B\u0430\u0432\u0430 III: \u0427\u0438\u0441\u043B\u043E
          \u2014 \u043D\u0435 \u0441\u0438\u043B\u0430</b>\n9-\u0435 \u0447\u0438\u0441\u043B\u043E,
          \u043C\u0435\u0441\u044F\u0446 \u0425\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
          \u0416\u0430\u043B\u0430, \u0433\u043E\u0434 \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u043E\u0433\u043E
          \u0417\u0430\u0442\u043C\u0435\u043D\u0438\u044F\n\n<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F:
          \u041E\u0432\u0440\u0430\u0433 \u0421\u0443\u0445\u0438\u0445 \u041A\u043E\u0440\u043D\u0435\u0439</b>\n\u0418\u0437
          \u043F\u043E\u043B\u0435\u0432\u043E\u0433\u043E \u0436\u0443\u0440\u043D\u0430\u043B\u0430
          \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u0430 \u0412\u0430\u0440\u0435\u043D\u0430,
          12-\u0439 \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0439
          \u0434\u043E\u0437\u043E\u0440\n\u0413\u043B\u0443\u0431\u043E\u043A\u0438\u0439
          \u043E\u0432\u0440\u0430\u0433, \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0432\u0448\u0438\u0439\u0441\u044F
          \u043F\u043E\u0441\u043B\u0435 \u043E\u0431\u0432\u0430\u043B\u0430 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0433\u043E
          \u0441\u043A\u043B\u043E\u043D\u0430 \u0445\u043E\u043B\u043C\u043E\u0432
          \u0427\u0451\u0440\u043D\u043E\u0433\u043E \u0412\u0435\u0440\u0435\u0441\u043A\u0430.
          \u0414\u043D\u043E \u0443\u0441\u0435\u044F\u043D\u043E \u043E\u0431\u043B\u043E\u043C\u043A\u0430\u043C\u0438
          \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043B\u0438\u0442
          \u0438 \u0432\u044B\u0441\u043E\u0445\u0448\u0438\u043C\u0438 \u043A\u043E\u0440\u043D\u044F\u043C\u0438
          \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u0438\u0445 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432,
          \u0432\u044B\u0440\u0432\u0430\u043D\u043D\u044B\u0445 \u0441 \u0437\u0435\u043C\u043B\u0451\u0439
          \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0437\u0435\u043C\u043B\u0435\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u044F
          \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434.
          \u0412\u043E\u0434\u044B \u043D\u0435\u0442 \u2014 \u0442\u043E\u043B\u044C\u043A\u043E
          \u0440\u0435\u0434\u043A\u0438\u0435 \u043B\u0443\u0436\u0438 \u0434\u043E\u0436\u0434\u0435\u0432\u043E\u0439
          \u0442\u0438\u043D\u044B. \u0421\u0442\u0435\u043D\u044B \u043E\u0432\u0440\u0430\u0433\u0430
          \u043E\u0442\u0432\u0435\u0441\u043D\u044B\u0435, \u043F\u043E\u043A\u0440\u044B\u0442\u044B
          \u0436\u0451\u043B\u0442\u044B\u043C \u043C\u0445\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
          \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u0438\u043C
          \u0434\u0430\u0436\u0435 \u043E\u0442 \u043B\u0451\u0433\u043A\u043E\u0439
          \u0440\u043E\u0441\u044B. \u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
          \u043F\u0443\u0442\u044C \u0432\u043D\u0438\u0437 \u2014 \u0443\u0437\u043A\u0430\u044F
          \u0442\u0440\u043E\u043F\u0430 \u043F\u043E \u043E\u0441\u044B\u043F\u0438.
          \u041D\u0430 \u0434\u043D\u0435 \u2014 \u0442\u0438\u0448\u0438\u043D\u0430.
          \u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
          \u0434\u043B\u044F \u0437\u0430\u0441\u0430\u0434\u044B: \u0436\u0435\u0440\u0442\u0432\u0430
          \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C,
          \u0430 \u043D\u0430\u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0442
          \u043E\u0431\u0430 \u0432\u044B\u0445\u043E\u0434\u0430.\n\n\u042F \u0441\u0442\u043E\u044E
          \u043D\u0430 \u043A\u0440\u0430\u044E \u043E\u0432\u0440\u0430\u0433\u0430,
          \u0433\u043B\u044F\u0434\u044F \u0432\u043D\u0438\u0437. \u0412\u0435\u0442\u0435\u0440
          \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u0434\u043E\u0445\u043E\u0434\u0438\u0442
          \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0433\u043D\u0435\u0442\u0443\u0449\u0430\u044F
          \u0442\u0438\u0448\u0438\u043D\u0430 \u0438 \u0437\u0430\u043F\u0430\u0445
          \u0433\u043D\u0438\u044E\u0449\u0438\u0445 \u043A\u043E\u0440\u043D\u0435\u0439.\n\n\u041D\u043E
          \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0438\u0445.\n\n\u0414\u0432\u043E\u0435.
          \u041C\u043E\u0436\u0435\u0442, \u0442\u0440\u043E\u0435. \u041D\u0435
          \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044B
          \u2014 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E
          \u0448\u0443\u043C\u0430. \u0421\u043C\u0435\u044F\u043B\u0438\u0441\u044C
          \u043C\u0438\u043D\u0443\u0442\u0443 \u043D\u0430\u0437\u0430\u0434, \u0433\u0434\u0435-\u0442\u043E
          \u0432\u043D\u0438\u0437\u0443. \u0413\u0440\u0443\u0431\u044B\u0435 \u0433\u043E\u043B\u043E\u0441\u0430,
          \u043F\u044C\u044F\u043D\u044B\u0435 \u0448\u0443\u0442\u043A\u0438, \u0437\u0432\u043E\u043D
          \u043C\u0435\u0442\u0430\u043B\u043B\u0430 \u043F\u043E \u043A\u0430\u043C\u043D\u044E.
          \u041E\u043D\u0438 \u0436\u0434\u0443\u0442 \u043C\u0435\u043D\u044F. \u0423\u0432\u0435\u0440\u0435\u043D\u044B,
          \u0447\u0442\u043E \u0434\u0432\u0430 \u043A\u043B\u0438\u043D\u043A\u0430
          \u043F\u0440\u043E\u0442\u0438\u0432 \u043E\u0434\u043D\u043E\u0433\u043E
          \u2014 \u044D\u0442\u043E \u043F\u043E\u0431\u0435\u0434\u0430.\n\n\u0413\u043B\u0443\u043F\u0446\u044B.\n\n\u0412
          \u0431\u043E\u044E \u0447\u0438\u0441\u043B\u043E \u0440\u0435\u0448\u0430\u0435\u0442
          \u043C\u0430\u043B\u043E, \u0435\u0441\u043B\u0438 \u043E\u0434\u0438\u043D
          \u0443\u043C\u0435\u0435\u0442 \u0434\u0435\u0440\u0436\u0430\u0442\u044C
          \u043C\u0435\u0447, \u0430 \u0434\u0440\u0443\u0433\u0438\u0435 \u2014
          \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437\u043C\u0430\u0445\u0438\u0432\u0430\u0442\u044C
          \u0438\u043C.\n\n\u041D\u043E \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E\u2026\n\u041C\u043E\u0439
          \u043D\u043E\u0432\u044B\u0439 \u043A\u043B\u0438\u043D\u043E\u043A \u2014
          \u043E\u0441\u0442\u0440\u044B\u0439, \u043D\u043E \u0447\u0443\u0436\u043E\u0439.
          \u0420\u0443\u043A\u0430 \u0435\u0449\u0451 \u043D\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0430
          \u043A \u0435\u0433\u043E \u0432\u0435\u0441\u0443.\n\n\u042F \u0433\u043B\u0443\u0431\u043E\u043A\u043E
          \u0432\u0434\u044B\u0445\u0430\u044E \u043F\u0435\u043F\u0435\u043B\u044C\u043D\u044B\u0439
          \u0432\u043E\u0437\u0434\u0443\u0445.\n\u0418 \u043D\u0430\u0447\u0438\u043D\u0430\u044E
          \u0441\u043F\u0443\u0441\u043A\u0430\u0442\u044C\u0441\u044F."
        _buttonText: "<b>\u0412 \u0431\u043E\u0439...</b>"
        _backgroundSpriteName: Chapter_3
      _menuSuccess:
        _descriptionText: "<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F: \u0414\u043D\u043E
          \u043E\u0432\u0440\u0430\u0433\u0430 \u2014 \xAB\u041F\u043B\u043E\u0449\u0430\u0434\u043A\u0430
          \u041A\u043E\u0440\u043D\u0435\u0439\xBB</b>\n\u0418\u0437 \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u043E\u0439
          \u0437\u0430\u043C\u0435\u0442\u043A\u0438 \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430
          \u042D\u043B\u0434\u0435\u043D\u0430\n\u041E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E
          \u0440\u043E\u0432\u043D\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
          \u0432 \u0441\u0430\u043C\u043E\u043C \u043D\u0438\u0437\u0443 \u043E\u0432\u0440\u0430\u0433\u0430,
          \u043E\u043A\u0440\u0443\u0436\u0451\u043D\u043D\u043E\u0435 \u0433\u0440\u0443\u0434\u0430\u043C\u0438
          \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432 \u0438 \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0435\u043D\u0438\u0435\u043C
          \u043C\u0451\u0440\u0442\u0432\u044B\u0445 \u043A\u043E\u0440\u043D\u0435\u0439,
          \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0438\u0445
          \u043A\u043E\u0441\u0442\u0438. \u041C\u0435\u0441\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E
          \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043E\u0442 \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u0438\u043A\u043E\u0432
          \u0438\u0437-\u0437\u0430 \u0444\u043E\u0440\u043C\u044B \u2014 \u043A\u0440\u0443\u0433\u043B\u0430\u044F,
          \u043A\u0430\u043A \u0430\u0440\u0435\u043D\u0430. \u0414\u0438\u0430\u043C\u0435\u0442\u0440
          \u2014 \u043E\u043A\u043E\u043B\u043E 15 \u0448\u0430\u0433\u043E\u0432.
          \u0421 \u044E\u0433\u0430 \u2014 \u0437\u0430\u0432\u0430\u043B, \u0441
          \u0441\u0435\u0432\u0435\u0440\u0430 \u2014 \u0442\u0440\u043E\u043F\u0430
          \u043D\u0430\u0432\u0435\u0440\u0445. \u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
          \u0443\u043A\u0440\u044B\u0442\u0438\u0435 \u2014 \u043A\u043E\u0440\u0435\u043D\u044C
          \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u043E\u0433\u043E \u0434\u0443\u0431\u0430,
          \u0432\u044B\u0441\u043E\u0445\u0448\u0438\u0439 \u0438 \u0447\u0451\u0440\u043D\u044B\u0439,
          \u043F\u043E\u0445\u043E\u0436\u0438\u0439 \u043D\u0430 \u043A\u043E\u0433\u043E\u0442\u044C.
          \u0417\u0434\u0435\u0441\u044C \u0447\u0430\u0441\u0442\u043E \u043D\u0430\u0445\u043E\u0434\u044F\u0442
          \u0442\u0435\u043B\u0430: \u043B\u0438\u0431\u043E \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432,
          \u043B\u0438\u0431\u043E \u0438\u0445 \u0436\u0435\u0440\u0442\u0432.\n\n\u041E\u0431\u0430
          \u043C\u0435\u0440\u0442\u0432\u044B.\n\n\u041E\u0434\u0438\u043D \u043B\u0435\u0436\u0438\u0442
          \u0443 \u043A\u043E\u0440\u043D\u044F, \u0441\u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C
          \u043A\u0430\u043B\u0430\u0447\u0438\u043A\u043E\u043C, \u0431\u0443\u0434\u0442\u043E
          \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u0443\u0441\u043D\u0443\u0442\u044C.
          \u0412\u0442\u043E\u0440\u043E\u0439 \u2014 \u0443 \u044E\u0436\u043D\u043E\u0433\u043E
          \u0437\u0430\u0432\u0430\u043B\u0430, \u043B\u0438\u0446\u043E\u043C \u0432\u043D\u0438\u0437,
          \u0440\u0443\u043A\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u0436\u0438\u043C\u0430\u0435\u0442
          \u0440\u0436\u0430\u0432\u044B\u0439 \u0442\u0435\u0441\u0430\u043A.\n\n\u0418\u0445
          \u043E\u0440\u0443\u0436\u0438\u0435 \u2014 \u0433\u0440\u0443\u0431\u043E\u0435.
          \u041E\u0434\u0438\u043D \u043C\u0435\u0447 \u2014 \u043A\u0443\u0437\u043D\u0435\u0447\u043D\u0430\u044F
          \u043F\u043E\u0434\u0435\u043B\u043A\u0430, \u0432\u0442\u043E\u0440\u043E\u0439
          \u2014 \u0432\u043E\u043E\u0431\u0449\u0435 \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u043D\u043D\u044B\u0439
          \u043A\u0443\u0445\u043E\u043D\u043D\u044B\u0439 \u043D\u043E\u0436 \u0441
          \u043F\u0440\u0438\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0439 \u0433\u0430\u0440\u0434\u043E\u0439.
          \u041E\u0434\u0435\u0436\u0434\u0430 \u2014 \u043B\u043E\u0445\u043C\u043E\u0442\u044C\u044F,
          \u043D\u0430\u0448\u0438\u0442\u044B\u0435 \u0438\u0437 \u0447\u0443\u0436\u0438\u0445
          \u043F\u043B\u0430\u0449\u0435\u0439. \u041D\u0430 \u043F\u043E\u044F\u0441\u0435
          \u043E\u0434\u043D\u043E\u0433\u043E \u2014 \u043E\u0431\u0440\u044B\u0432\u043E\u043A
          \u0432\u0435\u0440\u0451\u0432\u043A\u0438, \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u043C
          \u2014 \u043C\u0435\u0448\u043E\u043A \u0441 \u043A\u043E\u0441\u0442\u044F\u043C\u0438
          \u0438 \u043E\u0431\u043B\u043E\u043C\u043A\u0430\u043C\u0438 \u0441\u0442\u0435\u043A\u043B\u0430.
          \u0422\u0440\u043E\u0444\u0435\u0438 \u043D\u0438\u0449\u0438\u0445.\n\n\u041E\u043D\u0438
          \u043D\u0435 \u0431\u044B\u043B\u0438 \u0441\u043E\u043B\u0434\u0430\u0442\u0430\u043C\u0438.
          \u041D\u0435 \u0431\u044B\u043B\u0438 \u0434\u0430\u0436\u0435 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C\u0438
          \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0430\u043C\u0438.
          \u041F\u0440\u043E\u0441\u0442\u043E \u0432\u044B\u0436\u0438\u0432\u0430\u043B\u044C\u0449\u0438\u043A\u0438,
          \u0440\u0435\u0448\u0438\u0432\u0448\u0438\u0435, \u0447\u0442\u043E \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u0439
          \u043F\u0443\u0442\u043D\u0438\u043A \u2014 \u043B\u0451\u0433\u043A\u0430\u044F
          \u0434\u043E\u0431\u044B\u0447\u0430.\n\n\u041E\u043D\u0438 \u043E\u0448\u0438\u0431\u0430\u043B\u0438\u0441\u044C.\n\n\u042F
          \u043E\u0431\u044B\u0441\u043A\u0430\u043B \u0438\u0445 \u2014 \u043D\u0438\u0447\u0435\u0433\u043E
          \u0446\u0435\u043D\u043D\u043E\u0433\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
          \u043A\u0443\u0441\u043E\u043A \u0447\u0451\u0440\u0441\u0442\u0432\u043E\u0433\u043E
          \u0445\u043B\u0435\u0431\u0430 \u0438 \u0444\u043B\u044F\u0433\u0430 \u0441
          \u043A\u0438\u0441\u043B\u044B\u043C \u044D\u043B\u0435\u043C. \u041D\u043E
          \u043D\u0430 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439
          \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043A\u0443\u0440\u0442\u043A\u0438
          \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u043D\u0438\u0445 \u2014
          \u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0439 \u043D\u0430\u0431\u0440\u043E\u0441\u043E\u043A:
          \u0442\u0440\u043E\u043F\u0430, \u043A\u0430\u043C\u0435\u043D\u044C \u0441
          \u0442\u0440\u0435\u0449\u0438\u043D\u043E\u0439, \u0438 \u043D\u0430\u0434\u043F\u0438\u0441\u044C
          \u2014 \xAB\u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D:
          2 \u0434\u043D\u044F\xBB.\n\n\u041E\u043D\u0438 \u0437\u043D\u0430\u043B\u0438,
          \u043A\u0443\u0434\u0430 \u044F \u0438\u0434\u0443.\n\u041D\u043E \u043D\u0435
          \u0437\u043D\u0430\u043B\u0438, \u043A\u0442\u043E \u044F.\n\n\u041C\u043E\u0439
          \u043C\u0435\u0447 \u2014 \u0432 \u043D\u043E\u0436\u043D\u0430\u0445.
          \u0427\u0438\u0441\u0442.\n\u0420\u0443\u043A\u0430 \u2014 \u0434\u0440\u043E\u0436\u0438\u0442,
          \u043D\u043E \u043D\u0435 \u043E\u0442 \u0441\u0442\u0440\u0430\u0445\u0430.
          \u041E\u0442 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438.\n\n\u041F\u043E\u0440\u0430
          \u0438\u0434\u0442\u0438.\n\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
          \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u2014 \u0443\u0436\u0435 \u043D\u0435
          \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438.\n\u0410 \u0442\u0435,
          \u043A\u0442\u043E \u0438\u0445 \u043D\u0430\u043D\u044F\u043B."
        _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
        _backgroundSpriteName: Chapter_3
      _menuFailed:
        _descriptionText: "<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F: \u0417\u0430\u0432\u0430\u043B
          \u0443 \u044E\u0436\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u044B \u043E\u0432\u0440\u0430\u0433\u0430</b>\n\u0418\u0437
          \u0437\u0430\u043F\u0438\u0441\u0435\u0439 \u043F\u0430\u0441\u0442\u0443\u0445\u0430
          \u0420\u0435\u043D\u0442\u0430\n\u0413\u0440\u0443\u0434\u0430 \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432,
          \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0432\u0448\u0430\u044F\u0441\u044F
          \u043F\u043E\u0441\u043B\u0435 \u043E\u0431\u0432\u0430\u043B\u0430 20-\u0433\u043E
          \u0433\u043E\u0434\u0430 \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u043E\u0439
          \u042D\u0440\u044B. \u0421\u043A\u0430\u043B\u044B \u0437\u0434\u0435\u0441\u044C
          \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B: \u0434\u0430\u0436\u0435
          \u043B\u0451\u0433\u043A\u0438\u0439 \u0442\u043E\u043B\u0447\u043E\u043A
          \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u0437\u0432\u0430\u0442\u044C
          \u0441\u0445\u043E\u0434 \u0449\u0435\u0431\u043D\u044F. \u041C\u0435\u0441\u0442\u043D\u044B\u0435
          \u0438\u0437\u0431\u0435\u0433\u0430\u044E\u0442 \u044D\u0442\u043E\u0433\u043E
          \u043C\u0435\u0441\u0442\u0430 \u2014 \u0433\u043E\u0432\u043E\u0440\u044F\u0442,
          \u0447\u0442\u043E \u043D\u043E\u0447\u044C\u044E \u0441\u043B\u044B\u0448\u0435\u043D
          \u043F\u043B\u0430\u0447 \u0442\u0435\u0445, \u043A\u0442\u043E \u0431\u044B\u043B
          \u0437\u0430\u0436\u0438\u0432\u043E \u043F\u043E\u0433\u0440\u0435\u0431\u0451\u043D
          \u043F\u043E\u0434 \u043A\u0430\u043C\u043D\u044F\u043C\u0438.\n\n\u042F
          \u043B\u0435\u0436\u0443 \u0441\u0440\u0435\u0434\u0438 \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432,
          \u043F\u0440\u0438\u0436\u0430\u0442\u044B\u0439 \u043A \u0437\u0435\u043C\u043B\u0435.
          \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u0441\u0438\u0434\u0438\u0442
          \u043D\u0430 \u043C\u043E\u0435\u0439 \u0433\u0440\u0443\u0434\u0438, \u0434\u0440\u0443\u0433\u043E\u0439
          \u2014 \u0434\u0435\u0440\u0436\u0438\u0442 \u043C\u043E\u0439 \u043C\u0435\u0447
          \u0437\u0430 \u043A\u043B\u0438\u043D\u043E\u043A, \u043A\u0430\u043A \u0434\u0443\u0431\u0438\u043D\u0443.\n\n\u2014
          \u0414\u0443\u043C\u0430\u043B, \u043E\u0434\u0438\u043D \u2014 \u0437\u043D\u0430\u0447\u0438\u0442
          \u0441\u0438\u043B\u044C\u043D\u044B\u0439? \u2014 \u0445\u0440\u0438\u043F\u0438\u0442
          \u043F\u0435\u0440\u0432\u044B\u0439, \u043F\u0430\u0445\u043D\u0443\u0449\u0438\u0439
          \u043B\u0443\u043A\u043E\u043C \u0438 \u043F\u043E\u0442\u043E\u043C. \u2014
          \u0410 \u043C\u044B \u2014 \u0434\u0432\u043E\u0435. \u0418 \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0435.\n\n\u041E\u043D\u0438
          \u043D\u0435 \u0443\u0431\u0438\u0432\u0430\u044E\u0442 \u0431\u044B\u0441\u0442\u0440\u043E.
          \u041E\u043D\u0438 \u0438\u0433\u0440\u0430\u044E\u0442.\n\n\u041C\u0435\u0447
          \u043F\u0430\u0434\u0430\u0435\u0442 \u0438\u0437 \u043C\u043E\u0438\u0445
          \u043F\u0430\u043B\u044C\u0446\u0435\u0432. \u0421\u0432\u0438\u0442\u043E\u043A
          \u0432\u044B\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u044E\u0442 \u0438\u0437-\u0437\u0430
          \u043F\u0430\u0437\u0443\u0445\u0438. \u041E\u0434\u0438\u043D \u0440\u0432\u0451\u0442
          \u0435\u0433\u043E \u043F\u043E\u043F\u043E\u043B\u0430\u043C \u2014 \u0441\u043C\u0435\u0451\u0442\u0441\u044F,
          \u043A\u0430\u043A \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430.\n\n\u042F
          \u043D\u0435 \u043A\u0440\u0438\u0447\u0443.\n\u041D\u0435 \u043F\u0440\u043E\u0448\u0443
          \u043F\u043E\u0449\u0430\u0434\u044B.\n\n\u041F\u0440\u043E\u0441\u0442\u043E
          \u0441\u043C\u043E\u0442\u0440\u044E, \u043A\u0430\u043A \u043F\u0435\u043F\u0435\u043B
          \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u043D\u0430
          \u043C\u043E\u0438 \u0433\u043B\u0430\u0437\u0430.\n\n\u041E\u043D\u0438
          \u0443\u0439\u0434\u0443\u0442. \u041F\u0440\u043E\u0434\u0430\u0434\u0443\u0442
          \u043E\u0431\u0440\u044B\u0432\u043A\u0438 \u0441\u0432\u0438\u0442\u043A\u0430
          \u0437\u0430 \u043C\u0435\u0448\u043E\u043A \u0437\u0435\u0440\u043D\u0430.\n\u0410
          \u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
          \u043F\u0430\u0434\u0451\u0442.\n\n\u0418 \u043D\u0438\u043A\u0442\u043E
          \u043D\u0435 \u0443\u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E \u044F
          \u0431\u044B\u043B \u0442\u0430\u043A \u0431\u043B\u0438\u0437\u043A\u043E.\n\n\u041D\u043E
          \u044D\u0442\u043E \u2014 \u043D\u0435 \u043C\u043E\u0439 \u043F\u0443\u0442\u044C.\n\u042F
          \u043D\u0435 \u043F\u0430\u043B \u043F\u043E\u0434 \u0432\u0435\u0441\u043E\u043C
          \u0434\u0432\u043E\u0438\u0445 \u0433\u043B\u0443\u043F\u0446\u043E\u0432.\n\u042F
          \u0432\u044B\u0436\u0438\u043B \u2014 \u043F\u043E\u0442\u043E\u043C\u0443
          \u0447\u0442\u043E \u0432 \u0431\u043E\u044E \u043D\u0435 \u0447\u0438\u0441\u043B\u043E
          \u0440\u0435\u0448\u0430\u0435\u0442 \u0438\u0441\u0445\u043E\u0434, \u0430
          \u0442\u043E, \u0437\u0430 \u0447\u0442\u043E \u0442\u044B \u0433\u043E\u0442\u043E\u0432
          \u0443\u043C\u0435\u0440\u0435\u0442\u044C.\n\u0418 \u044F \u0432\u0441\u0451
          \u0435\u0449\u0451 \u0438\u0434\u0443."
        _buttonText: "<b>\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430...</b>"
        _backgroundSpriteName: Chapter_3
      _menuBundleName: chapter_onlyscreen
      _menuPrefabName: Menu.prefab
      _cameraSO: {fileID: 11400000, guid: e20ca945d8c1140aa97944d71614f63e, type: 2}
      _battleScenePrefab: {fileID: 495528780594990917, guid: 4d68417a6adac48089e8c7b684c87c7d, type: 3}
      _battleSceneScreenPrefab: {fileID: 5389417796270955557, guid: c0b5d0845e4af409991a4831b288f5d2, type: 3}
    - _chapterName: Chapter 4
      _menuStart:
        _descriptionText: "<b>\u0413\u043B\u0430\u0432\u0430 IV: \u0422\u0435\u043D\u044C
          \u0432 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0435</b>\n11-\u0435
          \u0447\u0438\u0441\u043B\u043E, \u043C\u0435\u0441\u044F\u0446 \u0425\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
          \u0416\u0430\u043B\u0430, \u0433\u043E\u0434 \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u043E\u0433\u043E
          \u0417\u0430\u0442\u043C\u0435\u043D\u0438\u044F\n\n<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F:
          \u0411\u043E\u043B\u043E\u0442\u043E \u0427\u0451\u0440\u043D\u043E\u0433\u043E
          \u041E\u043A\u0430</b>\n\u0418\u0437 \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u043E\u0433\u043E
          \u043E\u0442\u0447\u0451\u0442\u0430 \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E
          \u0432\u0440\u0430\u0447\u0430 \u041C\u0430\u043B\u0435\u043D\u0430\n\u041D\u0438\u0437\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u044C,
          \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0432\u0448\u0430\u044F\u0441\u044F
          \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u044F
          \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E \u043A\u0430\u0440\u044C\u0435\u0440\u0430.
          \u0412\u043E\u0434\u0430 \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u043F\u0440\u0438\u0433\u043E\u0434\u043D\u0430
          \u0434\u043B\u044F \u043F\u0438\u0442\u044C\u044F: \u0447\u0451\u0440\u043D\u0430\u044F,
          \u0433\u0443\u0441\u0442\u0430\u044F, \u0441 \u043F\u0440\u0438\u043C\u0435\u0441\u044C\u044E
          \u0441\u0435\u0440\u043E\u0432\u043E\u0434\u043E\u0440\u043E\u0434\u0430
          \u0438 \u0433\u043D\u0438\u044E\u0449\u0438\u0445 \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u043B\u0435\u0439.
          \u0412\u043E\u0437\u0434\u0443\u0445 \u0442\u044F\u0436\u0451\u043B\u044B\u0439,
          \u043D\u0430\u0441\u044B\u0449\u0435\u043D \u0441\u043F\u043E\u0440\u0430\u043C\u0438
          \u0438 \u0438\u0441\u043F\u0430\u0440\u0435\u043D\u0438\u044F\u043C\u0438.
          \u0414\u043D\u0451\u043C \u2014 \u0433\u0443\u0441\u0442\u043E\u0439 \u0442\u0443\u043C\u0430\u043D,
          \u043D\u043E\u0447\u044C\u044E \u2014 \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435
          \u0431\u043E\u043B\u043E\u0442\u043D\u044B\u0445 \u0433\u0430\u0437\u043E\u0432.
          \u0422\u0432\u0451\u0440\u0434\u044B\u0445 \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u0432
          \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0442: \u043B\u0438\u0448\u044C
          \u0440\u0435\u0434\u043A\u0438\u0435 \xAB\u043E\u0441\u0442\u0440\u043E\u0432\u043A\u0438\xBB
          \u0438\u0437 \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0451\u043D\u043D\u044B\u0445
          \u043A\u043E\u0440\u043D\u0435\u0439 \u0438 \u0433\u043D\u0438\u043B\u043E\u0439
          \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u044B. \u041F\u0440\u043E\u0445\u043E\u0434
          \u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D \u0442\u043E\u043B\u044C\u043A\u043E
          \u043F\u043E \u0443\u0437\u043A\u043E\u0439 \u0433\u0440\u044F\u0434\u0435,
          \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439 \u043A\u0430\u043A
          \xAB\u0413\u0440\u0435\u0431\u0435\u043D\u044C \u041C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u043E\u0433\u043E\xBB.
          \u041C\u0435\u0441\u0442\u043E \u0438\u0437\u0431\u0435\u0433\u0430\u044E\u0442
          \u0434\u0430\u0436\u0435 \u0431\u0430\u043D\u0434\u0438\u0442\u044B. \u041F\u0440\u0438\u0447\u0438\u043D\u0430:
          \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0442\u0440\u0438
          \u0433\u043E\u0434\u0430 \u0437\u0434\u0435\u0441\u044C \u0438\u0441\u0447\u0435\u0437\u043B\u0438
          14 \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u041D\u0438 \u0442\u0435\u043B,
          \u043D\u0438 \u0441\u043B\u0435\u0434\u043E\u0432. \u0422\u043E\u043B\u044C\u043A\u043E
          \u0431\u043E\u043B\u043E\u0442\u043E.\n\n\u042F \u043F\u044C\u044E, \u043F\u043E\u0442\u043E\u043C\u0443
          \u0447\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u0431\u043E\u043B\u044C\u0448\u0435.\n\u0412\u043E\u0434\u0430
          \u2014 \u0447\u0451\u0440\u043D\u0430\u044F, \u043A\u0430\u043A \u0441\u043C\u043E\u043B\u044C,
          \u043D\u043E \u0433\u043E\u0440\u043B\u043E \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u043B\u043E
          \u0434\u043E \u043A\u0440\u043E\u0432\u0438. \u0412\u0441\u0451 \u0442\u0435\u043B\u043E
          \u0434\u0440\u043E\u0436\u0438\u0442. \u0416\u0430\u0440 \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
          \u0435\u0449\u0451 \u0443\u0442\u0440\u043E\u043C, \u043F\u043E\u0441\u043B\u0435
          \u0442\u043E\u0433\u043E \u043A\u0430\u043A \u044F \u043D\u0430\u043F\u0438\u043B\u0441\u044F
          \u0438\u0437 \u043B\u0443\u0436\u0438 \u0443 \u043A\u0440\u0430\u044F \u0431\u043E\u043B\u043E\u0442\u0430.
          \u0414\u0443\u043C\u0430\u043B \u2014 \u0434\u043E\u0436\u0434\u0435\u0432\u0430\u044F.
          \u041E\u0448\u0438\u0431\u0441\u044F.\n\n\u0413\u043E\u043B\u043E\u0432\u0430
          \u043A\u0440\u0443\u0436\u0438\u0442\u0441\u044F. \u0412 \u0433\u043B\u0430\u0437\u0430\u0445
          \u2014 \u0447\u0451\u0440\u043D\u044B\u0435 \u043F\u044F\u0442\u043D\u0430.
          \u0416\u0438\u0432\u043E\u0442 \u0441\u0432\u043E\u0434\u0438\u0442 \u0441\u043F\u0430\u0437\u043C\u0430\u043C\u0438.
          \u042F \u0435\u043B\u0435 \u0441\u0442\u043E\u044E.\n\n\u041D\u043E \u044F
          \u0432\u0438\u0436\u0443 \u0435\u0433\u043E.\n\n\u0422\u0435\u043D\u044C
          \u043D\u0430 \u0433\u0440\u0435\u0431\u043D\u0435. \u0412\u044B\u0441\u043E\u043A\u0430\u044F.
          \u041D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u0430\u044F. \u0414\u0430\u0436\u0435
          \u0432 \u044D\u0442\u043E\u043C \u0442\u0443\u043C\u0430\u043D\u0435 \u2014
          \u0447\u0451\u0442\u043A\u0430\u044F, \u043A\u0430\u043A \u043B\u0435\u0437\u0432\u0438\u0435.\n\n\u041E\u043D
          \u043D\u0435 \u043F\u0440\u044F\u0447\u0435\u0442\u0441\u044F.\n\u041E\u043D
          \u0436\u0434\u0430\u043B.\n\n\u0414\u043B\u0438\u043D\u043D\u044B\u0439
          \u043C\u0435\u0447 \u0443 \u0431\u0435\u0434\u0440\u0430 \u2014 \u043D\u0435
          \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0440\u0443\u0436\u0438\u0435,
          \u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435
          \u0435\u0433\u043E \u0442\u0435\u043B\u0430. \u041D\u0430 \u043F\u043B\u0435\u0447\u0430\u0445
          \u2014 \u043F\u043B\u0430\u0449 \u0431\u0435\u0437 \u0437\u043D\u0430\u043A\u043E\u0432.
          \u0411\u0435\u0437 \u0438\u043C\u0435\u043D\u0438. \u0411\u0435\u0437 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E.\n\n\u041D\u0430\u0435\u043C\u043D\u0438\u043A.\n\u0423\u0431\u0438\u0439\u0446\u0430.\n\u041C\u0430\u0441\u0442\u0435\u0440.\n\n\u0410
          \u044F \u2014 \u0431\u043E\u043B\u044C\u043D\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
          \u0441 \u0447\u0443\u0436\u0438\u043C \u043C\u0435\u0447\u043E\u043C \u0438
          \u043F\u0435\u043F\u043B\u043E\u043C \u0432 \u0436\u0438\u043B\u0430\u0445.\n\n\u041D\u043E
          \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u043F\u0443\u0442\u0438
          \u043D\u0430\u0437\u0430\u0434.\n\u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
          \u2014 \u0437\u0430 \u0431\u043E\u043B\u043E\u0442\u043E\u043C.\n\u0418
          \u044F \u0438\u0434\u0443."
        _buttonText: "<b>\u0412 \u0431\u043E\u0439...</b>"
        _backgroundSpriteName: Chapter_4
      _menuSuccess:
        _descriptionText: "<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F: \u0413\u0440\u0435\u0431\u0435\u043D\u044C
          \u041C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u043E\u0433\u043E</b>\n\u0418\u0437
          \u0437\u0430\u043F\u0438\u0441\u0435\u0439 \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u043E\u0433\u043E
          \u0434\u043E\u0437\u043E\u0440\u0430 \xAB\u0427\u0451\u0440\u043D\u0430\u044F
          \u0421\u0442\u0440\u0435\u043B\u0430\xBB\n\u0423\u0437\u043A\u0430\u044F
          \u0433\u0440\u044F\u0434\u0430 \u0442\u0432\u0451\u0440\u0434\u043E\u0439
          \u0437\u0435\u043C\u043B\u0438, \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u0432\u0448\u0430\u044F\u0441\u044F
          \u043D\u0430 \u043F\u043E\u043B\u043C\u0438\u043B\u0438 \u0447\u0435\u0440\u0435\u0437
          \u0446\u0435\u043D\u0442\u0440 \u0431\u043E\u043B\u043E\u0442\u0430. \u0428\u0438\u0440\u0438\u043D\u0430
          \u2014 \u043D\u0435 \u0431\u043E\u043B\u0435\u0435 \u0434\u0432\u0443\u0445
          \u0448\u0430\u0433\u043E\u0432. \u0421\u043B\u0435\u0432\u0430 \u0438 \u0441\u043F\u0440\u0430\u0432\u0430
          \u2014 \u0442\u0440\u044F\u0441\u0438\u043D\u0430, \u0433\u043B\u0443\u0431\u0438\u043D\u043E\u0439
          \u0434\u043E \u0442\u0440\u0451\u0445 \u043B\u043E\u043A\u0442\u0435\u0439.
          \u041F\u043E \u043A\u0440\u0430\u044F\u043C \u2014 \u043E\u0441\u0442\u0440\u044B\u0435
          \u0441\u0442\u0435\u0431\u043B\u0438 \u043A\u0430\u043C\u044B\u0448\u0430
          \u0438 \u0433\u043D\u0438\u044E\u0449\u0438\u0435 \u0441\u0442\u0432\u043E\u043B\u044B
          \u0438\u0432. \u0412 \u0442\u0443\u043C\u0430\u043D\u0435 \u0433\u0440\u0435\u0431\u0435\u043D\u044C
          \u043B\u0435\u0433\u043A\u043E \u0441\u043F\u0443\u0442\u0430\u0442\u044C
          \u0441 \u043E\u0431\u043C\u0430\u043D\u0447\u0438\u0432\u043E\u0439 \u0442\u0432\u0451\u0440\u0434\u044C\u044E,
          \u0447\u0442\u043E \u0438 \u0441\u0442\u0430\u043B\u043E \u0433\u0438\u0431\u0435\u043B\u044C\u044E
          \u043C\u043D\u043E\u0433\u0438\u0445. \u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435,
          \u0447\u0442\u043E \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442 \u0435\u0433\u043E
          \u043D\u0430 \u0444\u043E\u043D\u0435 \u0431\u043E\u043B\u043E\u0442\u0430,
          \u2014 \u043E\u0431\u043B\u043E\u043C\u043E\u043A \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E
          \u0441\u0442\u043E\u043B\u0431\u0430 \u0441 \u0432\u044B\u0431\u0438\u0442\u044B\u043C
          \u0433\u043B\u0430\u0437\u043E\u043C (\u043E\u0442\u0441\u044E\u0434\u0430
          \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \xAB\u0427\u0451\u0440\u043D\u043E\u0435
          \u041E\u043A\u043E\xBB).\n\n\u041E\u043D \u043C\u0451\u0440\u0442\u0432.\n\n\u041B\u0435\u0436\u0438\u0442
          \u043D\u0430 \u043A\u0440\u0430\u044E \u0433\u0440\u0435\u0431\u043D\u044F,
          \u043E\u0434\u043D\u0430 \u0440\u0443\u043A\u0430 \u0432 \u0442\u0440\u044F\u0441\u0438\u043D\u0435,
          \u0434\u0440\u0443\u0433\u0430\u044F \u0432\u0441\u0451 \u0435\u0449\u0451
          \u0441\u0436\u0438\u043C\u0430\u0435\u0442 \u0440\u0443\u043A\u043E\u044F\u0442\u044C
          \u0434\u043B\u0438\u043D\u043D\u043E\u0433\u043E \u043C\u0435\u0447\u0430
          \u2014 \u0442\u043E\u043D\u043A\u043E\u0433\u043E, \u043A\u0430\u043A \u0438\u0433\u043B\u0430,
          \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0439 \u0438\u043D\u043A\u0440\u0443\u0441\u0442\u0430\u0446\u0438\u0435\u0439
          \u0432\u0434\u043E\u043B\u044C \u044D\u0444\u0435\u0441\u0430. \u041D\u0430
          \u043B\u0435\u0437\u0432\u0438\u0438 \u2014 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439
          \u0437\u0430\u0437\u0443\u0431\u0440\u0438\u043D\u044B. \u0422\u043E\u043B\u044C\u043A\u043E
          \u043F\u044F\u0442\u043D\u043E \u043A\u0440\u043E\u0432\u0438 \u2014 \u043C\u043E\u0435\u0439.\n\n\u042F
          \u043D\u0435 \u043F\u043E\u043C\u043D\u044E, \u043A\u0430\u043A \u044D\u0442\u043E
          \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.\n\n\u041F\u043E\u043C\u043D\u044E
          \u0442\u043E\u043B\u044C\u043A\u043E: \u0436\u0430\u0440. \u0411\u043E\u043B\u044C.
          \u0422\u0443\u043C\u0430\u043D. \u0418 \u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430
          \u2014 \u0431\u0435\u0437 \u0437\u043B\u043E\u0431\u044B, \u0431\u0435\u0437
          \u0441\u0442\u0440\u0430\u0445\u0430. \u0422\u043E\u043B\u044C\u043A\u043E
          \u0440\u0430\u0431\u043E\u0442\u0430.\n\n\u041E\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
          \u043F\u0435\u0440\u0432\u044B\u043C.\n\u042F \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C,
          \u043A\u0442\u043E \u0441 \u043D\u0438\u043C \u0434\u0440\u0430\u043B\u0441\u044F,
          \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0443\u043F\u0430\u043B
          \u0432\u043E\u0432\u0440\u0435\u043C\u044F.\n\n\u041C\u043E\u0439 \u043C\u0435\u0447
          \u2014 \u0432 \u043D\u043E\u0436\u043D\u0430\u0445. \u0414\u0440\u043E\u0436\u044C
          \u0432 \u0440\u0443\u043A\u0430\u0445 \u043D\u0435 \u043F\u0440\u043E\u0448\u043B\u0430,
          \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E \u0443\u0436\u0435
          \u043D\u0435 \u0432\u0430\u0436\u043D\u043E.\n\n\u0412 \u0435\u0433\u043E
          \u043F\u043E\u044F\u0441\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0435
          \u2014 \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0441 \u044F\u0434\u043E\u043C,
          \u0441\u0432\u0438\u0442\u043E\u043A \u0441 \u043C\u043E\u0438\u043C \u0438\u043C\u0435\u043D\u0435\u043C\u2026
          \u0438 \u043A\u043B\u044E\u0447. \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439,
          \u043C\u0435\u0434\u043D\u044B\u0439, \u0441 \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u043E\u0439
          \xAB\u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
          \u2014 \u0412\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0435 \u0412\u043E\u0440\u043E\u0442\u0430\xBB.\n\n\u041E\u043D\u0438
          \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0436\u0434\u0430\u043B\u0438
          \u043C\u0435\u043D\u044F.\n\u041E\u043D\u0438 \u0445\u043E\u0442\u0435\u043B\u0438,
          \u0447\u0442\u043E\u0431\u044B \u044F \u0434\u043E\u0448\u0451\u043B.\n\n\u041D\u043E
          \u043D\u0435 \u0436\u0438\u0432\u044B\u043C.\n\n\u042F \u0432\u044B\u0442\u0438\u0440\u0430\u044E
          \u0433\u0443\u0431\u044B \u2014 \u043A\u0440\u043E\u0432\u044C, \u043F\u043E\u0442,
          \u0436\u0451\u043B\u0447\u044C.\n\u041F\u043E\u0434\u043D\u0438\u043C\u0430\u044E
          \u0435\u0433\u043E \u043C\u0435\u0447.\n\u041A\u043E\u0440\u043E\u0447\u0435
          \u043C\u043E\u0435\u0433\u043E. \u041B\u0435\u0433\u0447\u0435. \u0418\u0434\u0435\u0430\u043B\u0435\u043D
          \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u0431\u043E\u044F.\n\n\u0422\u0435\u043F\u0435\u0440\u044C
          \u0443 \u043C\u0435\u043D\u044F \u0434\u0432\u0430 \u043A\u043B\u0438\u043D\u043A\u0430.\n\u0418
          \u043E\u0434\u0438\u043D \u0448\u0430\u043D\u0441."
        _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
        _backgroundSpriteName: Chapter_4
      _menuFailed:
        _descriptionText: "<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F: \u0422\u0440\u044F\u0441\u0438\u043D\u0430
          \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u0413\u0440\u0435\u0431\u043D\u044F</b>\n\u0418\u0437
          \u0443\u0441\u0442\u043D\u043E\u0439 \u043B\u0435\u0433\u0435\u043D\u0434\u044B
          \u0431\u043E\u043B\u043E\u0442\u043D\u044B\u0445 \u0435\u0433\u0435\u0440\u0435\u0439\n\u041C\u0435\u0441\u0442\u043E,
          \u0433\u0434\u0435 \u0431\u043E\u043B\u043E\u0442\u043E \xAB\u0434\u044B\u0448\u0438\u0442\xBB
          \u2014 \u043F\u0443\u0437\u044B\u0440\u0438 \u0433\u0430\u0437\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F
          \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
          \u0434\u0430\u0436\u0435 \u0432 \u043C\u043E\u0440\u043E\u0437. \u0417\u0434\u0435\u0441\u044C
          \u0432\u043E\u0434\u0430 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
          \u0433\u043B\u0443\u0431\u043E\u043A\u0430, \u0430 \u0434\u043D\u043E \u2014
          \u0441\u043F\u043B\u043E\u0448\u043D\u0430\u044F \u0433\u043D\u0438\u044E\u0449\u0430\u044F
          \u043C\u0430\u0441\u0441\u0430. \u0422\u0435, \u043A\u0442\u043E \u043F\u0430\u0434\u0430\u0435\u0442
          \u0441\u044E\u0434\u0430, \u043D\u0435 \u0442\u043E\u043D\u0443\u0442 \u0441\u0440\u0430\u0437\u0443.
          \u0418\u0445 \u0437\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
          \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445
          \u0443 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445. \u0415\u0433\u0435\u0440\u044F
          \u0433\u043E\u0432\u043E\u0440\u044F\u0442: \u044D\u0442\u043E \u0431\u043E\u043B\u043E\u0442\u043E
          \u043A\u043E\u0440\u043C\u0438\u0442\u0441\u044F \u0441\u0442\u0440\u0430\u0445\u043E\u043C.\n\n\u042F
          \u043D\u0435 \u0443\u043F\u0430\u043B.\n\u041C\u0435\u043D\u044F \u0431\u0440\u043E\u0441\u0438\u043B\u0438.\n\n\u041E\u043D
          \u0441\u0442\u043E\u044F\u043B \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439,
          \u0434\u0435\u0440\u0436\u0430 \u043C\u043E\u0439 \u043C\u0435\u0447 \u0437\u0430
          \u043E\u0441\u0442\u0440\u0438\u0435, \u043A\u0430\u043A \u043F\u043E\u0441\u043E\u0445.\n\u2014
          \u0416\u0430\u043B\u044C, \u2014 \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D.
          \u2014 \u0422\u044B \u0431\u044B\u043B \u0445\u043E\u0440\u043E\u0448.
          \u041D\u043E \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0430 \u2014
          \u043F\u043B\u043E\u0445\u043E\u0439 \u0441\u043E\u044E\u0437\u043D\u0438\u043A
          \u0432 \u0431\u043E\u044E.\n\n\u041E\u043D \u043D\u0435 \u0441\u0442\u0430\u043B
          \u0440\u0435\u0437\u0430\u0442\u044C. \u041F\u0440\u043E\u0441\u0442\u043E
          \u0442\u043E\u043B\u043A\u043D\u0443\u043B.\n\n\u042F \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F
          \u0432 \u0447\u0451\u0440\u043D\u0443\u044E \u0436\u0438\u0436\u0443. \u041E\u043D\u0430
          \u043E\u0431\u043D\u044F\u043B\u0430 \u043C\u0435\u043D\u044F, \u043A\u0430\u043A
          \u043C\u0430\u0442\u044C, \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0449\u0430\u044F
          \u0441\u044B\u043D\u0430 \u0434\u043E\u043C\u043E\u0439.\n\n\u0421\u0432\u0438\u0442\u043E\u043A
          \u0443\u0448\u0451\u043B \u043F\u043E\u0434 \u0432\u043E\u0434\u0443 \u043F\u0435\u0440\u0432\u044B\u043C.\n\u041F\u043E\u0442\u043E\u043C
          \u2014 \u044F.\n\n\u0411\u043E\u043B\u043E\u0442\u043E \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u043E
          \u0441\u043B\u0435\u0434\u043E\u0432.\n\u041A\u0430\u043A \u0438 \u0432\u0441\u0435\u0445
          \u0434\u043E \u043C\u0435\u043D\u044F.\n\n\u041D\u043E \u044D\u0442\u043E
          \u2014 \u043D\u0435 \u043C\u043E\u0439 \u043F\u0443\u0442\u044C.\n\u042F
          \u043D\u0435 \u0443\u0442\u043E\u043D\u0443\u043B \u0432 \u0442\u0440\u044F\u0441\u0438\u043D\u0435.\n\u042F
          \u043F\u043E\u0431\u0435\u0434\u0438\u043B \u0443\u0431\u0438\u0439\u0446\u0443
          \u2014 \u043D\u0435 \u0441\u0438\u043B\u043E\u0439, \u0430 \u0442\u0435\u043C,
          \u0447\u0442\u043E \u0434\u0430\u0436\u0435 \u0432 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0435
          \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B \u043C\u0435\u0447.\n\u0418
          \u044F \u0432\u0441\u0451 \u0435\u0449\u0451 \u0438\u0434\u0443."
        _buttonText: "<b>\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430...</b>"
        _backgroundSpriteName: Chapter_4
      _menuBundleName: chapter_onlyscreen
      _menuPrefabName: Menu.prefab
      _cameraSO: {fileID: 11400000, guid: e20ca945d8c1140aa97944d71614f63e, type: 2}
      _battleScenePrefab: {fileID: 495528780594990917, guid: 4d68417a6adac48089e8c7b684c87c7d, type: 3}
      _battleSceneScreenPrefab: {fileID: 5389417796270955557, guid: c0b5d0845e4af409991a4831b288f5d2, type: 3}
    - _chapterName: Chapter 5
      _menuStart:
        _descriptionText: "<b>\u0413\u043B\u0430\u0432\u0430 V: \u0412\u0440\u0430\u0442\u0430
          \u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D\u0430</b>\n13-\u0435
          \u0447\u0438\u0441\u043B\u043E, \u043C\u0435\u0441\u044F\u0446 \u0425\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
          \u0416\u0430\u043B\u0430, \u0433\u043E\u0434 \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u043E\u0433\u043E
          \u0417\u0430\u0442\u043C\u0435\u043D\u0438\u044F\n\n<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F:
          \u0412\u044A\u0435\u0437\u0434 \u0432 \u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
          \u2014 \xAB\u0414\u043E\u0440\u043E\u0433\u0430 \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
          \u0414\u044B\u0445\u0430\u043D\u0438\u044F\xBB</b>\n\u0418\u0437 \u0432\u043E\u0435\u043D\u043D\u043E-\u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u0433\u043E
          \u043E\u0442\u0447\u0451\u0442\u0430 \u0433\u0435\u043D\u0435\u0440\u0430\u043B\u0430
          \u0422\u043E\u0440\u0435\u043D\u0430\n\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
          \u043F\u043E\u0434\u044A\u0451\u043C \u043A \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438:
          \u043A\u0440\u0443\u0442\u0430\u044F \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
          \u0434\u043E\u0440\u043E\u0433\u0430, \u0432\u044B\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F
          \u0431\u0443\u043B\u044B\u0436\u043D\u0438\u043A\u043E\u043C \u044D\u043F\u043E\u0445\u0438
          \u0421\u0442\u0430\u0440\u043E\u0433\u043E \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430.
          \u0414\u043B\u0438\u043D\u0430 \u2014 300 \u0448\u0430\u0433\u043E\u0432.
          \u0428\u0438\u0440\u0438\u043D\u0430 \u2014 \u043D\u0430 \u0434\u0432\u0443\u0445
          \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u0421\u043F\u0440\u0430\u0432\u0430
          \u2014 \u043E\u0431\u0440\u044B\u0432, \u0441\u043B\u0435\u0432\u0430 \u2014
          \u0441\u0442\u0435\u043D\u0430 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438,
          \u0432\u044B\u0441\u043E\u0442\u043E\u0439 25 \u043B\u043E\u043A\u0442\u0435\u0439.
          \u0412\u043E\u0440\u043E\u0442\u0430 \u2014 \u0436\u0435\u043B\u0435\u0437\u043E
          \u0438 \u0434\u0443\u0431, \u0443\u0441\u0438\u043B\u0435\u043D\u044B \u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u043C
          \u0441\u043F\u043B\u0430\u0432\u043E\u043C. \u041D\u0430\u0434 \u043D\u0438\u043C\u0438
          \u2014 \u0431\u043E\u0439\u043D\u0438\u0446\u044B, \u0444\u0430\u043A\u0435\u043B\u044B,
          \u043A\u0430\u0442\u0430\u043F\u0443\u043B\u044C\u0442\u044B. \u041D\u043E
          \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u043E\u0440\u043E\u0442\u0430
          \u0437\u0430\u043A\u0440\u044B\u0442\u044B. \u0418 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
          \u2014 \u043D\u0438\u043A\u043E\u0433\u043E. \u041D\u0438 \u043F\u0430\u0442\u0440\u0443\u043B\u044F.
          \u041D\u0438 \u0437\u043D\u0430\u043C\u0451\u043D. \u0422\u043E\u043B\u044C\u043A\u043E
          \u0432\u0435\u0442\u0435\u0440, \u043D\u0435\u0441\u0443\u0449\u0438\u0439
          \u043F\u0435\u043F\u0435\u043B \u0438 \u0437\u0430\u043F\u0430\u0445 \u0433\u0430\u0440\u0438.
          \u041F\u043E \u0443\u0441\u0442\u0430\u0432\u0443, \u0434\u043E\u0440\u043E\u0433\u0430
          \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u043C\u0430.
          \u041D\u043E \u0443\u0441\u0442\u0430\u0432 \u0434\u0430\u0432\u043D\u043E
          \u043C\u0451\u0440\u0442\u0432.\n\n\u042F \u0432\u0438\u0436\u0443 \u0438\u0445
          \u0443 \u0432\u043E\u0440\u043E\u0442.\n\n\u0422\u0440\u043E\u0435.\n\n\u041F\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
          \u2014 \u043E\u043D. \u0412\u044B\u0441\u043E\u043A\u0438\u0439, \u0432
          \u0447\u0451\u0440\u043D\u043E\u043C \u043F\u043B\u0430\u0449\u0435 \u0431\u0435\u0437
          \u0437\u043D\u0430\u043A\u043E\u0432, \u043D\u043E \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0439
          \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u044C\u044E \u0447\u0435\u0440\u0435\u0437
          \u0433\u0440\u0443\u0434\u044C. \u0422\u0430\u043A \u043D\u043E\u0441\u044F\u0442
          \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435, \u043A\u043E\u0433\u043E
          \u043F\u0440\u0438\u0437\u043D\u0430\u043B \u0421\u043E\u0432\u0435\u0442
          \u0421\u0435\u043C\u0438 \u041A\u043B\u0438\u043D\u043A\u043E\u0432. \u041C\u0430\u0441\u0442\u0435\u0440\u0430.
          \u0423\u0431\u0438\u0439\u0446\u044B \u043A\u043E\u0440\u043E\u043B\u0435\u0439.
          \u0421\u0443\u0434\u044C\u0438 \u0431\u0435\u0437 \u0441\u0443\u0434\u0430.\n\n\u0415\u0433\u043E
          \u043C\u0435\u0447 \u2014 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
          \u0441\u0442\u0430\u043B\u044C. \u042D\u0442\u043E \xAB\u0421\u0432\u0435\u0442
          \u0412\u0435\u0447\u043D\u043E\u0441\u0442\u0438\xBB \u2014 \u043A\u043B\u0438\u043D\u043E\u043A
          \u0438\u0437 \u0431\u0435\u043B\u043E\u0433\u043E \u0441\u043F\u043B\u0430\u0432\u0430,
          \u0447\u0442\u043E \u043D\u0435 \u0442\u0443\u0441\u043A\u043D\u0435\u0435\u0442
          \u0434\u0430\u0436\u0435 \u0432 \u043F\u0435\u043F\u043B\u0435. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
          \u043E\u043D \u0440\u0430\u0437\u0440\u0435\u0437\u0430\u0435\u0442 \u0434\u043E\u0441\u043F\u0435\u0445,
          \u043A\u0430\u043A \u0442\u043A\u0430\u043D\u044C.\n\n\u0421\u043B\u0435\u0432\u0430
          \u0438 \u0441\u043F\u0440\u0430\u0432\u0430 \u043E\u0442 \u043D\u0435\u0433\u043E
          \u2014 \u0432\u043E\u0438\u043D\u044B \u0432 \u043B\u0451\u0433\u043A\u0438\u0445
          \u043A\u0438\u0440\u0430\u0441\u0430\u0445. \u041C\u043E\u043B\u043E\u0434\u044B\u0435.
          \u041D\u0430\u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435.
          \u041D\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438,
          \u043D\u0435 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u044B \u2014
          \u0441\u043E\u043B\u0434\u0430\u0442\u044B. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
          \u0438\u0437 \u044D\u043B\u0438\u0442\u044B.\n\n\u041E\u043D\u0438 \u043D\u0435
          \u043D\u0430\u043F\u0430\u0434\u0430\u044E\u0442.\n\u041E\u043D\u0438 \u0436\u0434\u0443\u0442,
          \u043F\u043E\u043A\u0430 \u044F \u043F\u043E\u0434\u043E\u0439\u0434\u0443.\n\n\u041F\u043E\u0442\u043E\u043C\u0443
          \u0447\u0442\u043E \u0437\u043D\u0430\u044E\u0442: \u044F \u043D\u0435
          \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0441\u044C.\n\u041F\u043E\u0442\u043E\u043C\u0443
          \u0447\u0442\u043E \u044F \u0434\u043E\u0448\u0451\u043B.\n\n\u041C\u043E\u0438
          \u0440\u0443\u043A\u0438 \u0434\u0440\u043E\u0436\u0430\u0442. \u0416\u0430\u0440
          \u043D\u0435 \u043F\u0440\u043E\u0448\u0451\u043B. \u0420\u0430\u043D\u0430
          \u043D\u0430 \u0431\u043E\u043A\u0443 \u0433\u043D\u043E\u0438\u0442\u0441\u044F.
          \u041D\u043E \u043C\u0435\u0447\u0438 \u2014 \u043E\u0431\u0430 \u043F\u0440\u0438
          \u043C\u043D\u0435. \u0422\u043E\u0442, \u0447\u0442\u043E \u0432\u0437\u044F\u043B
          \u0443 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0430, \u0438 \u0442\u043E\u0442,
          \u0447\u0442\u043E \u0432\u044B\u0440\u0432\u0430\u043B \u0438\u0437 \u0440\u0443\u043A
          \u0443\u0431\u0438\u0439\u0446\u044B.\n\n\u042F \u043D\u0435 \u0433\u0435\u0440\u043E\u0439.\n\u042F
          \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u043B\u0434\u0430\u0442,
          \u0443 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043E\u0441\u0442\u0430\u043B\u0441\u044F
          \u043E\u0434\u0438\u043D \u0434\u043E\u043B\u0433."
        _buttonText: "<b>\u0412 \u0431\u043E\u0439...</b>"
        _backgroundSpriteName: Chapter_5
      _menuSuccess:
        _descriptionText: "<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F: \u0423
          \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u0412\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0445
          \u0412\u043E\u0440\u043E\u0442 \u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D\u0430</b>\n\u0418\u0437
          \u043E\u0442\u0447\u0451\u0442\u0430 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u043D\u043E\u0433\u043E
          \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044F, 13-\u0435
          \u0447\u0438\u0441\u043B\u043E\n\u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
          \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430 \u043F\u0435\u0440\u0435\u0434
          \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438. \u041D\u0430 \u0431\u0440\u0443\u0441\u0447\u0430\u0442\u043A\u0435
          \u2014 \u0442\u0440\u0435\u0449\u0438\u043D\u044B \u043E\u0442 \u0441\u0442\u0430\u0440\u044B\u0445
          \u0431\u043E\u0451\u0432. \u0423 \u0441\u0442\u0435\u043D\u044B \u2014
          \u0441\u043B\u0435\u0434\u044B \u043E\u0442 \u043A\u043E\u0441\u0442\u0440\u043E\u0432
          \u0438 \u043A\u0440\u043E\u0432\u0430\u0432\u044B\u0435 \u043F\u044F\u0442\u043D\u0430,
          \u043D\u0435 \u043E\u0442\u043C\u044B\u0442\u044B\u0435 \u0434\u043E\u0436\u0434\u0451\u043C.
          \u0412 \u0431\u043E\u0439\u043D\u0438\u0446\u0430\u0445 \u2014 \u0442\u0440\u0435\u0432\u043E\u0433\u0430.
          \u0424\u0430\u043A\u0435\u043B\u044B \u0437\u0430\u0436\u0436\u0435\u043D\u044B.
          \u0410\u0440\u0431\u0430\u043B\u0435\u0442\u044B \u2014 \u043D\u0430\u0433\u043E\u0442\u043E\u0432\u0435.
          \u041A\u0440\u0435\u043F\u043E\u0441\u0442\u044C \u043D\u0435 \u0441\u0434\u0430\u043B\u0430\u0441\u044C.
          \u041E\u043D\u0430 \u0436\u0434\u0430\u043B\u0430.\n\n\u041E\u043D\u0438
          \u043C\u0435\u0440\u0442\u0432\u044B.\n\n\u041C\u0430\u0441\u0442\u0435\u0440
          \u043B\u0435\u0436\u0438\u0442 \u043D\u0430 \u0441\u043F\u0438\u043D\u0435,
          \u0440\u0443\u043A\u0438 \u0441\u043B\u043E\u0436\u0435\u043D\u044B \u043D\u0430
          \u0433\u0440\u0443\u0434\u0438, \u0431\u0443\u0434\u0442\u043E \u043F\u0440\u0438\u043D\u044F\u043B
          \u0441\u0432\u043E\u044E \u0441\u0443\u0434\u044C\u0431\u0443. \u0415\u0433\u043E
          \u043C\u0435\u0447 \u2014 \u0440\u044F\u0434\u043E\u043C, \u043D\u043E
          \u043D\u0435 \u0441\u043B\u043E\u043C\u0430\u043D. \u042F \u043E\u0441\u0442\u0430\u0432\u0438\u043B
          \u0435\u0433\u043E \u0446\u0435\u043B\u044B\u043C. \u041F\u0443\u0441\u0442\u044C
          \u043B\u0435\u0436\u0438\u0442 \u043A\u0430\u043A \u043F\u0430\u043C\u044F\u0442\u044C:
          \u0434\u0430\u0436\u0435 \u043B\u0443\u0447\u0448\u0438\u0435 \u0441\u0440\u0435\u0434\u0438
          \u0442\u0435\u043D\u0435\u0439 \u2014 \u0441\u043C\u0435\u0440\u0442\u043D\u044B.\n\n\u0415\u0433\u043E
          \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u2014 \u0443 \u0441\u0442\u0435\u043D\u044B.
          \u0411\u044B\u0441\u0442\u0440\u044B\u0435, \u043D\u043E \u043D\u0435 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u044B\u0435.
          \u041E\u0434\u0438\u043D \u043E\u0448\u0438\u0431\u0441\u044F \u0448\u0430\u0433\u043E\u043C.
          \u0412\u0442\u043E\u0440\u043E\u0439 \u2014 \u0437\u0430\u043C\u0435\u0448\u043A\u0430\u043B\u0441\u044F.
          \u042D\u0442\u043E\u0433\u043E \u0445\u0432\u0430\u0442\u0438\u043B\u043E.\n\n\u042F
          \u043D\u0435 \u043F\u043E\u043C\u043D\u044E, \u043A\u0430\u043A \u044D\u0442\u043E
          \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.\n\u041F\u043E\u043C\u043D\u044E
          \u0442\u043E\u043B\u044C\u043A\u043E: \u044F \u043D\u0435 \u0443\u043F\u0430\u043B.\n\n\u0412
          \u0435\u0433\u043E \u0441\u0443\u043C\u043A\u0435 \u2014 \u043F\u0435\u0447\u0430\u0442\u044C
          \u0421\u043E\u0432\u0435\u0442\u0430 \u0421\u0435\u043C\u0438 \u041A\u043B\u0438\u043D\u043A\u043E\u0432,
          \u0441\u043F\u0438\u0441\u043E\u043A \u0438\u043C\u0451\u043D (\u043C\u043E\u0451
          \u2014 \u043F\u0435\u0440\u0432\u043E\u0435), \u0438 \u043A\u043B\u044E\u0447-\u0430\u043C\u0443\u043B\u0435\u0442,
          \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0449\u0438\u0439 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435
          \u0432\u043E\u0440\u043E\u0442\u0430.\n\n\u042F \u043F\u043E\u0434\u0445\u043E\u0436\u0443
          \u043A \u0434\u0432\u0435\u0440\u0438. \u0412\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E
          \u043A\u043B\u044E\u0447.\n\u041C\u0435\u0445\u0430\u043D\u0438\u0437\u043C
          \u0441\u043A\u0440\u0438\u043F\u0438\u0442 \u2014 \u0432\u0435\u043A\u043E\u0432\u043E\u0439,
          \u043D\u043E \u0436\u0438\u0432\u043E\u0439.\n\n\u0412\u043E\u0440\u043E\u0442\u0430
          \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F.\n\n\u0418\u0437\u043D\u0443\u0442\u0440\u0438
          \u0432\u044B\u0431\u0435\u0433\u0430\u044E\u0442 \u0441\u043E\u043B\u0434\u0430\u0442\u044B
          \u2014 \u043D\u0435 \u0441 \u043E\u0440\u0443\u0436\u0438\u0435\u043C,
          \u0430 \u0441 \u043D\u043E\u0441\u0438\u043B\u043A\u0430\u043C\u0438. \u041E\u0434\u0438\u043D
          \u0438\u0437 \u043D\u0438\u0445 \u2014 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440
          \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438, \u0433\u0435\u043D\u0435\u0440\u0430\u043B
          \u042D\u043B\u0434\u0430\u0440. \u0415\u0433\u043E \u043B\u0438\u0446\u043E
          \u0432 \u0448\u0440\u0430\u043C\u0430\u0445, \u043D\u043E \u0433\u043B\u0430\u0437\u0430
          \u2014 \u0436\u0438\u0432\u044B\u0435.\n\n\u2014 \u0422\u044B \u043F\u0440\u0438\u043D\u0451\u0441
          \u0441\u0432\u0438\u0442\u043E\u043A? \u2014 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
          \u043E\u043D, \u0433\u043E\u043B\u043E\u0441 \u0434\u0440\u043E\u0436\u0438\u0442.\n\n\u042F
          \u043A\u0438\u0432\u0430\u044E.\n\n\u041E\u043D \u0431\u0435\u0440\u0451\u0442
          \u0435\u0433\u043E. \u0427\u0438\u0442\u0430\u0435\u0442. \u0418 \u0432\u043F\u0435\u0440\u0432\u044B\u0435
          \u0437\u0430 \u043C\u0435\u0441\u044F\u0446\u044B \u2014 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F.\n\n\u2014
          \u041C\u044B \u0443\u0441\u043F\u0435\u0435\u043C, \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
          \u043E\u043D. \u2014 \u0410\u0440\u043C\u0438\u044F \u0443\u0436\u0435
          \u0432 \u043F\u0443\u0442\u0438. \u041D\u043E \u0431\u0435\u0437 \u0442\u0432\u043E\u0435\u0433\u043E
          \u0434\u043E\u043D\u0435\u0441\u0435\u043D\u0438\u044F\u2026 \u043C\u044B
          \u0431\u044B \u043F\u0430\u043B\u0438 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435.\n\n\u041C\u0435\u043D\u044F
          \u0443\u0432\u043E\u0434\u044F\u0442 \u0432\u043D\u0443\u0442\u0440\u044C.
          \u0414\u0430\u044E\u0442 \u0432\u043E\u0434\u0443. \u0427\u0438\u0441\u0442\u043E\u0435
          \u043E\u0434\u0435\u044F\u043B\u043E. \u0426\u0435\u043B\u0438\u0442\u0435\u043B\u044C
          \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0440\u0430\u043D\u044B.\n\n\u041D\u0430
          \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0434\u0435\u043D\u044C
          \u2014 \u0433\u043E\u043D\u0446\u044B \u0443\u0445\u043E\u0434\u044F\u0442
          \u0432\u043E \u0432\u0441\u0435 \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0438.\n\u0427\u0435\u0440\u0435\u0437
          \u0442\u0440\u0438 \u0434\u043D\u044F \u2014 \u043F\u0435\u0440\u0432\u044B\u0435
          \u043F\u043E\u0434\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F.\n\u0427\u0435\u0440\u0435\u0437
          \u043D\u0435\u0434\u0435\u043B\u044E \u2014 \xAB\u0422\u0435\u043D\u0438
          \u041A\u043B\u0438\u043D\u043A\u0430\xBB \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u044E\u0442
          \u043E\u0442 \u0441\u0442\u0435\u043D.\n\n\u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
          \u043D\u0435 \u043F\u0430\u043B.\n\u041F\u043E\u0442\u043E\u043C\u0443
          \u0447\u0442\u043E \u043E\u0434\u0438\u043D \u0441\u043E\u043B\u0434\u0430\u0442
          \u0434\u043E\u0448\u0451\u043B.\n\n\u041C\u0435\u043D\u044F \u043D\u0435
          \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0433\u0435\u0440\u043E\u0435\u043C.\n\u041D\u043E
          \u0442\u0435\u043F\u0435\u0440\u044C, \u043A\u043E\u0433\u0434\u0430 \u044F
          \u0438\u0434\u0443 \u043F\u043E \u0434\u0432\u043E\u0440\u0443, \u0441\u043E\u043B\u0434\u0430\u0442\u044B
          \u043A\u043B\u0430\u0434\u0443\u0442 \u0440\u0443\u043A\u0443 \u043D\u0430
          \u0441\u0435\u0440\u0434\u0446\u0435.\n\n\u0410 \u043D\u043E\u0447\u044C\u044E,
          \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430 \u0434\u043E\u043B\u0433\u043E\u0435
          \u0432\u0440\u0435\u043C\u044F, \u044F \u0441\u043F\u043B\u044E \u0431\u0435\u0437
          \u043A\u043E\u0448\u043C\u0430\u0440\u043E\u0432.\n\n\u042F \u043D\u0435
          \u0433\u0435\u0440\u043E\u0439.\n\u041D\u043E \u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B
          \u0434\u043E\u043B\u0433.\n\u0418 \u044D\u0442\u043E\u0433\u043E \u2014
          \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0434\u043B\u044F
          \u043C\u0438\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0435\u0449\u0451
          \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0441\u043F\u0430\u0441\u0451\u043D.\n\u041A\u0430\u0439\u0440\u0430\u043D
          \u0412\u0435\u0439\u043D\n\u0421\u0435\u0440\u0436\u0430\u043D\u0442 7-\u0433\u043E
          \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u043E\u0433\u043E
          \u043F\u043E\u043B\u043A\u0430 (\u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D
          \u0432 \u0437\u0432\u0430\u043D\u0438\u0438)"
        _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
        _backgroundSpriteName: Chapter_5
      _menuFailed:
        _descriptionText: "<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F: \u041E\u0431\u043E\u0447\u0438\u043D\u0430
          \u0414\u043E\u0440\u043E\u0433\u0438 \u041F\u043E\u0441\u043B \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
          \u0414\u044B\u0445\u0430\u043D\u0438\u044F</b>\n\u0418\u0437 \u0434\u043E\u0437\u043D\u0430\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
          \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0430, \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u043E\u0433\u043E
          \u0432 \u0440\u0443\u0438\u043D\u0430\u0445\n\u0422\u0435\u043B\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E
          \u0443 47-\u0433\u043E \u0431\u0443\u043B\u044B\u0436\u043D\u0438\u043A\u0430
          \u043E\u0442 \u0432\u043E\u0440\u043E\u0442. \u041E\u0440\u0443\u0436\u0438\u0435
          \u2014 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442.
          \u041E\u0434\u0435\u0436\u0434\u0430 \u2014 \u0438\u0437\u043E\u0434\u0440\u0430\u043D\u0430,
          \u0431\u0435\u0437 \u0437\u043D\u0430\u043A\u043E\u0432 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u0438.
          \u041F\u0440\u0438\u0437\u043D\u0430\u043A\u043E\u0432 \u043F\u044B\u0442\u043E\u043A
          \u2014 \u043D\u0435\u0442. \u0421\u043C\u0435\u0440\u0442\u044C \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B\u0430
          \u043E\u0442 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
          \u043A\u043E\u043B\u043E\u0442\u043E-\u0440\u0435\u0437\u0430\u043D\u044B\u0445
          \u0440\u0430\u043D. \u0420\u044F\u0434\u043E\u043C \u2014 \u043E\u0431\u0440\u044B\u0432\u043A\u0438
          \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430 \u0441 \u043D\u0430\u0434\u043F\u0438\u0441\u044C\u044E
          \xAB\u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D...
          \u043F\u0430\u043B...\xBB.\n\n\u041E\u043D\u0438 \u043D\u0435 \u0441\u0442\u0430\u043B\u0438
          \u0443\u0431\u0438\u0432\u0430\u0442\u044C \u0431\u044B\u0441\u0442\u0440\u043E.\n\n\u041C\u0430\u0441\u0442\u0435\u0440
          \u0441\u0442\u043E\u044F\u043B, \u0441\u043B\u043E\u0436\u0438\u0432 \u0440\u0443\u043A\u0438,
          \u043F\u043E\u043A\u0430 \u0435\u0433\u043E \u0432\u043E\u0438\u043D\u044B
          \u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u043C\u0435\u043D\u044F.\n\u2014
          \u0422\u044B \u043F\u043E\u0447\u0442\u0438 \u0434\u043E\u0448\u0451\u043B,
          \u2014 \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D. \u2014 \u041F\u043E\u0447\u0442\u0438
          \u0441\u0442\u0430\u043B \u043B\u0435\u0433\u0435\u043D\u0434\u043E\u0439.\n\n\u041F\u043E\u0442\u043E\u043C
          \u0435\u0433\u043E \u043C\u0435\u0447 \u0432\u043E\u0448\u0451\u043B \u043C\u043D\u0435
          \u0432 \u043F\u043B\u0435\u0447\u043E. \u041F\u043E\u0442\u043E\u043C \u0432
          \u0431\u0435\u0434\u0440\u043E. \u041F\u043E\u0442\u043E\u043C \u2014 \u0432
          \u0436\u0438\u0432\u043E\u0442.\n\u041D\u0435 \u0447\u0442\u043E\u0431\u044B
          \u0443\u0431\u0438\u0442\u044C. \u0427\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C.\n\n\u042F
          \u0443\u043F\u0430\u043B \u043D\u0430 \u0431\u0440\u0443\u0441\u0447\u0430\u0442\u043A\u0443,
          \u0433\u043B\u044F\u0434\u044F \u043D\u0430 \u0432\u043E\u0440\u043E\u0442\u0430.
          \u041E\u043D\u0438 \u0442\u0430\u043A \u0438 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u043B\u0438\u0441\u044C.\n\n\u0421\u0432\u0438\u0442\u043E\u043A
          \u0441\u0433\u043E\u0440\u0435\u043B \u0432 \u0435\u0433\u043E \u0440\u0443\u043A\u0435.\n\u0410
          \u044F \u2014 \u0432 \u043F\u0435\u043F\u043B\u0435.\n\n\u041A\u0440\u0435\u043F\u043E\u0441\u0442\u044C
          \u043F\u0430\u043B\u0430 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
          \u0434\u0435\u043D\u044C.\n\u0411\u0435\u0437 \u0431\u043E\u044F.\n\u041F\u043E\u0442\u043E\u043C\u0443
          \u0447\u0442\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u043D\u0451\u0441
          \u043F\u0440\u0430\u0432\u0434\u0443.\n\n\u041D\u043E \u044D\u0442\u043E
          \u2014 \u043D\u0435 \u043C\u043E\u0439 \u043F\u0443\u0442\u044C.\n\u042F
          \u043D\u0435 \u0443\u043C\u0435\u0440 \u0443 \u0432\u0440\u0430\u0442.\n\u042F
          \u0432\u043E\u0448\u0451\u043B.\n\u0418 \u043C\u0438\u0440 \u2014 \u043E\u0441\u0442\u0430\u043B\u0441\u044F."
        _buttonText: "<b>\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430...</b>"
        _backgroundSpriteName: Chapter_5
