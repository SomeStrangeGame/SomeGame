--- !u!114 &1138803519
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1138803518}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9eb5ecca9690646bebb2dec15d969dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _data:
    _loadingData:
      _bundleName: loading
      _loadingPrefabName: Loading.prefab
    _chapter_intro:
      _menu:
        _descriptionText: "<b>\u0413\u043B\u0430\u0432\u0430 0: \u041A\u0442\u043E
          \u044F \u0438 \u0437\u0430\u0447\u0435\u043C \u0438\u0434\u0443</b>\n1-\u0435
          \u0447\u0438\u0441\u043B\u043E, \u043C\u0435\u0441\u044F\u0446 \u0425\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
          \u0416\u0430\u043B\u0430, \u0433\u043E\u0434 \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u043E\u0433\u043E
          \u0417\u0430\u0442\u043C\u0435\u043D\u0438\u044F\n\n<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F:
          \u0420\u0430\u0437\u0432\u0430\u043B\u0438\u043D\u044B \u0444\u043E\u0440\u043F\u043E\u0441\u0442\u0430
          \xAB\u0421\u0435\u0440\u044B\u0439 \u041F\u0438\u043A\xBB</b>\n\u0418\u0437
          \u0430\u0440\u0445\u0438\u0432\u043D\u043E\u0439 \u0437\u0430\u043C\u0435\u0442\u043A\u0438
          \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u044F
          \u0425\u0430\u0432\u0435\u043D\u0430\n\u0411\u044B\u0432\u0448\u0438\u0439
          \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0439 \u0444\u043E\u0440\u043F\u043E\u0441\u0442
          \u043D\u0430 \u044E\u0436\u043D\u043E\u043C \u0441\u043A\u043B\u043E\u043D\u0435
          \u0412\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u0425\u0440\u0435\u0431\u0442\u0430.
          \u0420\u0430\u0437\u0440\u0443\u0448\u0435\u043D \u0432 \u043F\u0435\u0440\u0432\u044B\u0435
          \u0434\u043D\u0438 \u0412\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u044F
          \u0422\u0435\u043D\u0435\u0439, 11 \u043C\u0435\u0441\u044F\u0446\u0435\u0432
          \u043D\u0430\u0437\u0430\u0434. \u0421\u0442\u0435\u043D\u044B \u043E\u0431\u0440\u0443\u0448\u0435\u043D\u044B,
          \u0431\u0430\u0448\u043D\u0438 \u2014 \u043E\u0431\u0443\u0433\u043B\u0435\u043D\u044B,
          \u043A\u043E\u043B\u043E\u0434\u0435\u0446 \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D.
          \u041D\u0430 \u043C\u0435\u0441\u0442\u0435 \u043A\u0430\u0437\u0430\u0440\u043C\u044B
          \u2014 \u043A\u043E\u0441\u0442\u0440\u0438\u0449\u0435 \u0438 \u043E\u0431\u043B\u043E\u043C\u043A\u0438
          \u0437\u043D\u0430\u043C\u0451\u043D. \u0412 \u0444\u043E\u0440\u043F\u043E\u0441\u0442\u0435
          \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0436\u0438\u0432\u0451\u0442.
          \u0418\u043D\u043E\u0433\u0434\u0430 \u0441\u044E\u0434\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
          \u0434\u043E\u0437\u043E\u0440\u043D\u044B\u0435 \u2014 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C,
          \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043B\u0438
          \xAB\u0442\u0435\u043D\u0438\xBB. \u0427\u0430\u0449\u0435 \u2014 \u043D\u0438\u043A\u0442\u043E.
          \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u0440\u043E\u043D\u044B.\n\n\u042F
          \u0441\u0438\u0436\u0443 \u0443 \u0440\u0443\u0438\u043D \u0431\u0430\u0448\u043D\u0438,
          \u0441\u043F\u0438\u043D\u043E\u0439 \u043A \u043E\u0431\u0433\u043E\u0440\u0435\u0432\u0448\u0435\u0439
          \u0431\u0430\u043B\u043A\u0435. \u0412\u0435\u0442\u0435\u0440 \u0433\u043E\u043D\u0438\u0442
          \u043F\u0435\u043F\u0435\u043B \u043F\u043E \u0434\u0432\u043E\u0440\u0443,
          \u043A\u0430\u043A \u043F\u0430\u043C\u044F\u0442\u044C \u043F\u043E \u043F\u0443\u0441\u0442\u043E\u043C\u0443
          \u0434\u043E\u043C\u0443. \u0412\u043E\u043A\u0440\u0443\u0433 \u2014 \u0442\u0438\u0448\u0438\u043D\u0430.
          \u041D\u0438 \u043A\u0440\u0438\u043A\u043E\u0432, \u043D\u0438 \u0448\u0430\u0433\u043E\u0432,
          \u043D\u0438 \u0437\u0432\u043E\u043D\u0430 \u0441\u0442\u0430\u043B\u0438.
          \u0422\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u0440\u0438\u043F \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432
          \u043F\u043E\u0434 \u043F\u043E\u0440\u044B\u0432\u0430\u043C\u0438 \u0432\u0435\u0442\u0440\u0430.\n\n\u041C\u0435\u043D\u044F
          \u0437\u043E\u0432\u0443\u0442 \u041A\u0430\u0439\u0440\u0430\u043D \u0412\u0435\u0439\u043D.\n\u0411\u044B\u0432\u0448\u0438\u0439
          \u0441\u0435\u0440\u0436\u0430\u043D\u0442 7-\u0433\u043E \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u043E\u0433\u043E
          \u043F\u043E\u043B\u043A\u0430. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
          \u0438\u0437 \u043E\u0442\u0440\u044F\u0434\u0430 \xAB\u0421\u0435\u0440\u044B\u0439
          \u041A\u043B\u0438\u043D\u043E\u043A\xBB.\n\n\u042F \u043D\u0435 \u0433\u0435\u0440\u043E\u0439.
          \u041D\u0435 \u043C\u0441\u0442\u0438\u0442\u0435\u043B\u044C. \u041D\u0435
          \u0438\u0441\u043A\u0430\u0442\u0435\u043B\u044C \u0441\u043B\u0430\u0432\u044B.\n\u042F
          \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439, \u043A\u0442\u043E
          \u0437\u043D\u0430\u043B \u043F\u0440\u0430\u0432\u0434\u0443.\n\n\u041D\u0430\u0448
          \u043E\u0442\u0440\u044F\u0434 \u0432\u044B\u0448\u0435\u043B \u043D\u0430
          \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0443 12-\u0433\u043E \u0447\u0438\u0441\u043B\u0430
          \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u043C\u0435\u0441\u044F\u0446\u0430.
          \u041D\u0430\u0448\u043B\u0438 \u043D\u0435 \u043B\u0430\u0433\u0435\u0440\u044C
          \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432 \u2014 \u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B
          \u0432\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u044F. \u0422\u044B\u0441\u044F\u0447\u0438
          \u0432\u043E\u0438\u043D\u043E\u0432. \u041E\u0441\u0430\u0434\u043D\u044B\u0435
          \u043C\u0430\u0448\u0438\u043D\u044B. \u0418\u0445 \u0446\u0435\u043B\u0438
          \u2014 \u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D,
          \u043F\u043E\u0442\u043E\u043C \u0441\u0442\u043E\u043B\u0438\u0446\u0430.
          \u041E\u043D\u0438 \u0438\u0434\u0443\u0442 \u043D\u0435 \u0437\u0430 \u0437\u0435\u043C\u043B\u0451\u0439.
          \u041E\u043D\u0438 \u0438\u0434\u0443\u0442 \u0441\u0442\u0435\u0440\u0435\u0442\u044C
          \u0432\u0441\u0451, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
          \u043E\u0442 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430.\n\n\u041C\u044B
          \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F.\n\u041D\u0430\u0441
          \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u0443
          \u0421\u0435\u0440\u043E\u0433\u043E \u041F\u0438\u043A\u0430.\n\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C
          \u0434\u0432\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \u041E\u0434\u0438\u043D
          \u0432\u044B\u0436\u0438\u043B.\n\n\u041F\u0435\u0440\u0435\u0434 \u0441\u043C\u0435\u0440\u0442\u044C\u044E
          \u043C\u043E\u0439 \u0431\u0440\u0430\u0442 \u2014 \u043B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442
          \u0420\u0435\u0439\u043D\u0441 \u2014 \u0432\u043B\u043E\u0436\u0438\u043B
          \u043C\u043D\u0435 \u0432 \u0440\u0443\u043A\u0443 \u0441\u0432\u0438\u0442\u043E\u043A.\n\u2014
          \u0414\u043E\u043D\u0435\u0441\u0438, \u2014 \u0441\u043A\u0430\u0437\u0430\u043B
          \u043E\u043D. \u2014 \u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
          \u0432\u0435\u0441\u044C \u043C\u0438\u0440 \u0441\u0433\u043E\u0440\u0438\u0442.\n\n\u0421
          \u0442\u0435\u0445 \u043F\u043E\u0440 \u044F \u0438\u0434\u0443.\n\u0411\u0435\u0437
          \u0435\u0434\u044B. \u0411\u0435\u0437 \u0441\u043D\u0430. \u0411\u0435\u0437
          \u0432\u0435\u0440\u044B \u0432 \u0442\u043E, \u0447\u0442\u043E \u043C\u0435\u043D\u044F
          \u0436\u0434\u0443\u0442.\n\n\u041D\u043E \u044F \u0438\u0434\u0443.\n\n\u041F\u043E\u0442\u043E\u043C\u0443
          \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u044F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0441\u044C
          \u2014 \u043F\u0440\u0430\u0432\u0434\u0430 \u0441\u0433\u043E\u0440\u0438\u0442
          \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0430\u043C\u0438.\n\u041F\u043E\u0442\u043E\u043C\u0443
          \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u044F \u0443\u043F\u0430\u0434\u0443
          \u2014 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043A\u0430\u0436\u0435\u0442,
          \u043A\u0442\u043E \u043F\u0440\u0438\u0448\u0451\u043B \u0437\u0430 \u043D\u0430\u043C\u0438
          \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435.\n\n\u042F \u043D\u0435
          \u0441\u0440\u0430\u0436\u0430\u044E\u0441\u044C \u0437\u0430 \u0441\u043B\u0430\u0432\u0443.\n\u042F
          \u043D\u0435 \u0441\u0440\u0430\u0436\u0430\u044E\u0441\u044C \u0437\u0430
          \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435.\n\n\u042F \u0438\u0434\u0443,
          \u0447\u0442\u043E\u0431\u044B \u043A\u0442\u043E-\u0442\u043E \u0437\u043D\u0430\u043B
          \u2014 \u043C\u044B \u043D\u0435 \u0441\u0434\u0430\u043B\u0438\u0441\u044C.\n\u041C\u044B
          \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0430\u043B\u0438 \u2014 \u043E\u0434\u0438\u043D
          \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C,\n\u043F\u043E\u043A\u0430
          \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439.\n\n\u0418
          \u0432\u043E\u0442 \u043E\u043D \u2014 \u044F.\n\n\u0421 \u043C\u0435\u0447\u043E\u043C
          \u0432 \u0440\u0443\u043A\u0435.\n\u0421 \u043F\u0435\u043F\u043B\u043E\u043C
          \u0432 \u0433\u043E\u0440\u043B\u0435.\n\u0421 \u0434\u043E\u043B\u0433\u043E\u043C
          \u0432 \u0441\u0435\u0440\u0434\u0446\u0435.\n\n\u0418 \u044F \u0438\u0434\u0443."
        _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
        _backgroundSpriteName: Chapter_0
      _bundleName: chapter_onlyscreen
      _menuPrefabName: Menu.prefab
    _chapters:
    - _chapterName: Chapter 1
      _menuStart:
        _descriptionText: "<b>\u0413\u043B\u0430\u0432\u0430 I: \u041C\u0435\u0447
          \u0432 \u0442\u0443\u043C\u0430\u043D\u0435</b>\n3-\u0435 \u0447\u0438\u0441\u043B\u043E,
          \u043C\u0435\u0441\u044F\u0446 \u0425\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
          \u0416\u0430\u043B\u0430, \u0433\u043E\u0434 \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u043E\u0433\u043E
          \u0417\u0430\u0442\u043C\u0435\u043D\u0438\u044F\n\n<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F:
          \u0423\u0449\u0435\u043B\u044C\u0435 \u0420\u044B\u0436\u0435\u0433\u043E
          \u0420\u0443\u0447\u044C\u044F</b>\n\u0418\u0437 \xAB\u0421\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u0430
          \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0445 \u0434\u043E\u0437\u043E\u0440\u043E\u0432\xBB,
          \u0442\u043E\u043C IV, \u0441\u0442\u0440. 87\n\u0423\u0437\u043A\u043E\u0435
          \u0443\u0449\u0435\u043B\u044C\u0435, \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u0432\u0448\u0435\u0435\u0441\u044F
          \u043D\u0430 12 \u043C\u0438\u043B\u044C \u043C\u0435\u0436\u0434\u0443
          \u044E\u0436\u043D\u044B\u043C \u043E\u0442\u0440\u043E\u0433\u043E\u043C
          \u0412\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u0425\u0440\u0435\u0431\u0442\u0430
          \u0438 \u0445\u043E\u043B\u043C\u0430\u043C\u0438 \u0427\u0451\u0440\u043D\u043E\u0433\u043E
          \u0412\u0435\u0440\u0435\u0441\u043A\u0430. \u0420\u0443\u0447\u0435\u0439,
          \u0434\u0430\u0432\u0448\u0438\u0439 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
          \u043C\u0435\u0441\u0442\u0443, \u0431\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
          \u0432 \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0445
          \u0440\u0443\u0434\u043D\u0438\u043A\u0430\u0445 \xAB\u0413\u043B\u0430\u0437
          \u0414\u0440\u0430\u043A\u043E\u043D\u0430\xBB \u0438 \u043D\u0435\u0441\u0451\u0442
          \u0432 \u0441\u0435\u0431\u0435 \u0441\u043B\u0435\u0434\u044B \u043E\u043A\u0438\u0441\u043B\u0435\u043D\u043D\u043E\u0433\u043E
          \u0436\u0435\u043B\u0435\u0437\u0430 \u2014 \u043E\u0442\u0441\u044E\u0434\u0430
          \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u0439 \u0431\u0443\u0440\u043E-\u0440\u044B\u0436\u0438\u0439
          \u043E\u0442\u0442\u0435\u043D\u043E\u043A \u0432\u043E\u0434\u044B. \u0411\u0435\u0440\u0435\u0433\u0430
          \u043A\u0440\u0443\u0442\u044B\u0435, \u043C\u0435\u0441\u0442\u0430\u043C\u0438
          \u043E\u0431\u0440\u044B\u0432\u0438\u0441\u0442\u044B\u0435; \u0434\u043D\u043E
          \u0443\u0441\u0435\u044F\u043D\u043E \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u0438\u043C\u0438
          \u0432\u0430\u043B\u0443\u043D\u0430\u043C\u0438 \u0438 \u043A\u043E\u0440\u043D\u044F\u043C\u0438
          \u043F\u043E\u0432\u0430\u043B\u0435\u043D\u043D\u044B\u0445 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432.
          \u0420\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
          \u0441\u043A\u0443\u0434\u043D\u0430\u044F: \u0435\u0436\u0435\u0432\u0438\u043A\u0430,
          \u043C\u043E\u0445, \u0438\u0441\u043A\u0440\u0438\u0432\u043B\u0451\u043D\u043D\u044B\u0435
          \u0431\u0435\u0440\u0451\u0437\u044B \u0438 \u043E\u0441\u0442\u0440\u043E\u0432\u043A\u0438
          \u043C\u0451\u0440\u0442\u0432\u043E\u0439 \u0441\u043E\u0441\u043D\u044B,
          \u0432\u044B\u0436\u0436\u0435\u043D\u043D\u043E\u0439 \u043F\u043E\u0436\u0430\u0440\u0430\u043C\u0438
          \u043F\u0440\u043E\u0448\u043B\u044B\u0445 \u043B\u0435\u0442. \u0422\u0443\u043C\u0430\u043D
          \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0441
          \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0432\u043E\u0434\u044B
          \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043A\u0430\u0442\u0430 \u0438
          \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u0434\u043E \u043F\u043E\u043B\u0443\u0434\u043D\u044F.
          \u041C\u0435\u0441\u0442\u043E \u043D\u0435\u043F\u0440\u0438\u0433\u043E\u0434\u043D\u043E
          \u0434\u043B\u044F \u0441\u0442\u043E\u044F\u043D\u043A\u0438 \u2014 \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0435
          \u0441\u043A\u043B\u043E\u043D\u044B, \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
          \u0447\u0438\u0441\u0442\u043E\u0439 \u0432\u043E\u0434\u044B, \u0447\u0430\u0441\u0442\u044B\u0435
          \u0437\u0430\u0441\u0430\u0434\u044B \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432
          \u0438 \u043A\u0443\u043B\u044C\u0442\u0438\u0441\u0442\u043E\u0432.\n\n\u0422\u0438\u0448\u0438\u043D\u0430
          \u0432 \u0443\u0449\u0435\u043B\u044C\u0435 \u2014 \u043D\u0435 \u043F\u0443\u0441\u0442\u0430\u044F,
          \u0430 \u043D\u0430\u043F\u0440\u044F\u0436\u0451\u043D\u043D\u0430\u044F,
          \u043A\u0430\u043A \u0442\u0435\u0442\u0438\u0432\u0430 \u043F\u0435\u0440\u0435\u0434
          \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u043C. \u042F \u0441\u0442\u043E\u044E
          \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E \u0437\u0430
          \u043F\u043E\u0432\u0430\u043B\u0435\u043D\u043D\u043E\u0439 \u0441\u043E\u0441\u043D\u043E\u0439,
          \u043C\u0435\u0447 \u0432 \u0440\u0443\u043A\u0435, \u0434\u044B\u0445\u0430\u043D\u0438\u0435
          \u043F\u0440\u0438\u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E.
          \u041A\u0442\u043E-\u0442\u043E \u0438\u0434\u0451\u0442 \u0437\u0430 \u043C\u043D\u043E\u0439.
          \u041D\u0435 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
          \u041D\u0435 \u043A\u0440\u0430\u0434\u0451\u0442\u0441\u044F. \u0418\u0434\u0451\u0442
          \u043D\u0430\u0433\u043B\u043E, \u0431\u0443\u0434\u0442\u043E \u0437\u043D\u0430\u0435\u0442,
          \u0447\u0442\u043E \u044F \u043E\u0434\u0438\u043D.\n\n\u0412\u0435\u0442\u0435\u0440
          \u0434\u043E\u043D\u043E\u0441\u0438\u0442 \u0437\u0430\u043F\u0430\u0445
          \u043F\u043E\u0442\u0430, \u0434\u0435\u0448\u0451\u0432\u043E\u0433\u043E
          \u043C\u0430\u0441\u043B\u0430 \u0434\u043B\u044F \u043A\u043E\u0436\u0438
          \u0438 \u0433\u043D\u0438\u043B\u043E\u0433\u043E \u0432\u0438\u043D\u0430.
          \u0417\u043D\u0430\u043A\u043E\u043C\u044B\u0439 \u0431\u0443\u043A\u0435\u0442
          \u2014 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A, \u043F\u0440\u0438\u0432\u044B\u043A\u0448\u0438\u0439
          \u0433\u0440\u0430\u0431\u0438\u0442\u044C \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u0445
          \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432. \u0421\u043A\u043E\u0440\u0435\u0435
          \u0432\u0441\u0435\u0433\u043E, \u0441\u0430\u043C\u043E\u043D\u0430\u0434\u0435\u044F\u043D\u043D\u044B\u0439.
          \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0433\u043B\u0443\u043F\u044B\u0439.\n\n\u041D\u043E
          \u0433\u043B\u0443\u043F\u043E\u0441\u0442\u044C \u0443\u0431\u0438\u0432\u0430\u0435\u0442
          \u0442\u0430\u043A \u0436\u0435 \u0432\u0435\u0440\u043D\u043E, \u043A\u0430\u043A
          \u043A\u043B\u0438\u043D\u043E\u043A.\n\n\u042F \u043D\u0435 \u0445\u043E\u0447\u0443
          \u0434\u0440\u0430\u0442\u044C\u0441\u044F.\n\u041D\u043E \u0433\u043E\u0442\u043E\u0432."
        _buttonText: "<b>\u0412 \u0431\u043E\u0439...</b>"
        _backgroundSpriteName: Chapter_1
      _menuSuccess:
        _descriptionText: "<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F: \u041F\u043B\u0451\u0441
          \u041F\u043E\u0434 \u0417\u0443\u0431\u043E\u043C</b>\n\u0418\u0437 \u043F\u043E\u043B\u0435\u0432\u043E\u0433\u043E
          \u043E\u0442\u0447\u0451\u0442\u0430 \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430
          \u042D\u043B\u0434\u0435\u043D\u0430, 17-\u0439 \u0440\u0430\u0437\u044A\u0435\u0437\u0434\n\u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435
          \u0420\u044B\u0436\u0435\u0433\u043E \u0420\u0443\u0447\u044C\u044F \u0443
          \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0433\u043E \u0438\u0437\u0433\u0438\u0431\u0430
          \u0443\u0449\u0435\u043B\u044C\u044F. \u0412\u043E\u0434\u0430 \u0437\u0434\u0435\u0441\u044C
          \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442\u0441\u044F, \u043E\u0431\u0440\u0430\u0437\u0443\u044F
          \u043F\u043B\u0451\u0441 \u0433\u043B\u0443\u0431\u0438\u043D\u043E\u0439
          \u0434\u043E \u0442\u0440\u0451\u0445 \u043B\u043E\u043A\u0442\u0435\u0439.
          \u0414\u043D\u043E \u2014 \u043F\u043B\u043E\u0441\u043A\u0438\u0435 \u043A\u0430\u043C\u043D\u0438,
          \u043F\u043E\u043A\u0440\u044B\u0442\u044B\u0435 \u0447\u0451\u0440\u043D\u043E\u0439
          \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439 \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u043B\u044C\u044E,
          \u043A\u0440\u0430\u0439\u043D\u0435 \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u0438\u0435.
          \u0423 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u0431\u0435\u0440\u0435\u0433\u0430
          \u2014 \xAB\u0417\u0443\u0431\xBB: \u043E\u0441\u0442\u0440\u044B\u0439
          \u043E\u0431\u043B\u043E\u043C\u043E\u043A \u0431\u0430\u0437\u0430\u043B\u044C\u0442\u043E\u0432\u043E\u0439
          \u0441\u043A\u0430\u043B\u044B \u0432\u044B\u0441\u043E\u0442\u043E\u0439
          \u0432 \u0434\u0432\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445
          \u0440\u043E\u0441\u0442\u0430, \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0438\u0439
          \u0440\u0430\u0437\u0431\u0438\u0442\u044B\u0439 \u043A\u043B\u044B\u043A.
          \u041D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u0439
          \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u2014 \u043E\u0441\u0442\u0430\u0442\u043A\u0438
          \u043A\u043E\u0441\u0442\u0440\u0438\u0449\u0430 \u0438 \u043E\u0431\u043B\u043E\u043C\u043A\u0438
          \u0433\u043B\u0438\u043D\u044F\u043D\u043E\u0439 \u043F\u043E\u0441\u0443\u0434\u044B,
          \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u043E\u0442 \u043E\u0442\u0440\u044F\u0434\u0430
          \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u043E\u0432. \u0412\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C
          \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0430 \u0442\u0443\u043C\u0430\u043D\u043E\u043C
          \u0438 \u043D\u0430\u0432\u0438\u0441\u0430\u044E\u0449\u0438\u043C\u0438
          \u0432\u0435\u0442\u0432\u044F\u043C\u0438. \u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
          \u0434\u043B\u044F \u0437\u0430\u0441\u0430\u0434\u044B \u2014 \u043D\u043E
          \u043D\u0435 \u0434\u043B\u044F \u043F\u043E\u0431\u0435\u0433\u0430.\n\n\u041E\u043D
          \u043C\u0451\u0440\u0442\u0432.\n\n\u041B\u0435\u0436\u0438\u0442 \u0443
          \u043A\u0440\u043E\u043C\u043A\u0438 \u0432\u043E\u0434\u044B, \u043B\u0438\u0446\u043E\u043C
          \u0432\u043D\u0438\u0437, \u0440\u0443\u043A\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451
          \u0441\u0436\u0438\u043C\u0430\u0435\u0442 \u0440\u0443\u043A\u043E\u044F\u0442\u044C
          \u0441\u0432\u043E\u0435\u0433\u043E \u0441\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E
          \u043C\u0435\u0447\u0430. \u041D\u0430 \u043D\u0451\u043C \u043A\u0438\u0440\u0430\u0441\u0430
          \u0438\u0437 \u043F\u0435\u0440\u0435\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0445
          \u043C\u0435\u0434\u043D\u044B\u0445 \u043F\u043B\u0430\u0441\u0442\u0438\u043D
          \u2014 \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043C\u044F\u0442\u0430
          \u0438 \u043F\u044F\u0442\u043D\u0430\u043C\u0438 \u043A\u0440\u043E\u0432\u0438.
          \u0418\u0437-\u043F\u043E\u0434 \u043F\u043B\u0430\u0449\u0430 \u0442\u043E\u0440\u0447\u0438\u0442
          \u043F\u043E\u044F\u0441 \u0441 \u0442\u0440\u043E\u0444\u0435\u044F\u043C\u0438:
          \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0435 \u0431\u0440\u0430\u0441\u043B\u0435\u0442\u044B,
          \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u0430\u044F \u0431\u0443\u043B\u0430\u0432\u043A\u0430,
          \u043E\u0431\u0440\u044B\u0432\u043E\u043A \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u0439
          \u043B\u0435\u043D\u0442\u044B \u2014 \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
          \u0441 \u0447\u044C\u0435\u0439-\u0442\u043E \u0448\u0435\u0438.\n\n\u042F
          \u043E\u0431\u044B\u0441\u043A\u0430\u043B \u0435\u0433\u043E. \u0412 \u0441\u0443\u043C\u043A\u0435
          \u2014 \u0441\u0443\u0445\u043E\u0435 \u043C\u044F\u0441\u043E, \u0444\u043B\u044F\u0433\u0430
          \u0441 \u043A\u0438\u0441\u043B\u044B\u043C \u044D\u043B\u0435\u043C, \u0438
          \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430
          \u0441 \u043F\u043E\u043C\u0435\u0442\u043A\u0430\u043C\u0438 \u043D\u0430
          \u043F\u043E\u043B\u044F\u0445: \xAB\u0441\u043E\u043B\u0434\u0430\u0442,
          \u043E\u0434\u0438\u043D, \u0431\u0435\u0437 \u043A\u043E\u043D\u044F,
          \u0438\u0434\u0451\u0442 \u043D\u0430 \u0441\u0435\u0432\u0435\u0440\xBB.
          \u041A\u0442\u043E-\u0442\u043E \u043F\u043B\u0430\u0442\u0438\u043B \u0437\u0430
          \u044D\u0442\u0443 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E.
          \u041A\u0442\u043E-\u0442\u043E \u0437\u043D\u0430\u043B, \u0447\u0442\u043E
          \u044F \u043F\u0440\u0438\u0434\u0443 \u0441\u044E\u0434\u0430.\n\n\u041C\u043E\u0439
          \u043C\u0435\u0447 \u0447\u0438\u0441\u0442. \u0420\u0443\u043A\u0438 \u2014
          \u043D\u0435\u0442.\n\u041D\u043E \u044F \u0436\u0438\u0432.\n\u0418 \u0441\u0432\u0438\u0442\u043E\u043A
          \u2014 \u0443 \u043C\u0435\u043D\u044F.\n\n\u041F\u043E\u0440\u0430 \u0438\u0434\u0442\u0438.
          \u0422\u0443\u043C\u0430\u043D \u0440\u0435\u0434\u0435\u0435\u0442. \u0410
          \u0432\u0440\u0430\u0433\u0438 \u2014 \u043D\u0435 \u0434\u0440\u0435\u043C\u043B\u044E\u0442."
        _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
        _backgroundSpriteName: Chapter_1
      _menuFailed:
        _descriptionText: "<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F: \u041A\u0430\u043C\u0435\u043D\u044C
          \u041F\u043B\u0430\u0447\u0443\u0449\u0435\u0439 \u0412\u0434\u043E\u0432\u044B</b>\n\u0418\u0437
          \u043B\u0435\u0433\u0435\u043D\u0434 \u043C\u0435\u0441\u0442\u043D\u044B\u0445
          \u043F\u0430\u0441\u0442\u0443\u0445\u043E\u0432, \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E
          \u0434\u043E\u0437\u043E\u0440\u043D\u044B\u043C \u041A\u0430\u043B\u043B\u0435\u043D\u043E\u043C\n\u041E\u0433\u0440\u043E\u043C\u043D\u044B\u0439
          \u0433\u0440\u0430\u043D\u0438\u0442\u043D\u044B\u0439 \u0432\u0430\u043B\u0443\u043D
          \u0432 \u043C\u0435\u0441\u0442\u0435, \u0433\u0434\u0435 \u0420\u044B\u0436\u0438\u0439
          \u0420\u0443\u0447\u0435\u0439 \u0440\u0430\u0437\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
          \u0415\u0433\u043E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
          \u0438\u0441\u043F\u0435\u0449\u0440\u0435\u043D\u0430 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438
          \u0431\u043E\u0440\u043E\u0437\u0434\u0430\u043C\u0438, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u044B\u043C
          \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u0436\u0434\u044F \u0441\u0442\u0435\u043A\u0430\u0435\u0442
          \u0432\u043E\u0434\u0430, \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u044F
          \u0438\u043B\u043B\u044E\u0437\u0438\u044E \u0441\u043B\u0451\u0437. \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E
          \u043F\u0440\u0435\u0434\u0430\u043D\u0438\u044E, \u0437\u0434\u0435\u0441\u044C
          \u043F\u043E\u0433\u0438\u0431 \u043F\u043E\u043B\u043A\u043E\u0432\u043E\u0434\u0435\u0446
          \u041B\u0438\u0440\u0435\u043D, \u0437\u0430\u0449\u0438\u0449\u0430\u044F
          \u043E\u0442\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435 \u0441\u0432\u043E\u0435\u0439
          \u0430\u0440\u043C\u0438\u0438. \u041A\u0430\u043C\u0435\u043D\u044C \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
          \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u043C: \u0442\u0435, \u043A\u0442\u043E
          \u0443\u043C\u0438\u0440\u0430\u0435\u0442 \u0440\u044F\u0434\u043E\u043C
          \u0441 \u043D\u0438\u043C, \u043D\u0435 \u043D\u0430\u0445\u043E\u0434\u044F\u0442
          \u043F\u043E\u043A\u043E\u044F. \u0422\u0443\u043C\u0430\u043D \u0437\u0434\u0435\u0441\u044C
          \u0433\u0443\u0449\u0435, \u0447\u0435\u043C \u0432 \u0434\u0440\u0443\u0433\u0438\u0445
          \u0447\u0430\u0441\u0442\u044F\u0445 \u0443\u0449\u0435\u043B\u044C\u044F,
          \u0430 \u0437\u0432\u0443\u043A \u0448\u0430\u0433\u043E\u0432 \u0438\u0441\u043A\u0430\u0436\u0430\u0435\u0442\u0441\u044F
          \u2014 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0431\u0443\u0434\u0442\u043E
          \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0438\u0434\u0451\u0442
          \u043A\u0442\u043E-\u0442\u043E \u0435\u0449\u0451.\n\n\u041C\u043E\u0439
          \u043C\u0435\u0447 \u043B\u0435\u0436\u0438\u0442 \u0432 \u0440\u0443\u0447\u044C\u0435.
          \u042F \u2014 \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u041A\u0430\u043C\u043D\u044F,
          \u043B\u0438\u0446\u043E\u043C \u043A \u043D\u0435\u0431\u0443. \u041A\u0440\u043E\u0432\u044C
          \u0441\u0442\u0435\u043A\u0430\u0435\u0442 \u043F\u043E \u043A\u0430\u043C\u043D\u044F\u043C,
          \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u044F\u0441\u044C \u0441 \u0440\u0436\u0430\u0432\u043E\u0439
          \u0432\u043E\u0434\u043E\u0439.\n\n\u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A
          \u0441\u0442\u043E\u0438\u0442 \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439,
          \u0442\u044F\u0436\u0435\u043B\u043E \u0434\u044B\u0448\u0430, \u0441 \u043F\u0435\u0440\u0435\u043A\u043E\u0448\u0435\u043D\u043D\u043E\u0439
          \u0443\u0445\u043C\u044B\u043B\u043A\u043E\u0439.\n\u2014 \u0414\u0443\u043C\u0430\u043B,
          \u0441\u043E\u043B\u0434\u0430\u0442 \u2014 \u044D\u0442\u043E \u0447\u0442\u043E-\u0442\u043E,
          \u2014 \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u043E\u043D, \u0432\u044B\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u044F
          \u0441\u0432\u0438\u0442\u043E\u043A \u0438\u0437 \u043C\u043E\u0435\u0439
          \u043A\u0443\u0440\u0442\u043A\u0438. \u2014 \u0410 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
          \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u043C
          \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u043C.\n\n\u041E\u043D \u043F\u043B\u044E\u0451\u0442
          \u043C\u043D\u0435 \u043D\u0430 \u0433\u0440\u0443\u0434\u044C \u0438 \u0443\u0445\u043E\u0434\u0438\u0442.\n\n\u042F
          \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0431\u043E\u043B\u0438.
          \u0422\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u043B\u043E\u0434.\n\u0421\u0432\u0438\u0442\u043E\u043A
          \u0443\u0442\u0435\u0440\u044F\u043D.\n\u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
          \u043E\u0431\u0440\u0435\u0447\u0451\u043D.\n\n\u0418 \u043D\u0438\u043A\u0442\u043E
          \u043D\u0435 \u0443\u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E \u044F
          \u0434\u043E\u0448\u0451\u043B \u0442\u0430\u043A \u0434\u0430\u043B\u0435\u043A\u043E.\n\n\u041D\u043E
          \u044D\u0442\u043E \u2014 \u043D\u0435 \u043C\u043E\u0439 \u043F\u0443\u0442\u044C.\n\u042F
          \u043D\u0435 \u0443\u043C\u0438\u0440\u0430\u043B \u0443 \u041A\u0430\u043C\u043D\u044F.\n\u042F
          \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0436\u0438\u0432 \u2014 \u043F\u043E\u0442\u043E\u043C\u0443
          \u0447\u0442\u043E \u0432 \u044D\u0442\u043E\u043C \u043C\u0438\u0440\u0435
          \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u043D\u0435 \u0442\u043E\u0442,
          \u043A\u0442\u043E \u043A\u0440\u0438\u0447\u0438\u0442 \u0433\u0440\u043E\u043C\u0447\u0435,
          \u0430 \u0442\u043E\u0442, \u043A\u0442\u043E \u0443\u043C\u0435\u0435\u0442
          \u043C\u043E\u043B\u0447\u0430\u0442\u044C... \u0438 \u0436\u0434\u0430\u0442\u044C.\n\u0418
          \u044F \u0432\u0441\u0451 \u0435\u0449\u0451 \u0438\u0434\u0443."
        _buttonText: "<b>\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430...</b>"
        _backgroundSpriteName: Chapter_1
      _menuBundleName: chapter_onlyscreen
