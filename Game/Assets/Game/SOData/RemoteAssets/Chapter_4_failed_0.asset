  _backgroundBundle:
    _bundleName: chapter_onlyscreen_chapter_4
    _assetName: Chapter_4
  _buttonText: "<b>\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430...</b>"
  _descriptionText: "<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F: \u0422\u0440\u044F\u0441\u0438\u043D\u0430
    \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u0413\u0440\u0435\u0431\u043D\u044F</b>\n\u0418\u0437
    \u0443\u0441\u0442\u043D\u043E\u0439 \u043B\u0435\u0433\u0435\u043D\u0434\u044B
    \u0431\u043E\u043B\u043E\u0442\u043D\u044B\u0445 \u0435\u0433\u0435\u0440\u0435\u0439\n\u041C\u0435\u0441\u0442\u043E,
    \u0433\u0434\u0435 \u0431\u043E\u043B\u043E\u0442\u043E \xAB\u0434\u044B\u0448\u0438\u0442\xBB
    \u2014 \u043F\u0443\u0437\u044B\u0440\u0438 \u0433\u0430\u0437\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F
    \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u0434\u0430\u0436\u0435 \u0432 \u043C\u043E\u0440\u043E\u0437. \u0417\u0434\u0435\u0441\u044C
    \u0432\u043E\u0434\u0430 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u0430,
    \u0430 \u0434\u043D\u043E \u2014 \u0441\u043F\u043B\u043E\u0448\u043D\u0430\u044F
    \u0433\u043D\u0438\u044E\u0449\u0430\u044F \u043C\u0430\u0441\u0441\u0430. \u0422\u0435,
    \u043A\u0442\u043E \u043F\u0430\u0434\u0430\u0435\u0442 \u0441\u044E\u0434\u0430,
    \u043D\u0435 \u0442\u043E\u043D\u0443\u0442 \u0441\u0440\u0430\u0437\u0443. \u0418\u0445
    \u0437\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
    \u043D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445 \u0443 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445.
    \u0415\u0433\u0435\u0440\u044F \u0433\u043E\u0432\u043E\u0440\u044F\u0442: \u044D\u0442\u043E
    \u0431\u043E\u043B\u043E\u0442\u043E \u043A\u043E\u0440\u043C\u0438\u0442\u0441\u044F
    \u0441\u0442\u0440\u0430\u0445\u043E\u043C.\n\n\u042F \u043D\u0435 \u0443\u043F\u0430\u043B.\n\u041C\u0435\u043D\u044F
    \u0431\u0440\u043E\u0441\u0438\u043B\u0438.\n\n\u041E\u043D \u0441\u0442\u043E\u044F\u043B
    \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439, \u0434\u0435\u0440\u0436\u0430
    \u043C\u043E\u0439 \u043C\u0435\u0447 \u0437\u0430 \u043E\u0441\u0442\u0440\u0438\u0435,
    \u043A\u0430\u043A \u043F\u043E\u0441\u043E\u0445.\n\u2014 \u0416\u0430\u043B\u044C,
    \u2014 \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D. \u2014 \u0422\u044B
    \u0431\u044B\u043B \u0445\u043E\u0440\u043E\u0448. \u041D\u043E \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0430
    \u2014 \u043F\u043B\u043E\u0445\u043E\u0439 \u0441\u043E\u044E\u0437\u043D\u0438\u043A
    \u0432 \u0431\u043E\u044E.\n\n\u041E\u043D \u043D\u0435 \u0441\u0442\u0430\u043B
    \u0440\u0435\u0437\u0430\u0442\u044C. \u041F\u0440\u043E\u0441\u0442\u043E \u0442\u043E\u043B\u043A\u043D\u0443\u043B.\n\n\u042F
    \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F \u0432 \u0447\u0451\u0440\u043D\u0443\u044E
    \u0436\u0438\u0436\u0443. \u041E\u043D\u0430 \u043E\u0431\u043D\u044F\u043B\u0430
    \u043C\u0435\u043D\u044F, \u043A\u0430\u043A \u043C\u0430\u0442\u044C, \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0449\u0430\u044F
    \u0441\u044B\u043D\u0430 \u0434\u043E\u043C\u043E\u0439.\n\n\u0421\u0432\u0438\u0442\u043E\u043A
    \u0443\u0448\u0451\u043B \u043F\u043E\u0434 \u0432\u043E\u0434\u0443 \u043F\u0435\u0440\u0432\u044B\u043C.\n\u041F\u043E\u0442\u043E\u043C
    \u2014 \u044F.\n\n\u0411\u043E\u043B\u043E\u0442\u043E \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u043E
    \u0441\u043B\u0435\u0434\u043E\u0432.\n\u041A\u0430\u043A \u0438 \u0432\u0441\u0435\u0445
    \u0434\u043E \u043C\u0435\u043D\u044F.\n\n\u041D\u043E \u044D\u0442\u043E \u2014
    \u043D\u0435 \u043C\u043E\u0439 \u043F\u0443\u0442\u044C.\n\u042F \u043D\u0435
    \u0443\u0442\u043E\u043D\u0443\u043B \u0432 \u0442\u0440\u044F\u0441\u0438\u043D\u0435.\n\u042F
    \u043F\u043E\u0431\u0435\u0434\u0438\u043B \u0443\u0431\u0438\u0439\u0446\u0443
    \u2014 \u043D\u0435 \u0441\u0438\u043B\u043E\u0439, \u0430 \u0442\u0435\u043C,
    \u0447\u0442\u043E \u0434\u0430\u0436\u0435 \u0432 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0435
    \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B \u043C\u0435\u0447.\n\u0418
    \u044F \u0432\u0441\u0451 \u0435\u0449\u0451 \u0438\u0434\u0443."
