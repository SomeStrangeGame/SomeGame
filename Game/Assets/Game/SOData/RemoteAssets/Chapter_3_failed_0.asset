    _bundleName: chapter_onlyscreen_chapter_3
    _assetName: Chapter_3
  _content:
    _buttonText: "<b>\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430...</b>"
    _descriptionText: "\u042F \u043B\u0435\u0436\u0443 \u0441\u0440\u0435\u0434\u0438
      \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432, \u043F\u0440\u0438\u0436\u0430\u0442\u044B\u0439
      \u043A \u0437\u0435\u043C\u043B\u0435. \u041E\u0434\u0438\u043D \u0438\u0437
      \u043D\u0438\u0445 \u0441\u0438\u0434\u0438\u0442 \u043D\u0430 \u043C\u043E\u0435\u0439
      \u0433\u0440\u0443\u0434\u0438, \u0434\u0440\u0443\u0433\u043E\u0439 \u2014
      \u0434\u0435\u0440\u0436\u0438\u0442 \u043C\u043E\u0439 \u043C\u0435\u0447
      \u0437\u0430 \u043A\u043B\u0438\u043D\u043E\u043A, \u043A\u0430\u043A \u0434\u0443\u0431\u0438\u043D\u0443.\n\n\u2014
      \u0414\u0443\u043C\u0430\u043B, \u043E\u0434\u0438\u043D \u2014 \u0437\u043D\u0430\u0447\u0438\u0442
      \u0441\u0438\u043B\u044C\u043D\u044B\u0439? \u2014 \u0445\u0440\u0438\u043F\u0438\u0442
      \u043F\u0435\u0440\u0432\u044B\u0439, \u043F\u0430\u0445\u043D\u0443\u0449\u0438\u0439
      \u043B\u0443\u043A\u043E\u043C \u0438 \u043F\u043E\u0442\u043E\u043C. \u2014
      \u0410 \u043C\u044B \u2014 \u0434\u0432\u043E\u0435. \u0418 \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0435.\n\n\u041E\u043D\u0438
      \u043D\u0435 \u0443\u0431\u0438\u0432\u0430\u044E\u0442 \u0431\u044B\u0441\u0442\u0440\u043E.
      \u041E\u043D\u0438 \u0438\u0433\u0440\u0430\u044E\u0442.\n\n\u041C\u0435\u0447
      \u043F\u0430\u0434\u0430\u0435\u0442 \u0438\u0437 \u043C\u043E\u0438\u0445
      \u043F\u0430\u043B\u044C\u0446\u0435\u0432. \u0421\u0432\u0438\u0442\u043E\u043A
      \u0432\u044B\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u044E\u0442 \u0438\u0437-\u0437\u0430
      \u043F\u0430\u0437\u0443\u0445\u0438. \u041E\u0434\u0438\u043D \u0440\u0432\u0451\u0442
      \u0435\u0433\u043E \u043F\u043E\u043F\u043E\u043B\u0430\u043C \u2014 \u0441\u043C\u0435\u0451\u0442\u0441\u044F,
      \u043A\u0430\u043A \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430.\n\n\u042F
      \u043D\u0435 \u043A\u0440\u0438\u0447\u0443.\n\u041D\u0435 \u043F\u0440\u043E\u0448\u0443
      \u043F\u043E\u0449\u0430\u0434\u044B.\n\n\u041F\u0440\u043E\u0441\u0442\u043E
      \u0441\u043C\u043E\u0442\u0440\u044E, \u043A\u0430\u043A \u043F\u0435\u043F\u0435\u043B
      \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u043C\u043E\u0438
      \u0433\u043B\u0430\u0437\u0430.\n\n\u041E\u043D\u0438 \u0443\u0439\u0434\u0443\u0442.
      \u041F\u0440\u043E\u0434\u0430\u0434\u0443\u0442 \u043E\u0431\u0440\u044B\u0432\u043A\u0438
      \u0441\u0432\u0438\u0442\u043A\u0430 \u0437\u0430 \u043C\u0435\u0448\u043E\u043A
      \u0437\u0435\u0440\u043D\u0430.\n\u0410 \u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
      \u043F\u0430\u0434\u0451\u0442.\n\n\u0418 \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0443\u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E \u044F \u0431\u044B\u043B
      \u0442\u0430\u043A \u0431\u043B\u0438\u0437\u043A\u043E.\n\n\u041D\u043E \u044D\u0442\u043E
      \u2014 \u043D\u0435 \u043C\u043E\u0439 \u043F\u0443\u0442\u044C.\n\u042F \u043D\u0435
      \u043F\u0430\u043B \u043F\u043E\u0434 \u0432\u0435\u0441\u043E\u043C \u0434\u0432\u043E\u0438\u0445
      \u0433\u043B\u0443\u043F\u0446\u043E\u0432.\n\u042F \u0432\u044B\u0436\u0438\u043B
      \u2014 \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432 \u0431\u043E\u044E
      \u043D\u0435 \u0447\u0438\u0441\u043B\u043E \u0440\u0435\u0448\u0430\u0435\u0442
      \u0438\u0441\u0445\u043E\u0434, \u0430 \u0442\u043E, \u0437\u0430 \u0447\u0442\u043E
      \u0442\u044B \u0433\u043E\u0442\u043E\u0432 \u0443\u043C\u0435\u0440\u0435\u0442\u044C.\n\u0418
      \u044F \u0432\u0441\u0451 \u0435\u0449\u0451 \u0438\u0434\u0443."
  _buttonText: "<b>\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430...</b>"
  _descriptionText: "\u042F \u043B\u0435\u0436\u0443 \u0441\u0440\u0435\u0434\u0438
    \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432, \u043F\u0440\u0438\u0436\u0430\u0442\u044B\u0439
    \u043A \u0437\u0435\u043C\u043B\u0435. \u041E\u0434\u0438\u043D \u0438\u0437
    \u043D\u0438\u0445 \u0441\u0438\u0434\u0438\u0442 \u043D\u0430 \u043C\u043E\u0435\u0439
    \u0433\u0440\u0443\u0434\u0438, \u0434\u0440\u0443\u0433\u043E\u0439 \u2014 \u0434\u0435\u0440\u0436\u0438\u0442
    \u043C\u043E\u0439 \u043C\u0435\u0447 \u0437\u0430 \u043A\u043B\u0438\u043D\u043E\u043A,
    \u043A\u0430\u043A \u0434\u0443\u0431\u0438\u043D\u0443.\n\n\u2014 \u0414\u0443\u043C\u0430\u043B,
    \u043E\u0434\u0438\u043D \u2014 \u0437\u043D\u0430\u0447\u0438\u0442 \u0441\u0438\u043B\u044C\u043D\u044B\u0439?
    \u2014 \u0445\u0440\u0438\u043F\u0438\u0442 \u043F\u0435\u0440\u0432\u044B\u0439,
    \u043F\u0430\u0445\u043D\u0443\u0449\u0438\u0439 \u043B\u0443\u043A\u043E\u043C
    \u0438 \u043F\u043E\u0442\u043E\u043C. \u2014 \u0410 \u043C\u044B \u2014 \u0434\u0432\u043E\u0435.
    \u0418 \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0435.\n\n\u041E\u043D\u0438
    \u043D\u0435 \u0443\u0431\u0438\u0432\u0430\u044E\u0442 \u0431\u044B\u0441\u0442\u0440\u043E.
    \u041E\u043D\u0438 \u0438\u0433\u0440\u0430\u044E\u0442.\n\n\u041C\u0435\u0447
    \u043F\u0430\u0434\u0430\u0435\u0442 \u0438\u0437 \u043C\u043E\u0438\u0445 \u043F\u0430\u043B\u044C\u0446\u0435\u0432.
    \u0421\u0432\u0438\u0442\u043E\u043A \u0432\u044B\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u044E\u0442
    \u0438\u0437-\u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0438. \u041E\u0434\u0438\u043D
    \u0440\u0432\u0451\u0442 \u0435\u0433\u043E \u043F\u043E\u043F\u043E\u043B\u0430\u043C
    \u2014 \u0441\u043C\u0435\u0451\u0442\u0441\u044F, \u043A\u0430\u043A \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430.\n\n\u042F
    \u043D\u0435 \u043A\u0440\u0438\u0447\u0443.\n\u041D\u0435 \u043F\u0440\u043E\u0448\u0443
    \u043F\u043E\u0449\u0430\u0434\u044B.\n\n\u041F\u0440\u043E\u0441\u0442\u043E
    \u0441\u043C\u043E\u0442\u0440\u044E, \u043A\u0430\u043A \u043F\u0435\u043F\u0435\u043B
    \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u043C\u043E\u0438
    \u0433\u043B\u0430\u0437\u0430.\n\n\u041E\u043D\u0438 \u0443\u0439\u0434\u0443\u0442.
    \u041F\u0440\u043E\u0434\u0430\u0434\u0443\u0442 \u043E\u0431\u0440\u044B\u0432\u043A\u0438
    \u0441\u0432\u0438\u0442\u043A\u0430 \u0437\u0430 \u043C\u0435\u0448\u043E\u043A
    \u0437\u0435\u0440\u043D\u0430.\n\u0410 \u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
    \u043F\u0430\u0434\u0451\u0442.\n\n\u0418 \u043D\u0438\u043A\u0442\u043E \u043D\u0435
    \u0443\u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E \u044F \u0431\u044B\u043B
    \u0442\u0430\u043A \u0431\u043B\u0438\u0437\u043A\u043E.\n\n\u041D\u043E \u044D\u0442\u043E
    \u2014 \u043D\u0435 \u043C\u043E\u0439 \u043F\u0443\u0442\u044C.\n\u042F \u043D\u0435
    \u043F\u0430\u043B \u043F\u043E\u0434 \u0432\u0435\u0441\u043E\u043C \u0434\u0432\u043E\u0438\u0445
    \u0433\u043B\u0443\u043F\u0446\u043E\u0432.\n\u042F \u0432\u044B\u0436\u0438\u043B
    \u2014 \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432 \u0431\u043E\u044E
    \u043D\u0435 \u0447\u0438\u0441\u043B\u043E \u0440\u0435\u0448\u0430\u0435\u0442
    \u0438\u0441\u0445\u043E\u0434, \u0430 \u0442\u043E, \u0437\u0430 \u0447\u0442\u043E
    \u0442\u044B \u0433\u043E\u0442\u043E\u0432 \u0443\u043C\u0435\u0440\u0435\u0442\u044C.\n\u0418
    \u044F \u0432\u0441\u0451 \u0435\u0449\u0451 \u0438\u0434\u0443."
