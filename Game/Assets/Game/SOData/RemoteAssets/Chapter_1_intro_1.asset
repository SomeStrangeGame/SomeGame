    _assetName: Chapter_1_Intro
  _content:
    _buttonText: "<b>\u0434\u0430\u043B\u0435\u0435...</b>"
    _descriptionText: "\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u041A\u0430\u0439\u0440\u0430\u043D
      \u0412\u0435\u0439\u043D.\n\u0411\u044B\u0432\u0448\u0438\u0439 \u0441\u0435\u0440\u0436\u0430\u043D\u0442
      7-\u0433\u043E \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u043E\u0433\u043E
      \u043F\u043E\u043B\u043A\u0430. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0438\u0437 \u043E\u0442\u0440\u044F\u0434\u0430 \xAB\u0421\u0435\u0440\u044B\u0439
      \u041A\u043B\u0438\u043D\u043E\u043A\xBB.\n\n\u042F \u043D\u0435 \u0433\u0435\u0440\u043E\u0439.
      \u041D\u0435 \u043C\u0441\u0442\u0438\u0442\u0435\u043B\u044C. \u041D\u0435
      \u0438\u0441\u043A\u0430\u0442\u0435\u043B\u044C \u0441\u043B\u0430\u0432\u044B.\n\u042F
      \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439, \u043A\u0442\u043E
      \u0437\u043D\u0430\u043B \u043F\u0440\u0430\u0432\u0434\u0443.\n\n\u041D\u0430\u0448
      \u043E\u0442\u0440\u044F\u0434 \u0432\u044B\u0448\u0435\u043B \u043D\u0430
      \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0443 12-\u0433\u043E \u0447\u0438\u0441\u043B\u0430
      \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E \u043C\u0435\u0441\u044F\u0446\u0430.
      \u041D\u0430\u0448\u043B\u0438 \u043D\u0435 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432 \u2014 \u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B
      \u0432\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u044F. \u0422\u044B\u0441\u044F\u0447\u0438
      \u0432\u043E\u0438\u043D\u043E\u0432. \u041E\u0441\u0430\u0434\u043D\u044B\u0435
      \u043C\u0430\u0448\u0438\u043D\u044B. \u0418\u0445 \u0446\u0435\u043B\u0438
      \u2014 \u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D,
      \u043F\u043E\u0442\u043E\u043C \u0441\u0442\u043E\u043B\u0438\u0446\u0430.
      \u041E\u043D\u0438 \u0438\u0434\u0443\u0442 \u043D\u0435 \u0437\u0430 \u0437\u0435\u043C\u043B\u0451\u0439.
      \u041E\u043D\u0438 \u0438\u0434\u0443\u0442 \u0441\u0442\u0435\u0440\u0435\u0442\u044C
      \u0432\u0441\u0451, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u043E\u0442 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430.\n\n\u041C\u044B
      \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F.\n\u041D\u0430\u0441
      \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u0443 \u0421\u0435\u0440\u043E\u0433\u043E
      \u041F\u0438\u043A\u0430.\n\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u0434\u0432\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \u041E\u0434\u0438\u043D
      \u0432\u044B\u0436\u0438\u043B.\n\n\u041F\u0435\u0440\u0435\u0434 \u0441\u043C\u0435\u0440\u0442\u044C\u044E
      \u043C\u043E\u0439 \u0431\u0440\u0430\u0442 \u2014 \u043B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442
      \u0420\u0435\u0439\u043D\u0441 \u2014 \u0432\u043B\u043E\u0436\u0438\u043B
      \u043C\u043D\u0435 \u0432 \u0440\u0443\u043A\u0443 \u0441\u0432\u0438\u0442\u043E\u043A.\n\u2014
      \u0414\u043E\u043D\u0435\u0441\u0438, \u2014 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043E\u043D. \u2014 \u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0432\u0435\u0441\u044C
      \u043C\u0438\u0440 \u0441\u0433\u043E\u0440\u0438\u0442.\n\n\u0421 \u0442\u0435\u0445
      \u043F\u043E\u0440 \u044F \u0438\u0434\u0443.\n\u0411\u0435\u0437 \u0435\u0434\u044B.
      \u0411\u0435\u0437 \u0441\u043D\u0430. \u0411\u0435\u0437 \u0432\u0435\u0440\u044B
      \u0432 \u0442\u043E, \u0447\u0442\u043E \u043C\u0435\u043D\u044F \u0436\u0434\u0443\u0442."
  _buttonText: "<b>\u0434\u0430\u043B\u0435\u0435...</b>"
  _descriptionText: "\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u041A\u0430\u0439\u0440\u0430\u043D
    \u0412\u0435\u0439\u043D.\n\u0411\u044B\u0432\u0448\u0438\u0439 \u0441\u0435\u0440\u0436\u0430\u043D\u0442
    7-\u0433\u043E \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u043E\u0433\u043E
    \u043F\u043E\u043B\u043A\u0430. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u0438\u0437 \u043E\u0442\u0440\u044F\u0434\u0430 \xAB\u0421\u0435\u0440\u044B\u0439
    \u041A\u043B\u0438\u043D\u043E\u043A\xBB.\n\n\u042F \u043D\u0435 \u0433\u0435\u0440\u043E\u0439.
    \u041D\u0435 \u043C\u0441\u0442\u0438\u0442\u0435\u043B\u044C. \u041D\u0435 \u0438\u0441\u043A\u0430\u0442\u0435\u043B\u044C
    \u0441\u043B\u0430\u0432\u044B.\n\u042F \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439,
    \u043A\u0442\u043E \u0437\u043D\u0430\u043B \u043F\u0440\u0430\u0432\u0434\u0443.\n\n\u041D\u0430\u0448
    \u043E\u0442\u0440\u044F\u0434 \u0432\u044B\u0448\u0435\u043B \u043D\u0430 \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0443
    12-\u0433\u043E \u0447\u0438\u0441\u043B\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E
    \u043C\u0435\u0441\u044F\u0446\u0430. \u041D\u0430\u0448\u043B\u0438 \u043D\u0435
    \u043B\u0430\u0433\u0435\u0440\u044C \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432
    \u2014 \u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B \u0432\u0442\u043E\u0440\u0436\u0435\u043D\u0438\u044F.
    \u0422\u044B\u0441\u044F\u0447\u0438 \u0432\u043E\u0438\u043D\u043E\u0432. \u041E\u0441\u0430\u0434\u043D\u044B\u0435
    \u043C\u0430\u0448\u0438\u043D\u044B. \u0418\u0445 \u0446\u0435\u043B\u0438 \u2014
    \u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D, \u043F\u043E\u0442\u043E\u043C
    \u0441\u0442\u043E\u043B\u0438\u0446\u0430. \u041E\u043D\u0438 \u0438\u0434\u0443\u0442
    \u043D\u0435 \u0437\u0430 \u0437\u0435\u043C\u043B\u0451\u0439. \u041E\u043D\u0438
    \u0438\u0434\u0443\u0442 \u0441\u0442\u0435\u0440\u0435\u0442\u044C \u0432\u0441\u0451,
    \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043E\u0442
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430.\n\n\u041C\u044B
    \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F.\n\u041D\u0430\u0441
    \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u0443 \u0421\u0435\u0440\u043E\u0433\u043E
    \u041F\u0438\u043A\u0430.\n\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0432\u0430
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \u041E\u0434\u0438\u043D \u0432\u044B\u0436\u0438\u043B.\n\n\u041F\u0435\u0440\u0435\u0434
    \u0441\u043C\u0435\u0440\u0442\u044C\u044E \u043C\u043E\u0439 \u0431\u0440\u0430\u0442
    \u2014 \u043B\u0435\u0439\u0442\u0435\u043D\u0430\u043D\u0442 \u0420\u0435\u0439\u043D\u0441
    \u2014 \u0432\u043B\u043E\u0436\u0438\u043B \u043C\u043D\u0435 \u0432 \u0440\u0443\u043A\u0443
    \u0441\u0432\u0438\u0442\u043E\u043A.\n\u2014 \u0414\u043E\u043D\u0435\u0441\u0438,
    \u2014 \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D. \u2014 \u0414\u0430\u0436\u0435
    \u0435\u0441\u043B\u0438 \u0432\u0435\u0441\u044C \u043C\u0438\u0440 \u0441\u0433\u043E\u0440\u0438\u0442.\n\n\u0421
    \u0442\u0435\u0445 \u043F\u043E\u0440 \u044F \u0438\u0434\u0443.\n\u0411\u0435\u0437
    \u0435\u0434\u044B. \u0411\u0435\u0437 \u0441\u043D\u0430. \u0411\u0435\u0437
    \u0432\u0435\u0440\u044B \u0432 \u0442\u043E, \u0447\u0442\u043E \u043C\u0435\u043D\u044F
    \u0436\u0434\u0443\u0442."
