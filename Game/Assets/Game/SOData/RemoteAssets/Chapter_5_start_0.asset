    _bundleName: chapter_onlyscreen_chapter_5
    _assetName: Chapter_5
  _buttonText: "<b>\u0412 \u0431\u043E\u0439...</b>"
  _descriptionText: "<b>\u0413\u043B\u0430\u0432\u0430 V: \u0412\u0440\u0430\u0442\u0430
    \u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D\u0430</b>\n13-\u0435
    \u0447\u0438\u0441\u043B\u043E, \u043C\u0435\u0441\u044F\u0446 \u0425\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
    \u0416\u0430\u043B\u0430, \u0433\u043E\u0434 \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0417\u0430\u0442\u043C\u0435\u043D\u0438\u044F\n\n<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F:
    \u0412\u044A\u0435\u0437\u0434 \u0432 \u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
    \u2014 \xAB\u0414\u043E\u0440\u043E\u0433\u0430 \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
    \u0414\u044B\u0445\u0430\u043D\u0438\u044F\xBB</b>\n\u0418\u0437 \u0432\u043E\u0435\u043D\u043D\u043E-\u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u0433\u043E
    \u043E\u0442\u0447\u0451\u0442\u0430 \u0433\u0435\u043D\u0435\u0440\u0430\u043B\u0430
    \u0422\u043E\u0440\u0435\u043D\u0430\n\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u043F\u043E\u0434\u044A\u0451\u043C \u043A \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438:
    \u043A\u0440\u0443\u0442\u0430\u044F \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
    \u0434\u043E\u0440\u043E\u0433\u0430, \u0432\u044B\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F
    \u0431\u0443\u043B\u044B\u0436\u043D\u0438\u043A\u043E\u043C \u044D\u043F\u043E\u0445\u0438
    \u0421\u0442\u0430\u0440\u043E\u0433\u043E \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0430.
    \u0414\u043B\u0438\u043D\u0430 \u2014 300 \u0448\u0430\u0433\u043E\u0432. \u0428\u0438\u0440\u0438\u043D\u0430
    \u2014 \u043D\u0430 \u0434\u0432\u0443\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
    \u0421\u043F\u0440\u0430\u0432\u0430 \u2014 \u043E\u0431\u0440\u044B\u0432, \u0441\u043B\u0435\u0432\u0430
    \u2014 \u0441\u0442\u0435\u043D\u0430 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438,
    \u0432\u044B\u0441\u043E\u0442\u043E\u0439 25 \u043B\u043E\u043A\u0442\u0435\u0439.
    \u0412\u043E\u0440\u043E\u0442\u0430 \u2014 \u0436\u0435\u043B\u0435\u0437\u043E
    \u0438 \u0434\u0443\u0431, \u0443\u0441\u0438\u043B\u0435\u043D\u044B \u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u043C
    \u0441\u043F\u043B\u0430\u0432\u043E\u043C. \u041D\u0430\u0434 \u043D\u0438\u043C\u0438
    \u2014 \u0431\u043E\u0439\u043D\u0438\u0446\u044B, \u0444\u0430\u043A\u0435\u043B\u044B,
    \u043A\u0430\u0442\u0430\u043F\u0443\u043B\u044C\u0442\u044B. \u041D\u043E \u0441\u0435\u0439\u0447\u0430\u0441
    \u0432\u043E\u0440\u043E\u0442\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u044B.
    \u0418 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u2014 \u043D\u0438\u043A\u043E\u0433\u043E.
    \u041D\u0438 \u043F\u0430\u0442\u0440\u0443\u043B\u044F. \u041D\u0438 \u0437\u043D\u0430\u043C\u0451\u043D.
    \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0442\u0435\u0440, \u043D\u0435\u0441\u0443\u0449\u0438\u0439
    \u043F\u0435\u043F\u0435\u043B \u0438 \u0437\u0430\u043F\u0430\u0445 \u0433\u0430\u0440\u0438.
    \u041F\u043E \u0443\u0441\u0442\u0430\u0432\u0443, \u0434\u043E\u0440\u043E\u0433\u0430
    \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u043C\u0430.
    \u041D\u043E \u0443\u0441\u0442\u0430\u0432 \u0434\u0430\u0432\u043D\u043E \u043C\u0451\u0440\u0442\u0432.\n\n\u042F
    \u0432\u0438\u0436\u0443 \u0438\u0445 \u0443 \u0432\u043E\u0440\u043E\u0442.\n\n\u0422\u0440\u043E\u0435.\n\n\u041F\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
    \u2014 \u043E\u043D. \u0412\u044B\u0441\u043E\u043A\u0438\u0439, \u0432 \u0447\u0451\u0440\u043D\u043E\u043C
    \u043F\u043B\u0430\u0449\u0435 \u0431\u0435\u0437 \u0437\u043D\u0430\u043A\u043E\u0432,
    \u043D\u043E \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0439
    \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u044C\u044E \u0447\u0435\u0440\u0435\u0437
    \u0433\u0440\u0443\u0434\u044C. \u0422\u0430\u043A \u043D\u043E\u0441\u044F\u0442
    \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435, \u043A\u043E\u0433\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u043B
    \u0421\u043E\u0432\u0435\u0442 \u0421\u0435\u043C\u0438 \u041A\u043B\u0438\u043D\u043A\u043E\u0432.
    \u041C\u0430\u0441\u0442\u0435\u0440\u0430. \u0423\u0431\u0438\u0439\u0446\u044B
    \u043A\u043E\u0440\u043E\u043B\u0435\u0439. \u0421\u0443\u0434\u044C\u0438 \u0431\u0435\u0437
    \u0441\u0443\u0434\u0430.\n\n\u0415\u0433\u043E \u043C\u0435\u0447 \u2014 \u043D\u0435
    \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u0430\u043B\u044C. \u042D\u0442\u043E
    \xAB\u0421\u0432\u0435\u0442 \u0412\u0435\u0447\u043D\u043E\u0441\u0442\u0438\xBB
    \u2014 \u043A\u043B\u0438\u043D\u043E\u043A \u0438\u0437 \u0431\u0435\u043B\u043E\u0433\u043E
    \u0441\u043F\u043B\u0430\u0432\u0430, \u0447\u0442\u043E \u043D\u0435 \u0442\u0443\u0441\u043A\u043D\u0435\u0435\u0442
    \u0434\u0430\u0436\u0435 \u0432 \u043F\u0435\u043F\u043B\u0435. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
    \u043E\u043D \u0440\u0430\u0437\u0440\u0435\u0437\u0430\u0435\u0442 \u0434\u043E\u0441\u043F\u0435\u0445,
    \u043A\u0430\u043A \u0442\u043A\u0430\u043D\u044C.\n\n\u0421\u043B\u0435\u0432\u0430
    \u0438 \u0441\u043F\u0440\u0430\u0432\u0430 \u043E\u0442 \u043D\u0435\u0433\u043E
    \u2014 \u0432\u043E\u0438\u043D\u044B \u0432 \u043B\u0451\u0433\u043A\u0438\u0445
    \u043A\u0438\u0440\u0430\u0441\u0430\u0445. \u041C\u043E\u043B\u043E\u0434\u044B\u0435.
    \u041D\u0430\u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435.
    \u041D\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438, \u043D\u0435
    \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u044B \u2014 \u0441\u043E\u043B\u0434\u0430\u0442\u044B.
    \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0438\u0437 \u044D\u043B\u0438\u0442\u044B.\n\n\u041E\u043D\u0438
    \u043D\u0435 \u043D\u0430\u043F\u0430\u0434\u0430\u044E\u0442.\n\u041E\u043D\u0438
    \u0436\u0434\u0443\u0442, \u043F\u043E\u043A\u0430 \u044F \u043F\u043E\u0434\u043E\u0439\u0434\u0443.\n\n\u041F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0437\u043D\u0430\u044E\u0442: \u044F \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0441\u044C.\n\u041F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u044F \u0434\u043E\u0448\u0451\u043B.\n\n\u041C\u043E\u0438
    \u0440\u0443\u043A\u0438 \u0434\u0440\u043E\u0436\u0430\u0442. \u0416\u0430\u0440
    \u043D\u0435 \u043F\u0440\u043E\u0448\u0451\u043B. \u0420\u0430\u043D\u0430 \u043D\u0430
    \u0431\u043E\u043A\u0443 \u0433\u043D\u043E\u0438\u0442\u0441\u044F. \u041D\u043E
    \u043C\u0435\u0447\u0438 \u2014 \u043E\u0431\u0430 \u043F\u0440\u0438 \u043C\u043D\u0435.
    \u0422\u043E\u0442, \u0447\u0442\u043E \u0432\u0437\u044F\u043B \u0443 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0430,
    \u0438 \u0442\u043E\u0442, \u0447\u0442\u043E \u0432\u044B\u0440\u0432\u0430\u043B
    \u0438\u0437 \u0440\u0443\u043A \u0443\u0431\u0438\u0439\u0446\u044B.\n\n\u042F
    \u043D\u0435 \u0433\u0435\u0440\u043E\u0439.\n\u042F \u043F\u0440\u043E\u0441\u0442\u043E
    \u0441\u043E\u043B\u0434\u0430\u0442, \u0443 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043E\u0434\u0438\u043D \u0434\u043E\u043B\u0433."
