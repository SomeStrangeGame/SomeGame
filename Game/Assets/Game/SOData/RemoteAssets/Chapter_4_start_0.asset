    _assetName: Chapter_4
  _buttonText: "<b>\u0412 \u0431\u043E\u0439...</b>"
  _descriptionText: "<b>\u0413\u043B\u0430\u0432\u0430 IV: \u0422\u0435\u043D\u044C
    \u0432 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0435</b>\n11-\u0435
    \u0447\u0438\u0441\u043B\u043E, \u043C\u0435\u0441\u044F\u0446 \u0425\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
    \u0416\u0430\u043B\u0430, \u0433\u043E\u0434 \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0417\u0430\u0442\u043C\u0435\u043D\u0438\u044F\n\n<b>\u041B\u043E\u043A\u0430\u0446\u0438\u044F:
    \u0411\u043E\u043B\u043E\u0442\u043E \u0427\u0451\u0440\u043D\u043E\u0433\u043E
    \u041E\u043A\u0430</b>\n\u0418\u0437 \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u043E\u0433\u043E
    \u043E\u0442\u0447\u0451\u0442\u0430 \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E
    \u0432\u0440\u0430\u0447\u0430 \u041C\u0430\u043B\u0435\u043D\u0430\n\u041D\u0438\u0437\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u044C,
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0432\u0448\u0430\u044F\u0441\u044F
    \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u044F
    \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E \u043A\u0430\u0440\u044C\u0435\u0440\u0430.
    \u0412\u043E\u0434\u0430 \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u043F\u0440\u0438\u0433\u043E\u0434\u043D\u0430
    \u0434\u043B\u044F \u043F\u0438\u0442\u044C\u044F: \u0447\u0451\u0440\u043D\u0430\u044F,
    \u0433\u0443\u0441\u0442\u0430\u044F, \u0441 \u043F\u0440\u0438\u043C\u0435\u0441\u044C\u044E
    \u0441\u0435\u0440\u043E\u0432\u043E\u0434\u043E\u0440\u043E\u0434\u0430 \u0438
    \u0433\u043D\u0438\u044E\u0449\u0438\u0445 \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u043B\u0435\u0439.
    \u0412\u043E\u0437\u0434\u0443\u0445 \u0442\u044F\u0436\u0451\u043B\u044B\u0439,
    \u043D\u0430\u0441\u044B\u0449\u0435\u043D \u0441\u043F\u043E\u0440\u0430\u043C\u0438
    \u0438 \u0438\u0441\u043F\u0430\u0440\u0435\u043D\u0438\u044F\u043C\u0438. \u0414\u043D\u0451\u043C
    \u2014 \u0433\u0443\u0441\u0442\u043E\u0439 \u0442\u0443\u043C\u0430\u043D, \u043D\u043E\u0447\u044C\u044E
    \u2014 \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435 \u0431\u043E\u043B\u043E\u0442\u043D\u044B\u0445
    \u0433\u0430\u0437\u043E\u0432. \u0422\u0432\u0451\u0440\u0434\u044B\u0445 \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u0432
    \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0442: \u043B\u0438\u0448\u044C \u0440\u0435\u0434\u043A\u0438\u0435
    \xAB\u043E\u0441\u0442\u0440\u043E\u0432\u043A\u0438\xBB \u0438\u0437 \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0451\u043D\u043D\u044B\u0445
    \u043A\u043E\u0440\u043D\u0435\u0439 \u0438 \u0433\u043D\u0438\u043B\u043E\u0439
    \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u044B. \u041F\u0440\u043E\u0445\u043E\u0434
    \u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E \u0443\u0437\u043A\u043E\u0439 \u0433\u0440\u044F\u0434\u0435, \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439
    \u043A\u0430\u043A \xAB\u0413\u0440\u0435\u0431\u0435\u043D\u044C \u041C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u043E\u0433\u043E\xBB.
    \u041C\u0435\u0441\u0442\u043E \u0438\u0437\u0431\u0435\u0433\u0430\u044E\u0442
    \u0434\u0430\u0436\u0435 \u0431\u0430\u043D\u0434\u0438\u0442\u044B. \u041F\u0440\u0438\u0447\u0438\u043D\u0430:
    \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0442\u0440\u0438
    \u0433\u043E\u0434\u0430 \u0437\u0434\u0435\u0441\u044C \u0438\u0441\u0447\u0435\u0437\u043B\u0438
    14 \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u041D\u0438 \u0442\u0435\u043B,
    \u043D\u0438 \u0441\u043B\u0435\u0434\u043E\u0432. \u0422\u043E\u043B\u044C\u043A\u043E
    \u0431\u043E\u043B\u043E\u0442\u043E.\n\n\u042F \u043F\u044C\u044E, \u043F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u0431\u043E\u043B\u044C\u0448\u0435.\n\u0412\u043E\u0434\u0430
    \u2014 \u0447\u0451\u0440\u043D\u0430\u044F, \u043A\u0430\u043A \u0441\u043C\u043E\u043B\u044C,
    \u043D\u043E \u0433\u043E\u0440\u043B\u043E \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u043B\u043E
    \u0434\u043E \u043A\u0440\u043E\u0432\u0438. \u0412\u0441\u0451 \u0442\u0435\u043B\u043E
    \u0434\u0440\u043E\u0436\u0438\u0442. \u0416\u0430\u0440 \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
    \u0435\u0449\u0451 \u0443\u0442\u0440\u043E\u043C, \u043F\u043E\u0441\u043B\u0435
    \u0442\u043E\u0433\u043E \u043A\u0430\u043A \u044F \u043D\u0430\u043F\u0438\u043B\u0441\u044F
    \u0438\u0437 \u043B\u0443\u0436\u0438 \u0443 \u043A\u0440\u0430\u044F \u0431\u043E\u043B\u043E\u0442\u0430.
    \u0414\u0443\u043C\u0430\u043B \u2014 \u0434\u043E\u0436\u0434\u0435\u0432\u0430\u044F.
    \u041E\u0448\u0438\u0431\u0441\u044F.\n\n\u0413\u043E\u043B\u043E\u0432\u0430
    \u043A\u0440\u0443\u0436\u0438\u0442\u0441\u044F. \u0412 \u0433\u043B\u0430\u0437\u0430\u0445
    \u2014 \u0447\u0451\u0440\u043D\u044B\u0435 \u043F\u044F\u0442\u043D\u0430. \u0416\u0438\u0432\u043E\u0442
    \u0441\u0432\u043E\u0434\u0438\u0442 \u0441\u043F\u0430\u0437\u043C\u0430\u043C\u0438.
    \u042F \u0435\u043B\u0435 \u0441\u0442\u043E\u044E.\n\n\u041D\u043E \u044F \u0432\u0438\u0436\u0443
    \u0435\u0433\u043E.\n\n\u0422\u0435\u043D\u044C \u043D\u0430 \u0433\u0440\u0435\u0431\u043D\u0435.
    \u0412\u044B\u0441\u043E\u043A\u0430\u044F. \u041D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u0430\u044F.
    \u0414\u0430\u0436\u0435 \u0432 \u044D\u0442\u043E\u043C \u0442\u0443\u043C\u0430\u043D\u0435
    \u2014 \u0447\u0451\u0442\u043A\u0430\u044F, \u043A\u0430\u043A \u043B\u0435\u0437\u0432\u0438\u0435.\n\n\u041E\u043D
    \u043D\u0435 \u043F\u0440\u044F\u0447\u0435\u0442\u0441\u044F.\n\u041E\u043D
    \u0436\u0434\u0430\u043B.\n\n\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u043C\u0435\u0447
    \u0443 \u0431\u0435\u0434\u0440\u0430 \u2014 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u043E\u0440\u0443\u0436\u0438\u0435, \u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435
    \u0435\u0433\u043E \u0442\u0435\u043B\u0430. \u041D\u0430 \u043F\u043B\u0435\u0447\u0430\u0445
    \u2014 \u043F\u043B\u0430\u0449 \u0431\u0435\u0437 \u0437\u043D\u0430\u043A\u043E\u0432.
    \u0411\u0435\u0437 \u0438\u043C\u0435\u043D\u0438. \u0411\u0435\u0437 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E.\n\n\u041D\u0430\u0435\u043C\u043D\u0438\u043A.\n\u0423\u0431\u0438\u0439\u0446\u0430.\n\u041C\u0430\u0441\u0442\u0435\u0440.\n\n\u0410
    \u044F \u2014 \u0431\u043E\u043B\u044C\u043D\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u0441 \u0447\u0443\u0436\u0438\u043C \u043C\u0435\u0447\u043E\u043C \u0438 \u043F\u0435\u043F\u043B\u043E\u043C
    \u0432 \u0436\u0438\u043B\u0430\u0445.\n\n\u041D\u043E \u0443 \u043C\u0435\u043D\u044F
    \u043D\u0435\u0442 \u043F\u0443\u0442\u0438 \u043D\u0430\u0437\u0430\u0434.\n\u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
    \u2014 \u0437\u0430 \u0431\u043E\u043B\u043E\u0442\u043E\u043C.\n\u0418 \u044F
    \u0438\u0434\u0443."
