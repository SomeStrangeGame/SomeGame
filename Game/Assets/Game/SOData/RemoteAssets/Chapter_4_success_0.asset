    _assetName: Chapter_4
  _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
  _descriptionText: "\u041E\u043D \u043C\u0451\u0440\u0442\u0432.\n\n\u041B\u0435\u0436\u0438\u0442
    \u043D\u0430 \u043A\u0440\u0430\u044E \u0433\u0440\u0435\u0431\u043D\u044F, \u043E\u0434\u043D\u0430
    \u0440\u0443\u043A\u0430 \u0432 \u0442\u0440\u044F\u0441\u0438\u043D\u0435, \u0434\u0440\u0443\u0433\u0430\u044F
    \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u0436\u0438\u043C\u0430\u0435\u0442
    \u0440\u0443\u043A\u043E\u044F\u0442\u044C \u0434\u043B\u0438\u043D\u043D\u043E\u0433\u043E
    \u043C\u0435\u0447\u0430 \u2014 \u0442\u043E\u043D\u043A\u043E\u0433\u043E, \u043A\u0430\u043A
    \u0438\u0433\u043B\u0430, \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0439
    \u0438\u043D\u043A\u0440\u0443\u0441\u0442\u0430\u0446\u0438\u0435\u0439 \u0432\u0434\u043E\u043B\u044C
    \u044D\u0444\u0435\u0441\u0430. \u041D\u0430 \u043B\u0435\u0437\u0432\u0438\u0438
    \u2014 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u0437\u0430\u0437\u0443\u0431\u0440\u0438\u043D\u044B.
    \u0422\u043E\u043B\u044C\u043A\u043E \u043F\u044F\u0442\u043D\u043E \u043A\u0440\u043E\u0432\u0438
    \u2014 \u043C\u043E\u0435\u0439.\n\n\u042F \u043D\u0435 \u043F\u043E\u043C\u043D\u044E,
    \u043A\u0430\u043A \u044D\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.\n\n\u041F\u043E\u043C\u043D\u044E
    \u0442\u043E\u043B\u044C\u043A\u043E: \u0436\u0430\u0440. \u0411\u043E\u043B\u044C.
    \u0422\u0443\u043C\u0430\u043D. \u0418 \u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430
    \u2014 \u0431\u0435\u0437 \u0437\u043B\u043E\u0431\u044B, \u0431\u0435\u0437
    \u0441\u0442\u0440\u0430\u0445\u0430. \u0422\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0431\u043E\u0442\u0430.\n\n\u041E\u043D
    \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F \u043F\u0435\u0440\u0432\u044B\u043C.\n\u042F
    \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C, \u043A\u0442\u043E
    \u0441 \u043D\u0438\u043C \u0434\u0440\u0430\u043B\u0441\u044F, \u2014 \u043F\u0440\u043E\u0441\u0442\u043E
    \u043D\u0435 \u0443\u043F\u0430\u043B \u0432\u043E\u0432\u0440\u0435\u043C\u044F.\n\n\u041C\u043E\u0439
    \u043C\u0435\u0447 \u2014 \u0432 \u043D\u043E\u0436\u043D\u0430\u0445. \u0414\u0440\u043E\u0436\u044C
    \u0432 \u0440\u0443\u043A\u0430\u0445 \u043D\u0435 \u043F\u0440\u043E\u0448\u043B\u0430,
    \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E \u0443\u0436\u0435
    \u043D\u0435 \u0432\u0430\u0436\u043D\u043E.\n\n\u0412 \u0435\u0433\u043E \u043F\u043E\u044F\u0441\u043D\u043E\u0439
    \u0441\u0443\u043C\u043A\u0435 \u2014 \u043C\u0435\u0448\u043E\u0447\u0435\u043A
    \u0441 \u044F\u0434\u043E\u043C, \u0441\u0432\u0438\u0442\u043E\u043A \u0441
    \u043C\u043E\u0438\u043C \u0438\u043C\u0435\u043D\u0435\u043C\u2026 \u0438 \u043A\u043B\u044E\u0447.
    \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439, \u043C\u0435\u0434\u043D\u044B\u0439,
    \u0441 \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u043E\u0439 \xAB\u0421\u043A\u0432\u0435\u0440\u043D\u0445\u0435\u0439\u0432\u0435\u043D
    \u2014 \u0412\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0435 \u0412\u043E\u0440\u043E\u0442\u0430\xBB.\n\n\u041E\u043D\u0438
    \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0436\u0434\u0430\u043B\u0438
    \u043C\u0435\u043D\u044F.\n\u041E\u043D\u0438 \u0445\u043E\u0442\u0435\u043B\u0438,
    \u0447\u0442\u043E\u0431\u044B \u044F \u0434\u043E\u0448\u0451\u043B.\n\n\u041D\u043E
    \u043D\u0435 \u0436\u0438\u0432\u044B\u043C.\n\n\u042F \u0432\u044B\u0442\u0438\u0440\u0430\u044E
    \u0433\u0443\u0431\u044B \u2014 \u043A\u0440\u043E\u0432\u044C, \u043F\u043E\u0442,
    \u0436\u0451\u043B\u0447\u044C.\n\u041F\u043E\u0434\u043D\u0438\u043C\u0430\u044E
    \u0435\u0433\u043E \u043C\u0435\u0447.\n\u041A\u043E\u0440\u043E\u0447\u0435
    \u043C\u043E\u0435\u0433\u043E. \u041B\u0435\u0433\u0447\u0435. \u0418\u0434\u0435\u0430\u043B\u0435\u043D
    \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u0431\u043E\u044F.\n\n\u0422\u0435\u043F\u0435\u0440\u044C
    \u0443 \u043C\u0435\u043D\u044F \u0434\u0432\u0430 \u043A\u043B\u0438\u043D\u043A\u0430.\n\u0418
    \u043E\u0434\u0438\u043D \u0448\u0430\u043D\u0441."
