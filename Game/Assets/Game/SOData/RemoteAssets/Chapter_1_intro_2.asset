  _backgroundBundle:
    _bundleName: chapter_onlyscreen_chapter_0
    _assetName: Chapter_1_Intro
  _content:
    _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
    _descriptionText: "\u041D\u043E \u044F \u0438\u0434\u0443.\n\n\u041F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u044F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0441\u044C
      \u2014 \u043F\u0440\u0430\u0432\u0434\u0430 \u0441\u0433\u043E\u0440\u0438\u0442
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0430\u043C\u0438.\n\u041F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u044F \u0443\u043F\u0430\u0434\u0443
      \u2014 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043A\u0430\u0436\u0435\u0442,
      \u043A\u0442\u043E \u043F\u0440\u0438\u0448\u0451\u043B \u0437\u0430 \u043D\u0430\u043C\u0438
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435.\n\n\u042F \u043D\u0435 \u0441\u0440\u0430\u0436\u0430\u044E\u0441\u044C
      \u0437\u0430 \u0441\u043B\u0430\u0432\u0443.\n\u042F \u043D\u0435 \u0441\u0440\u0430\u0436\u0430\u044E\u0441\u044C
      \u0437\u0430 \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435.\n\n\u042F
      \u0438\u0434\u0443, \u0447\u0442\u043E\u0431\u044B \u043A\u0442\u043E-\u0442\u043E
      \u0437\u043D\u0430\u043B \u2014 \u043C\u044B \u043D\u0435 \u0441\u0434\u0430\u043B\u0438\u0441\u044C.\n\u041C\u044B
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0430\u043B\u0438 \u2014 \u043E\u0434\u0438\u043D
      \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C,\n\u043F\u043E\u043A\u0430
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439.\n\n\u0418
      \u0432\u043E\u0442 \u043E\u043D \u2014 \u044F.\n\n\u0421 \u043C\u0435\u0447\u043E\u043C
      \u0432 \u0440\u0443\u043A\u0435.\n\u0421 \u043F\u0435\u043F\u043B\u043E\u043C
      \u0432 \u0433\u043E\u0440\u043B\u0435.\n\u0421 \u0434\u043E\u043B\u0433\u043E\u043C
      \u0432 \u0441\u0435\u0440\u0434\u0446\u0435.\n\n\u0418 \u044F \u0438\u0434\u0443."
  _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
  _descriptionText: "\u041D\u043E \u044F \u0438\u0434\u0443.\n\n\u041F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u044F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0441\u044C
    \u2014 \u043F\u0440\u0430\u0432\u0434\u0430 \u0441\u0433\u043E\u0440\u0438\u0442
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0430\u043C\u0438.\n\u041F\u043E\u0442\u043E\u043C\u0443
    \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u044F \u0443\u043F\u0430\u0434\u0443
    \u2014 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043A\u0430\u0436\u0435\u0442,
    \u043A\u0442\u043E \u043F\u0440\u0438\u0448\u0451\u043B \u0437\u0430 \u043D\u0430\u043C\u0438
    \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435.\n\n\u042F \u043D\u0435 \u0441\u0440\u0430\u0436\u0430\u044E\u0441\u044C
    \u0437\u0430 \u0441\u043B\u0430\u0432\u0443.\n\u042F \u043D\u0435 \u0441\u0440\u0430\u0436\u0430\u044E\u0441\u044C
    \u0437\u0430 \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435.\n\n\u042F
    \u0438\u0434\u0443, \u0447\u0442\u043E\u0431\u044B \u043A\u0442\u043E-\u0442\u043E
    \u0437\u043D\u0430\u043B \u2014 \u043C\u044B \u043D\u0435 \u0441\u0434\u0430\u043B\u0438\u0441\u044C.\n\u041C\u044B
    \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0430\u043B\u0438 \u2014 \u043E\u0434\u0438\u043D
    \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C,\n\u043F\u043E\u043A\u0430
    \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439.\n\n\u0418
    \u0432\u043E\u0442 \u043E\u043D \u2014 \u044F.\n\n\u0421 \u043C\u0435\u0447\u043E\u043C
    \u0432 \u0440\u0443\u043A\u0435.\n\u0421 \u043F\u0435\u043F\u043B\u043E\u043C
    \u0432 \u0433\u043E\u0440\u043B\u0435.\n\u0421 \u0434\u043E\u043B\u0433\u043E\u043C
    \u0432 \u0441\u0435\u0440\u0434\u0446\u0435.\n\n\u0418 \u044F \u0438\u0434\u0443."
