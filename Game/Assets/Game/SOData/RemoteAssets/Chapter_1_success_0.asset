    _bundleName: chapter_onlyscreen_chapter_1
    _assetName: Chapter_1
  _content:
    _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
    _descriptionText: "\u041E\u043D \u043C\u0451\u0440\u0442\u0432.\n\n\u041B\u0435\u0436\u0438\u0442
      \u0443 \u043A\u0440\u043E\u043C\u043A\u0438 \u0432\u043E\u0434\u044B, \u043B\u0438\u0446\u043E\u043C
      \u0432\u043D\u0438\u0437, \u0440\u0443\u043A\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451
      \u0441\u0436\u0438\u043C\u0430\u0435\u0442 \u0440\u0443\u043A\u043E\u044F\u0442\u044C
      \u0441\u0432\u043E\u0435\u0433\u043E \u0441\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043C\u0435\u0447\u0430. \u041D\u0430 \u043D\u0451\u043C \u043A\u0438\u0440\u0430\u0441\u0430
      \u0438\u0437 \u043F\u0435\u0440\u0435\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0445
      \u043C\u0435\u0434\u043D\u044B\u0445 \u043F\u043B\u0430\u0441\u0442\u0438\u043D
      \u2014 \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043C\u044F\u0442\u0430
      \u0438 \u043F\u044F\u0442\u043D\u0430\u043C\u0438 \u043A\u0440\u043E\u0432\u0438.
      \u0418\u0437-\u043F\u043E\u0434 \u043F\u043B\u0430\u0449\u0430 \u0442\u043E\u0440\u0447\u0438\u0442
      \u043F\u043E\u044F\u0441 \u0441 \u0442\u0440\u043E\u0444\u0435\u044F\u043C\u0438:
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0435 \u0431\u0440\u0430\u0441\u043B\u0435\u0442\u044B,
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u0430\u044F \u0431\u0443\u043B\u0430\u0432\u043A\u0430,
      \u043E\u0431\u0440\u044B\u0432\u043E\u043A \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u0439
      \u043B\u0435\u043D\u0442\u044B \u2014 \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
      \u0441 \u0447\u044C\u0435\u0439-\u0442\u043E \u0448\u0435\u0438.\n\n\u042F
      \u043E\u0431\u044B\u0441\u043A\u0430\u043B \u0435\u0433\u043E. \u0412 \u0441\u0443\u043C\u043A\u0435
      \u2014 \u0441\u0443\u0445\u043E\u0435 \u043C\u044F\u0441\u043E, \u0444\u043B\u044F\u0433\u0430
      \u0441 \u043A\u0438\u0441\u043B\u044B\u043C \u044D\u043B\u0435\u043C, \u0438
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430
      \u0441 \u043F\u043E\u043C\u0435\u0442\u043A\u0430\u043C\u0438 \u043D\u0430
      \u043F\u043E\u043B\u044F\u0445: \xAB\u0441\u043E\u043B\u0434\u0430\u0442, \u043E\u0434\u0438\u043D,
      \u0431\u0435\u0437 \u043A\u043E\u043D\u044F, \u0438\u0434\u0451\u0442 \u043D\u0430
      \u0441\u0435\u0432\u0435\u0440\xBB. \u041A\u0442\u043E-\u0442\u043E \u043F\u043B\u0430\u0442\u0438\u043B
      \u0437\u0430 \u044D\u0442\u0443 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E.
      \u041A\u0442\u043E-\u0442\u043E \u0437\u043D\u0430\u043B, \u0447\u0442\u043E
      \u044F \u043F\u0440\u0438\u0434\u0443 \u0441\u044E\u0434\u0430.\n\n\u041C\u043E\u0439
      \u043C\u0435\u0447 \u0447\u0438\u0441\u0442. \u0420\u0443\u043A\u0438 \u2014
      \u043D\u0435\u0442.\n\u041D\u043E \u044F \u0436\u0438\u0432.\n\u0418 \u0441\u0432\u0438\u0442\u043E\u043A
      \u2014 \u0443 \u043C\u0435\u043D\u044F.\n\n\u041F\u043E\u0440\u0430 \u0438\u0434\u0442\u0438.
      \u0422\u0443\u043C\u0430\u043D \u0440\u0435\u0434\u0435\u0435\u0442. \u0410
      \u0432\u0440\u0430\u0433\u0438 \u2014 \u043D\u0435 \u0434\u0440\u0435\u043C\u043B\u044E\u0442."
  _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
  _descriptionText: "\u041E\u043D \u043C\u0451\u0440\u0442\u0432.\n\n\u041B\u0435\u0436\u0438\u0442
    \u0443 \u043A\u0440\u043E\u043C\u043A\u0438 \u0432\u043E\u0434\u044B, \u043B\u0438\u0446\u043E\u043C
    \u0432\u043D\u0438\u0437, \u0440\u0443\u043A\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451
    \u0441\u0436\u0438\u043C\u0430\u0435\u0442 \u0440\u0443\u043A\u043E\u044F\u0442\u044C
    \u0441\u0432\u043E\u0435\u0433\u043E \u0441\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043C\u0435\u0447\u0430. \u041D\u0430 \u043D\u0451\u043C \u043A\u0438\u0440\u0430\u0441\u0430
    \u0438\u0437 \u043F\u0435\u0440\u0435\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u043C\u0435\u0434\u043D\u044B\u0445 \u043F\u043B\u0430\u0441\u0442\u0438\u043D
    \u2014 \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043C\u044F\u0442\u0430
    \u0438 \u043F\u044F\u0442\u043D\u0430\u043C\u0438 \u043A\u0440\u043E\u0432\u0438.
    \u0418\u0437-\u043F\u043E\u0434 \u043F\u043B\u0430\u0449\u0430 \u0442\u043E\u0440\u0447\u0438\u0442
    \u043F\u043E\u044F\u0441 \u0441 \u0442\u0440\u043E\u0444\u0435\u044F\u043C\u0438:
    \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0435 \u0431\u0440\u0430\u0441\u043B\u0435\u0442\u044B,
    \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u0430\u044F \u0431\u0443\u043B\u0430\u0432\u043A\u0430,
    \u043E\u0431\u0440\u044B\u0432\u043E\u043A \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u0439
    \u043B\u0435\u043D\u0442\u044B \u2014 \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
    \u0441 \u0447\u044C\u0435\u0439-\u0442\u043E \u0448\u0435\u0438.\n\n\u042F \u043E\u0431\u044B\u0441\u043A\u0430\u043B
    \u0435\u0433\u043E. \u0412 \u0441\u0443\u043C\u043A\u0435 \u2014 \u0441\u0443\u0445\u043E\u0435
    \u043C\u044F\u0441\u043E, \u0444\u043B\u044F\u0433\u0430 \u0441 \u043A\u0438\u0441\u043B\u044B\u043C
    \u044D\u043B\u0435\u043C, \u0438 \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430
    \u0441 \u043F\u043E\u043C\u0435\u0442\u043A\u0430\u043C\u0438 \u043D\u0430 \u043F\u043E\u043B\u044F\u0445:
    \xAB\u0441\u043E\u043B\u0434\u0430\u0442, \u043E\u0434\u0438\u043D, \u0431\u0435\u0437
    \u043A\u043E\u043D\u044F, \u0438\u0434\u0451\u0442 \u043D\u0430 \u0441\u0435\u0432\u0435\u0440\xBB.
    \u041A\u0442\u043E-\u0442\u043E \u043F\u043B\u0430\u0442\u0438\u043B \u0437\u0430
    \u044D\u0442\u0443 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E.
    \u041A\u0442\u043E-\u0442\u043E \u0437\u043D\u0430\u043B, \u0447\u0442\u043E
    \u044F \u043F\u0440\u0438\u0434\u0443 \u0441\u044E\u0434\u0430.\n\n\u041C\u043E\u0439
    \u043C\u0435\u0447 \u0447\u0438\u0441\u0442. \u0420\u0443\u043A\u0438 \u2014
    \u043D\u0435\u0442.\n\u041D\u043E \u044F \u0436\u0438\u0432.\n\u0418 \u0441\u0432\u0438\u0442\u043E\u043A
    \u2014 \u0443 \u043C\u0435\u043D\u044F.\n\n\u041F\u043E\u0440\u0430 \u0438\u0434\u0442\u0438.
    \u0422\u0443\u043C\u0430\u043D \u0440\u0435\u0434\u0435\u0435\u0442. \u0410 \u0432\u0440\u0430\u0433\u0438
    \u2014 \u043D\u0435 \u0434\u0440\u0435\u043C\u043B\u044E\u0442."
