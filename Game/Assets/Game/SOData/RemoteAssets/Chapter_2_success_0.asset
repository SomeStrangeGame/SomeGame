    _bundleName: chapter_onlyscreen_chapter_2
    _assetName: Chapter_2
  _content:
    _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
    _descriptionText: "\u041E\u043D \u043C\u0451\u0440\u0442\u0432.\n\n\u041B\u0435\u0436\u0438\u0442
      \u0443 \u041A\u0430\u043C\u043D\u044F \u041F\u0440\u0438\u0441\u044F\u0433\u0438,
      \u043B\u0438\u0446\u043E\u043C \u0432\u043D\u0438\u0437, \u0440\u0443\u043A\u0430
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u0436\u0438\u043C\u0430\u0435\u0442
      \u0440\u0443\u043A\u043E\u044F\u0442\u044C \u043C\u0435\u0447\u0430 \u2014
      \u0434\u043B\u0438\u043D\u043D\u043E\u0433\u043E, \u0441 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0439
      \u0433\u0430\u0440\u0434\u043E\u0439 \u0438 \u044D\u0444\u0435\u0441\u043E\u043C
      \u0432 \u0444\u043E\u0440\u043C\u0435 \u043E\u0440\u043B\u0438\u043D\u043E\u0433\u043E
      \u043A\u0440\u044B\u043B\u0430. \u0422\u0430\u043A\u0438\u0435 \u0432\u044B\u0434\u0430\u044E\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0444\u0438\u0446\u0435\u0440\u0430\u043C
      \u043B\u0438\u0447\u043D\u043E\u0439 \u0433\u0432\u0430\u0440\u0434\u0438\u0438.
      \u041D\u0430 \u043B\u0435\u0437\u0432\u0438\u0438 \u2014 \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0430:
      \xAB\u0412\u0435\u0440\u043D\u043E\u0441\u0442\u044C \u2014 \u043D\u0435 \u043A\u043B\u044F\u0442\u0432\u0430,
      \u0430 \u0434\u043E\u043B\u0433\xBB.\n\n\u0418\u0440\u043E\u043D\u0438\u044F.\n\n\u041D\u0430
      \u0435\u0433\u043E \u043A\u0443\u0440\u0442\u043A\u0435 \u2014 \u0441\u043B\u0435\u0434\u044B
      \u043E\u0442 \u0432\u044B\u0440\u0432\u0430\u043D\u043D\u044B\u0445 \u0437\u043D\u0430\u043A\u043E\u0432.
      \u041E\u043D \u0441\u043D\u044F\u043B \u0432\u0441\u0451, \u0447\u0442\u043E
      \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u043B\u043E \u0435\u0433\u043E \u0441
      \u0430\u0440\u043C\u0438\u0435\u0439. \u041D\u043E \u043C\u0435\u0447 \u043E\u0441\u0442\u0430\u0432\u0438\u043B.
      \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0434\u043B\u044F
      \u043D\u0435\u0433\u043E \u043E\u043D \u0441\u0442\u0430\u043B \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u043F\u0440\u0430\u0432\u0434\u043E\u0439.\n\n\u0412 \u0435\u0433\u043E \u0432\u0435\u0449\u0430\u0445
      \u2014 \u043A\u0438\u0441\u0435\u0442 \u0441 \u0442\u0430\u0431\u0430\u043A\u043E\u043C,
      \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u0430\u044F \u043A\u043D\u0438\u0433\u0430
      \u043C\u043E\u043B\u0438\u0442\u0432 \u0438 \u043C\u0435\u0434\u0430\u043B\u044C\u043E\u043D
      \u0441 \u043E\u0431\u0443\u0433\u043B\u0435\u043D\u043D\u043E\u0439 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0435\u0439
      \u0436\u0435\u043D\u0449\u0438\u043D\u044B \u0438 \u0440\u0435\u0431\u0451\u043D\u043A\u0430.
      \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u043F\u0440\u0438\u043A\u0430\u0437\u043E\u0432.
      \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u0441\u043F\u0438\u0441\u043A\u043E\u0432.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u043E.\n\n\u042F
      \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u043B \u043C\u0435\u0434\u0430\u043B\u044C\u043E\u043D.\n\u041D\u043E
      \u043C\u0435\u0447 \u0432\u0437\u044F\u043B.\n\n\u041C\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439
      \u043A\u043B\u0438\u043D\u043E\u043A \u2014 \u0441\u043B\u043E\u043C\u0430\u043D
      \u0443 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F. \u0411\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043E\u0440\u0443\u0436\u0438\u0435. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0430\u043C\u044F\u0442\u044C.\n\n\u0422\u0435\u043F\u0435\u0440\u044C
      \u044F \u0438\u0434\u0443 \u0441 \u043C\u0435\u0447\u043E\u043C \u0432\u0440\u0430\u0433\u0430.\n\u041E\u043D
      \u0442\u044F\u0436\u0435\u043B\u0435\u0435. \u041E\u0441\u0442\u0440\u0435\u0435.
      \u0418 \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u0435\u0442 \u043E\u0448\u0438\u0431\u043E\u043A.\n\n\u041D\u043E
      \u044F \u2014 \u043D\u0435 \u0442\u043E\u0442, \u043A\u0442\u043E \u043E\u0448\u0438\u0431\u0430\u0435\u0442\u0441\u044F
      \u0434\u0432\u0430\u0436\u0434\u044B."
  _buttonText: "<b>\u0412 \u043F\u0443\u0442\u044C...</b>"
  _descriptionText: "\u041E\u043D \u043C\u0451\u0440\u0442\u0432.\n\n\u041B\u0435\u0436\u0438\u0442
    \u0443 \u041A\u0430\u043C\u043D\u044F \u041F\u0440\u0438\u0441\u044F\u0433\u0438,
    \u043B\u0438\u0446\u043E\u043C \u0432\u043D\u0438\u0437, \u0440\u0443\u043A\u0430
    \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u0436\u0438\u043C\u0430\u0435\u0442
    \u0440\u0443\u043A\u043E\u044F\u0442\u044C \u043C\u0435\u0447\u0430 \u2014 \u0434\u043B\u0438\u043D\u043D\u043E\u0433\u043E,
    \u0441 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0439 \u0433\u0430\u0440\u0434\u043E\u0439
    \u0438 \u044D\u0444\u0435\u0441\u043E\u043C \u0432 \u0444\u043E\u0440\u043C\u0435
    \u043E\u0440\u043B\u0438\u043D\u043E\u0433\u043E \u043A\u0440\u044B\u043B\u0430.
    \u0422\u0430\u043A\u0438\u0435 \u0432\u044B\u0434\u0430\u044E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u0444\u0438\u0446\u0435\u0440\u0430\u043C \u043B\u0438\u0447\u043D\u043E\u0439
    \u0433\u0432\u0430\u0440\u0434\u0438\u0438. \u041D\u0430 \u043B\u0435\u0437\u0432\u0438\u0438
    \u2014 \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0430: \xAB\u0412\u0435\u0440\u043D\u043E\u0441\u0442\u044C
    \u2014 \u043D\u0435 \u043A\u043B\u044F\u0442\u0432\u0430, \u0430 \u0434\u043E\u043B\u0433\xBB.\n\n\u0418\u0440\u043E\u043D\u0438\u044F.\n\n\u041D\u0430
    \u0435\u0433\u043E \u043A\u0443\u0440\u0442\u043A\u0435 \u2014 \u0441\u043B\u0435\u0434\u044B
    \u043E\u0442 \u0432\u044B\u0440\u0432\u0430\u043D\u043D\u044B\u0445 \u0437\u043D\u0430\u043A\u043E\u0432.
    \u041E\u043D \u0441\u043D\u044F\u043B \u0432\u0441\u0451, \u0447\u0442\u043E
    \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u043B\u043E \u0435\u0433\u043E \u0441
    \u0430\u0440\u043C\u0438\u0435\u0439. \u041D\u043E \u043C\u0435\u0447 \u043E\u0441\u0442\u0430\u0432\u0438\u043B.
    \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0434\u043B\u044F \u043D\u0435\u0433\u043E
    \u043E\u043D \u0441\u0442\u0430\u043B \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u043F\u0440\u0430\u0432\u0434\u043E\u0439.\n\n\u0412 \u0435\u0433\u043E \u0432\u0435\u0449\u0430\u0445
    \u2014 \u043A\u0438\u0441\u0435\u0442 \u0441 \u0442\u0430\u0431\u0430\u043A\u043E\u043C,
    \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u0430\u044F \u043A\u043D\u0438\u0433\u0430
    \u043C\u043E\u043B\u0438\u0442\u0432 \u0438 \u043C\u0435\u0434\u0430\u043B\u044C\u043E\u043D
    \u0441 \u043E\u0431\u0443\u0433\u043B\u0435\u043D\u043D\u043E\u0439 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0435\u0439
    \u0436\u0435\u043D\u0449\u0438\u043D\u044B \u0438 \u0440\u0435\u0431\u0451\u043D\u043A\u0430.
    \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u043F\u0440\u0438\u043A\u0430\u0437\u043E\u0432.
    \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u0441\u043F\u0438\u0441\u043A\u043E\u0432.
    \u0422\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u043E.\n\n\u042F
    \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u043B \u043C\u0435\u0434\u0430\u043B\u044C\u043E\u043D.\n\u041D\u043E
    \u043C\u0435\u0447 \u0432\u0437\u044F\u043B.\n\n\u041C\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439
    \u043A\u043B\u0438\u043D\u043E\u043A \u2014 \u0441\u043B\u043E\u043C\u0430\u043D
    \u0443 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F. \u0411\u043E\u043B\u044C\u0448\u0435
    \u043D\u0435 \u043E\u0440\u0443\u0436\u0438\u0435. \u041F\u0440\u043E\u0441\u0442\u043E
    \u043F\u0430\u043C\u044F\u0442\u044C.\n\n\u0422\u0435\u043F\u0435\u0440\u044C
    \u044F \u0438\u0434\u0443 \u0441 \u043C\u0435\u0447\u043E\u043C \u0432\u0440\u0430\u0433\u0430.\n\u041E\u043D
    \u0442\u044F\u0436\u0435\u043B\u0435\u0435. \u041E\u0441\u0442\u0440\u0435\u0435.
    \u0418 \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u0435\u0442 \u043E\u0448\u0438\u0431\u043E\u043A.\n\n\u041D\u043E
    \u044F \u2014 \u043D\u0435 \u0442\u043E\u0442, \u043A\u0442\u043E \u043E\u0448\u0438\u0431\u0430\u0435\u0442\u0441\u044F
    \u0434\u0432\u0430\u0436\u0434\u044B."
